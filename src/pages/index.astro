---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroLiquidMetal from '../components/HeroLiquidMetal.astro';
import VisualStoryProgress from '../components/VisualStoryProgress.astro';
import WhyMe from '../components/WhyMe.astro';
import ScenarioCheck from '../components/ScenarioCheck.astro';
import Cases from '../components/Cases.astro';
import Certificates from '../components/Certificates.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import CaseStudyDrawer from '../components/CaseStudyDrawer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Liangzhenjie | AI 落地顾问">
  <HeroLiquidMetal />
  <Header />
  <VisualStoryProgress />
  <main id="main-content" data-visual-story>
    <Hero />
    <div class="divider hero-transition-divider"></div>
    <WhyMe />
    <div class="divider"></div>
    <ScenarioCheck />
    <div class="divider"></div>
    <Cases />
    <div class="divider"></div>
    <Certificates />
    <div class="divider"></div>
    <Services />
    <div class="divider"></div>
    <Process />
    <div class="divider"></div>
    <FAQ />
    <div class="divider"></div>
    <Contact />
  </main>
  <CaseStudyDrawer />
  <ImageLightbox />
  <Footer />
</Layout>
