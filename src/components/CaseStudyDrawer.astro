---
import { Image, getImage } from 'astro:assets';
import workbench from '../assets/refresh/workbench-comparison.png';
import jutuPoster from '../assets/refresh/jutu-input-output.png';
import { selfBuiltProducts } from '../data/self-built-products';
import { caseArt, productArt } from '../data/case-art';
const workbenchFull = await getImage({ src: workbench, width: 1600, format: 'webp' });
const jutuFull = await getImage({ src: jutuPoster, width: 1600, format: 'webp' });
const caseFull = Object.fromEntries(await Promise.all(Object.entries(caseArt).map(async ([id, art]) => [id, await getImage({src: art.image, width:1600, format:'webp'})])));
const productFull = Object.fromEntries(await Promise.all(Object.entries(productArt).map(async ([id, art]) => [id, await getImage({src:art.image, width:1600, format:'webp'})])));
---
<div class="case-drawer" id="caseStudyDrawer" data-case-drawer aria-hidden="true">
  <button
    type="button"
    class="case-drawer-backdrop"
    data-case-drawer-close
    aria-label="关闭案例详情"
    tabindex="-1"
  ></button>

  <section
    class="case-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="caseDrawerTitle"
    tabindex="-1"
  >
    <button
      type="button"
      class="case-drawer-close"
      data-case-drawer-close
      aria-label="关闭案例详情"
      title="关闭"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <div class="case-drawer-content">
      <div class="case-drawer-meta">
        <span class="case-drawer-category" data-case-category></span>
        <span class="case-drawer-period" data-case-period></span>
      </div>

      <h2 id="caseDrawerTitle" data-case-title></h2>

      <div class="case-products" data-case-media="jutu" hidden>
        <div class="product-tabs" role="tablist" aria-label="选择小程序">
          {selfBuiltProducts.map((product, index) => (
            <button type="button" role="tab" id={'product-tab-' + product.id}
              aria-controls={'product-panel-' + product.id} aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1} data-product-tab={product.id}>{product.shortName}</button>
          ))}
        </div>
        {selfBuiltProducts.map((product, index) => (
          <section role="tabpanel" id={'product-panel-' + product.id} aria-labelledby={'product-tab-' + product.id}
            data-product-panel={product.id} hidden={index !== 0} tabindex="0">
            <figure class:list={['case-drawer-media', {'product-proof': product.id === 'jutu'}]}>
              <a class="image-preview" href={product.id === 'jutu' ? jutuFull.src : productFull[product.id].src}
                data-image-open data-image-caption={product.name} aria-label={'放大' + product.name + '展示图'} aria-haspopup="dialog" aria-controls="imageLightbox">
                <Image src={product.id === 'jutu' ? jutuPoster : productArt[product.id as keyof typeof productArt].image}
                  alt={product.id === 'jutu' ? '居图 AI 实际输入与出图对照' : productArt[product.id as keyof typeof productArt].alt}
                  width={1000} loading="lazy" />
              </a>
            </figure>
            <p class="product-description">{product.description}</p>
          </section>
        ))}
      </div>

      {Object.entries(caseArt).filter(([id]) => id !== 'jutu').map(([id, art]) => (
        <figure class="case-drawer-media" data-case-media={id} hidden>
          <a class="image-preview" href={caseFull[id].src} data-image-open data-image-caption={id === 'crm' ? '多平台客资 CRM · 公司内部项目' : id === 'workbench' ? '创作间' : id === 'youtube' ? 'AI 系列短视频' : id === 'growth' ? '运营数据整理提效' : '活动报表与网页录入'}
            aria-label={'放大' + (id === 'crm' ? 'CRM' : id === 'workbench' ? '创作间' : id === 'youtube' ? '短视频' : id === 'growth' ? '运营数据整理' : '自动化') + '展示图'} aria-haspopup="dialog" aria-controls="imageLightbox">
            <Image src={art.image} alt={art.alt} width={1000} loading="lazy" />
          </a>
        </figure>
      ))}
      <dl class="case-facts" data-case-facts></dl>
      <div class="case-metrics" data-case-metrics hidden></div>
      <details class="case-evidence" data-case-media="workbench" hidden>
        <summary>查看实际样片对比</summary>
        <a class="image-preview" href={workbenchFull.src} data-image-open data-image-caption="创作间 · 两版实际样片" aria-label="放大实际样片对比" aria-haspopup="dialog" aria-controls="imageLightbox">
          <Image src={workbench} alt="同一段口播的两版实际样片" width={920} loading="lazy" />
        </a>
      </details>

      <a href="#contact" class="btn btn-primary case-drawer-cta" data-case-drawer-cta>
        我也有类似需求
      </a>
    </div>
  </section>
</div>

<style>
  .case-facts { display:grid; gap:0; margin:0; }
  .case-facts :global(div) { padding:16px 0; border-bottom:1px solid var(--border); }
  .case-facts :global(dt) { color:var(--accent); font-size:12px; margin-bottom:8px; }
  .case-facts :global(dd) { margin:0; font-size:14px; line-height:1.85; color:var(--text-secondary); white-space:pre-line; }
  [hidden] { display:none !important; }
  .case-products { display:grid; gap:20px; }
  .product-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-bottom:1px solid var(--border-light); }
  .product-tabs button { min-height:48px; border:0; border-bottom:2px solid transparent; background:none; color:var(--text-secondary); font:inherit; font-size:13px; cursor:pointer; padding:8px 4px; }
  .product-tabs button[aria-selected="true"] { color:var(--accent-hover); border-bottom-color:var(--accent); }
  .case-description, .product-description { font-size:15px; line-height:1.8; color:var(--text-primary); }
  .product-description { margin-top:20px; }
  .case-result { padding-left:14px; border-left:2px solid var(--accent); color:var(--text-secondary); font-size:14px; line-height:1.8; }
  .case-metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  .case-metrics :global(div) { display:grid; gap:8px; padding:18px 12px; border:1px solid var(--border-light); border-radius:8px; }
  .case-metrics :global(strong) { color:var(--accent); font-size:clamp(24px,5vw,32px); }
  .case-metrics :global(span) { color:var(--text-secondary); font-size:12px; }
  .case-drawer-media { margin:0; }
  .case-drawer-media img, .case-evidence img { display:block; width:100%; height:auto; border-radius:8px; }
  .product-proof .image-preview { display:block; aspect-ratio:950/590; overflow:hidden; border-radius:8px; }
  .product-proof img { height:100%; object-fit:cover; object-position:top; }
  [data-product-panel]:not([data-product-panel="jutu"]) .case-drawer-media { padding:20px;background:#1b1c17;border-radius:10px; }
  [data-product-panel]:not([data-product-panel="jutu"]) .case-drawer-media img { max-width:260px;max-height:480px;object-fit:contain;margin:auto; }
  .case-evidence { border-top:1px solid var(--border); padding-top:8px; }
  .case-evidence summary { color:var(--text-secondary); font-size:13px; cursor:pointer; min-height:44px; display:flex; align-items:center; gap:10px; }
  .case-evidence summary::before { content:'+'; color:var(--accent); }
  .case-evidence[open] summary::before { content:'−'; }
  :global(html.case-drawer-open),
  :global(body.case-drawer-open) {
    overflow: hidden;
  }

  .case-drawer {
    position: fixed;
    z-index: 220;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .case-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .case-drawer-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.72);
    opacity: 0;
    cursor: default;
    transition: opacity 0.38s ease;
  }

  .case-drawer.is-open .case-drawer-backdrop {
    opacity: 1;
  }

  .case-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(620px, 100%);
    height: 100%;
    overflow-y: auto;
    border: 0;
    border-left: 1px solid rgba(201, 165, 92, 0.25);
    background:
      linear-gradient(145deg, rgba(201, 165, 92, 0.055), transparent 34%),
      #111;
    box-shadow: -30px 0 90px rgba(0, 0, 0, 0.56);
    transform: translateX(100%);
    transition: transform 0.48s var(--ease-out);
  }

  .case-drawer.is-open .case-drawer-panel {
    transform: translateX(0);
  }

  .case-drawer-close {
    position: sticky;
    z-index: 2;
    top: 18px;
    left: calc(100% - 58px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 18px 18px -40px auto;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    background: rgba(17, 17, 17, 0.9);
    color: var(--text-secondary);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .case-drawer-close:hover,
  .case-drawer-close:focus-visible {
    color: var(--text-primary);
    border-color: rgba(201, 165, 92, 0.42);
    background: rgba(201, 165, 92, 0.08);
  }

  .case-drawer-close svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .case-drawer-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 68px 36px 36px;
  }

  .case-drawer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-body);
    font-size: 12px;
  }

  .case-drawer-category {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .case-drawer-period {
    color: var(--text-muted);
  }

  .case-drawer-brand {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .case-drawer h2 {
    max-width: 460px;
    font-size: 34px;
    line-height: 1.22;
    letter-spacing: 0;
  }

  .case-drawer-summary {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.8;
  }

  .case-drawer-sections {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }

  .case-drawer-sections section {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
  }

  .case-drawer-sections section:last-child {
    border-bottom: 1px solid var(--border);
  }

  .case-drawer-sections span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.5px;
  }

  .case-drawer-sections p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .case-drawer-cta {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .case-drawer-panel {
      width: 100%;
      border-left: 0;
    }

    .case-drawer-content {
      padding: 64px 24px 32px;
    }

    .case-drawer h2 {
      font-size: 28px;
    }

    .case-drawer-sections section {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  @media (max-width: 768px), (pointer: coarse) {
    .case-drawer-close {
      width: 48px;
      height: 48px;
      left: calc(100% - 66px);
      margin-bottom: -48px;
      touch-action: manipulation;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-drawer-backdrop,
    .case-drawer-panel {
      transition: none;
    }
  }
</style>

<script>
  import { featuredCases, type FeaturedCase } from '../data/featured-cases';
  const caseDetails: Record<string, FeaturedCase> = Object.fromEntries(featuredCases.map(item => [item.id, item]));

  const drawer = document.querySelector<HTMLElement>('[data-case-drawer]');

  if (drawer && !drawer.dataset.drawerBound) {
    drawer.dataset.drawerBound = 'true';
    const panel = drawer.querySelector<HTMLElement>('.case-drawer-panel');
    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-case-detail-trigger]'),
    );
    const closeButtons = Array.from(
      drawer.querySelectorAll<HTMLButtonElement>('[data-case-drawer-close]'),
    );
    const closeControl = drawer.querySelector<HTMLButtonElement>('.case-drawer-close');
    const cta = drawer.querySelector<HTMLAnchorElement>('[data-case-drawer-cta]');
    const fields = {
      category: drawer.querySelector<HTMLElement>('[data-case-category]'),
      period: drawer.querySelector<HTMLElement>('[data-case-period]'),
      title: drawer.querySelector<HTMLElement>('[data-case-title]'),
    };
    let activeTrigger: HTMLElement | null = null;
    const productTabs = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-product-tab]'));
    const selectProduct = (id: string, focus = false) => {
      const selected = productTabs.find(tab => tab.dataset.productTab === id) || productTabs[0];
      productTabs.forEach(tab => {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      drawer.querySelectorAll<HTMLElement>('[data-product-panel]').forEach(section => {
        section.hidden = section.dataset.productPanel !== selected.dataset.productTab;
      });
      if (cta) cta.dataset.inquirySource=selected.textContent?.trim() || '小程序开发';
      if (focus) selected.focus();
    };
    productTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectProduct(tab.dataset.productTab!));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % productTabs.length;
        else if (event.key === 'ArrowLeft') next = (index + productTabs.length - 1) % productTabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = productTabs.length - 1;
        else return;
        event.preventDefault();
        selectProduct(productTabs[next].dataset.productTab!, true);
      });
    });

    const setField = (element: HTMLElement | null, value: string) => {
      if (element) element.textContent = value;
    };

    const closeDrawer = (restoreFocus = true) => {
      activeTrigger?.setAttribute('aria-expanded', 'false');
      if (restoreFocus) activeTrigger?.focus({ preventScroll: true });
      else if (document.activeElement instanceof HTMLElement && drawer.contains(document.activeElement)) document.activeElement.blur();
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('case-drawer-open');
      document.body.classList.remove('case-drawer-open');
      activeTrigger = null;
    };

    const openDrawer = (trigger: HTMLElement, detail: FeaturedCase) => {
      activeTrigger?.setAttribute('aria-expanded', 'false');
      activeTrigger = trigger;
      activeTrigger.setAttribute('aria-expanded', 'true');

      setField(fields.category, detail.category);
      setField(fields.period, [detail.kind, detail.period].filter((value,index,all)=>all.indexOf(value)===index).join(' · '));
      setField(fields.title, detail.title);
      const facts = drawer.querySelector<HTMLElement>('[data-case-facts]');
      if (facts) {
        facts.replaceChildren();
        const rows = detail.id === 'crm' ? [
          ['项目背景', detail.client?.industry || detail.category],
          ['前后的变化', detail.problem + '\n' + detail.result],
          ['我负责什么', detail.work],
        ] : detail.id === 'youtube' ? [
          ['制作与发布', detail.work],
        ] : [
          ['解决什么', detail.value],
          ...(detail.client ? [['行业与规模', [detail.client.industry, detail.client.size].filter(Boolean).join(' · ')]] : []),
          ['为什么做', detail.problem], ['做了什么', detail.work],
          ...(detail.result ? [['做完之后', detail.result]] : []),
          ...(detail.measuredResult ? [['结果与周期', [detail.measuredResult.text, detail.measuredResult.period, detail.measuredResult.method].join('\n')]] : []),
          ...(detail.testimonial ? [['客户评价', detail.testimonial.quote + '\n' + detail.testimonial.role + ' · ' + detail.testimonial.date]] : []),
        ];
        rows.forEach(([label,text]) => {
          const row=document.createElement('div'), term=document.createElement('dt'), description=document.createElement('dd');
          term.textContent=label; description.textContent=text; row.append(term,description); facts.append(row);
        });
        facts.hidden=detail.id==='jutu';
      }
      if (cta) {
        cta.dataset.inquiryType=detail.id==='jutu'?'miniapp':detail.audience;
        cta.dataset.inquirySource=detail.title;
      }
      drawer.querySelectorAll<HTMLDetailsElement>('details').forEach(item => item.open = false);
      const metrics = drawer.querySelector<HTMLElement>('[data-case-metrics]');
      if (metrics) {
        metrics.replaceChildren();
        metrics.hidden = !detail.metrics?.length;
        detail.metrics?.forEach(metric => {
          const item = document.createElement('div');
          const value = document.createElement('strong');
          const label = document.createElement('span');
          value.textContent = metric.value;
          label.textContent = metric.label;
          item.append(value, label);
          metrics.append(item);
        });
      }
      drawer.querySelectorAll<HTMLElement>('[data-case-media]').forEach(media => {
        media.hidden = media.dataset.caseMedia !== trigger.dataset.caseDetailTrigger;
      });
      const isProducts = detail.id === 'jutu';
      if (isProducts) selectProduct(trigger.dataset.productOpen || 'jutu');

      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('case-drawer-open');
      document.body.classList.add('case-drawer-open');
      panel?.scrollTo({ top: 0 });
      requestAnimationFrame(() => {
        if (activeTrigger === trigger && drawer.classList.contains('is-open')) closeControl?.focus();
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        // Preserve normal anchor behavior for opening in a new tab.
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const detail = caseDetails[trigger.dataset.caseDetailTrigger || ''];
        if (detail) {
          event.preventDefault();
          openDrawer(trigger, detail);
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', () => closeDrawer());
    });

    cta?.addEventListener('click', () => closeDrawer(false));

    document.addEventListener('keydown', (event) => {
      if (!drawer.classList.contains('is-open')) return;
      // The native image dialog owns Escape and focus while it is above this drawer.
      if (document.querySelector('dialog[data-image-lightbox][open]')) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }

      if (event.key !== 'Tab' || !panel) return;

      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])',
        ),
      );
      const visibleFocusable = focusable.filter(el => el.getClientRects().length > 0);
      const first = visibleFocusable[0];
      const last = visibleFocusable[visibleFocusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
  }
</script>
