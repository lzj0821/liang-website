---
import { Image, getImage } from 'astro:assets';
import workbench from '../assets/refresh/workbench-comparison.png';
import jutuPoster from '../assets/refresh/jutu-input-output.png';
import crmDemo from '../assets/refresh/crm-demo-anonymized.png';

// Lightbox opens a 1600px WebP derivative instead of the multi-MB PNG original.
const crmFull = await getImage({ src: crmDemo, width: 1600, format: 'webp' });
const workbenchFull = await getImage({ src: workbench, width: 1600, format: 'webp' });
const jutuFull = await getImage({ src: jutuPoster, width: 1600, format: 'webp' });
---
<div class="case-drawer" id="caseStudyDrawer" data-case-drawer aria-hidden="true">
  <button
    type="button"
    class="case-drawer-backdrop"
    data-case-drawer-close
    aria-label="关闭案例详情"
    tabindex="-1"
  ></button>

  <section
    class="case-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="caseDrawerTitle"
    tabindex="-1"
  >
    <button
      type="button"
      class="case-drawer-close"
      data-case-drawer-close
      aria-label="关闭案例详情"
      title="关闭"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <div class="case-drawer-content">
      <div class="case-drawer-meta">
        <span class="case-drawer-category" data-case-category></span>
        <span class="case-drawer-period" data-case-period></span>
      </div>

      <p class="case-drawer-brand" data-case-brand></p>
      <h2 id="caseDrawerTitle" data-case-title></h2>
      <p class="case-drawer-summary" data-case-outcome></p>

      <dl class="case-comparison" data-case-comparison hidden>
        <div><dt>原来</dt><dd data-case-before></dd></div>
        <div><dt>现在</dt><dd data-case-after></dd></div>
      </dl>

      <figure class="case-drawer-media case-mobile-demo" data-case-media="crm" hidden>
        <a class="image-preview" href={crmFull.src} data-image-open data-image-caption="客户管理 · 演示数据，图片已做匿名处理" aria-label="放大客户管理界面" aria-haspopup="dialog" aria-controls="imageLightbox">
          <Image src={crmDemo} alt="客户管理移动端演示：查看负责人、待接收、待联系与无效申请待审状态" width={620} loading="lazy" />
        </a>
        <figcaption>界面局部 · 匿名演示数据，点图查看全图</figcaption>
      </figure>
      <figure class="case-drawer-media" data-case-media="workbench" hidden>
        <a class="image-preview" href={workbenchFull.src} data-image-open data-image-caption="个人内容创作工作台 · 同一段内容的两版实际样片" aria-label="放大个人内容创作工作台界面" aria-haspopup="dialog" aria-controls="imageLightbox">
          <Image src={workbench} alt="工作台 A3 样片对比：同一段口播的两种视频画面并排查看" width={920} loading="lazy" />
        </a>
        <figcaption>同一段内容，两版样片并排比较</figcaption>
      </figure>
      <figure class="case-drawer-media" data-case-media="jutu" hidden>
        <a class="image-preview" href={jutuFull.src} data-image-open data-image-caption="居图 AI · 实际输入与生成结果" aria-label="放大居图 AI 输入与输出对照" aria-haspopup="dialog" aria-controls="imageLightbox">
          <Image src={jutuPoster} alt="居图 AI 实际输入与输出：空房变装修效果图，沙发照片变白底图、场景图、模特体验图和产品海报" width={950} loading="lazy" />
        </a>
        <figcaption>空间原图与效果图 · 点图看完整出图示例</figcaption>
      </figure>
      <div class="case-metrics" data-case-metrics hidden></div>
      <p class="case-result" data-case-result></p>
      <p class="case-audience"><span>适合参考</span><span data-case-capability></span></p>
      <details class="case-background" data-case-background>
        <summary>我的工作与项目过程</summary>
        <p class="case-role"><span>我负责</span><span data-case-role></span></p>
        <p data-case-scene></p>
        <p data-case-action></p>
        <div class="case-flows" data-case-flows></div>
      </details>

      <a href="#contact" class="btn btn-primary case-drawer-cta" data-case-drawer-cta>
        我也有类似需求
      </a>
    </div>
  </section>
</div>

<style>
  .case-comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  .case-comparison[hidden] { display:none; }
  .case-comparison > div { padding:14px; border:1px solid var(--border); border-radius:8px; background:#ffffff02; }
  .case-comparison > div:last-child { border-color:#c9a55c38; background:var(--accent-subtle); }
  .case-comparison dt { color:var(--text-muted); font-size:11px; margin-bottom:8px; }
  .case-comparison dd { color:var(--text-secondary); font-size:13px; line-height:1.75; }
  .case-comparison > div:last-child dt { color:var(--accent); }
  .case-comparison > div:last-child dd { color:var(--text-primary); }
  .case-role { display:flex; flex-wrap:wrap; gap:4px 12px; padding-top:10px; }
  .case-role > span:first-child { color:var(--accent); }
  .case-result, .case-background p { color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  .case-audience { display: grid; gap: 6px; color: var(--text-secondary); font-size: 13px; }
  .case-audience > span:first-child { color: var(--accent); font-size: 12px; }
  .case-background { border-top: 1px solid var(--border); padding-top: 14px; }
  .case-background summary { color: var(--text-secondary); cursor: pointer; font-size: 13px; min-height: 32px; }
  .case-background p + p { margin-top: 8px; }
  .case-flows { display: grid; gap: 16px; margin-top:16px; }
  .case-flows :global(h3) { margin-bottom: 8px; color: var(--text-muted); font-size: 12px; font-weight: 500; }
  .case-flows :global(ol) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; list-style: none; }
  .case-flows :global(li) { position: relative; padding: 12px 6px; border: 1px solid var(--border-light); border-radius: 6px; text-align: center; color: var(--accent); font-size: 12px; }
  .case-flows :global(li + li::before) { content: '→'; position: absolute; left: -13px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
  .case-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .case-metrics[hidden] { display: none; }
  .case-metrics :global(div) { display: grid; gap: 6px; padding: 18px 12px; border: 1px solid var(--border-light); border-radius: 8px; }
  .case-metrics :global(strong) { color: var(--accent); font-size: clamp(20px, 4vw, 28px); }
  .case-metrics :global(span) { color: var(--text-secondary); font-size: 12px; }
  .case-examples { padding: 20px; border: 1px solid var(--border-light); border-radius: 8px; }
  .case-examples :global(h3) { color: var(--accent); font-size: 14px; margin: 0 0 8px; }
  .case-examples :global(p) { color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  .case-examples :global(section + section) { margin-top: 20px; }
  .case-drawer-media { margin: 0; }
  .case-mobile-demo { max-width: 310px; margin-inline: auto; }
  .case-mobile-demo .image-preview { display:block; aspect-ratio:1 / 1.1; overflow:hidden; border-radius:8px; }
  .case-mobile-demo .image-preview img { height:100%; object-fit:cover; object-position:50% 48%; }
  [data-case-media="jutu"] .image-preview { display:block; aspect-ratio:950 / 590; overflow:hidden; border-radius:8px; }
  [data-case-media="jutu"] .image-preview img { height:100%; object-fit:cover; object-position:top; }
  .case-drawer-media img { display: block; width: 100%; height: auto; border: 1px solid var(--border-light); border-radius: 8px; }
  .case-drawer-media figcaption { margin-top: 10px; font-size: 12px; color: var(--text-secondary); }
  :global(html.case-drawer-open),
  :global(body.case-drawer-open) {
    overflow: hidden;
  }

  .case-drawer {
    position: fixed;
    z-index: 220;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .case-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .case-drawer-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.72);
    opacity: 0;
    cursor: default;
    transition: opacity 0.38s ease;
  }

  .case-drawer.is-open .case-drawer-backdrop {
    opacity: 1;
  }

  .case-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(560px, 100%);
    height: 100%;
    overflow-y: auto;
    border: 0;
    border-left: 1px solid rgba(201, 165, 92, 0.25);
    background:
      linear-gradient(145deg, rgba(201, 165, 92, 0.055), transparent 34%),
      #111;
    box-shadow: -30px 0 90px rgba(0, 0, 0, 0.56);
    transform: translateX(100%);
    transition: transform 0.48s var(--ease-out);
  }

  .case-drawer.is-open .case-drawer-panel {
    transform: translateX(0);
  }

  .case-drawer-close {
    position: sticky;
    z-index: 2;
    top: 18px;
    left: calc(100% - 58px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 18px 18px -40px auto;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    background: rgba(17, 17, 17, 0.9);
    color: var(--text-secondary);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .case-drawer-close:hover,
  .case-drawer-close:focus-visible {
    color: var(--text-primary);
    border-color: rgba(201, 165, 92, 0.42);
    background: rgba(201, 165, 92, 0.08);
  }

  .case-drawer-close svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .case-drawer-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 100%;
    padding: 68px 52px 48px;
  }

  .case-drawer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .case-drawer-category {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .case-drawer-period {
    color: var(--text-muted);
  }

  .case-drawer-brand {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .case-drawer h2 {
    max-width: 460px;
    font-size: 34px;
    line-height: 1.22;
    letter-spacing: 0;
  }

  .case-drawer-summary {
    color: var(--accent);
    font-size: 15px;
    line-height: 1.8;
  }

  .case-drawer-sections {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }

  .case-drawer-sections section {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
  }

  .case-drawer-sections section:last-child {
    border-bottom: 1px solid var(--border);
  }

  .case-drawer-sections span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.5px;
  }

  .case-drawer-sections p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.75;
  }

  .case-drawer-cta {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .case-drawer-panel {
      width: 100%;
      border-left: 0;
    }

    .case-drawer-content {
      padding: 64px 24px 32px;
    }

    .case-drawer h2 {
      font-size: 28px;
    }

    .case-drawer-sections section {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-drawer-backdrop,
    .case-drawer-panel {
      transition: none;
    }
  }
</style>

<script>
  import { featuredCases, type FeaturedCase } from '../data/featured-cases';
  const caseDetails: Record<string, FeaturedCase> = Object.fromEntries(featuredCases.map(item => [item.id, item]));

  const drawer = document.querySelector<HTMLElement>('[data-case-drawer]');

  if (drawer && !drawer.dataset.drawerBound) {
    drawer.dataset.drawerBound = 'true';
    const panel = drawer.querySelector<HTMLElement>('.case-drawer-panel');
    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-case-detail-trigger]'),
    );
    const closeButtons = Array.from(
      drawer.querySelectorAll<HTMLButtonElement>('[data-case-drawer-close]'),
    );
    const closeControl = drawer.querySelector<HTMLButtonElement>('.case-drawer-close');
    const cta = drawer.querySelector<HTMLAnchorElement>('[data-case-drawer-cta]');
    const fields = {
      brand: drawer.querySelector<HTMLElement>('[data-case-brand]'),
      category: drawer.querySelector<HTMLElement>('[data-case-category]'),
      period: drawer.querySelector<HTMLElement>('[data-case-period]'),
      title: drawer.querySelector<HTMLElement>('[data-case-title]'),
      outcome: drawer.querySelector<HTMLElement>('[data-case-outcome]'),
      scene: drawer.querySelector<HTMLElement>('[data-case-scene]'),
      action: drawer.querySelector<HTMLElement>('[data-case-action]'),
      result: drawer.querySelector<HTMLElement>('[data-case-result]'),
      capability: drawer.querySelector<HTMLElement>('[data-case-capability]'),
      role: drawer.querySelector<HTMLElement>('[data-case-role]'),
      before: drawer.querySelector<HTMLElement>('[data-case-before]'),
      after: drawer.querySelector<HTMLElement>('[data-case-after]'),
    };
    let activeTrigger: HTMLElement | null = null;

    const setField = (element: HTMLElement | null, value: string) => {
      if (element) element.textContent = value;
    };

    const closeDrawer = (restoreFocus = true) => {
      activeTrigger?.setAttribute('aria-expanded', 'false');
      if (restoreFocus) activeTrigger?.focus({ preventScroll: true });
      else if (document.activeElement instanceof HTMLElement && drawer.contains(document.activeElement)) document.activeElement.blur();
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('case-drawer-open');
      document.body.classList.remove('case-drawer-open');
      activeTrigger = null;
    };

    const openDrawer = (trigger: HTMLElement, detail: FeaturedCase) => {
      activeTrigger?.setAttribute('aria-expanded', 'false');
      activeTrigger = trigger;
      activeTrigger.setAttribute('aria-expanded', 'true');

      setField(fields.brand, detail.brand);
      setField(fields.category, detail.category);
      setField(fields.period, detail.period);
      setField(fields.title, detail.title);
      setField(fields.outcome, detail.outcome);
      setField(fields.scene, detail.scene);
      setField(fields.action, detail.action);
      setField(fields.result, detail.result);
      setField(fields.capability, detail.audience);
      setField(fields.role, detail.role);
      setField(fields.before, detail.comparison?.before || '');
      setField(fields.after, detail.comparison?.after || '');
      const comparison = drawer.querySelector<HTMLElement>('[data-case-comparison]');
      if (comparison) comparison.hidden = !detail.comparison;
      const background = drawer.querySelector<HTMLDetailsElement>('[data-case-background]');
      if (background) background.open = false;
      const flows = drawer.querySelector<HTMLElement>('[data-case-flows]');
      if (flows) {
        flows.replaceChildren();
        detail.flows.forEach(flow => {
          const section = document.createElement('section');
          const title = document.createElement('h3');
          const steps = document.createElement('ol');
          title.textContent = flow.title;
          flow.steps.forEach(step => { const item = document.createElement('li'); item.textContent = step; steps.append(item); });
          section.append(title, steps);
          flows.append(section);
        });
      }
      const metrics = drawer.querySelector<HTMLElement>('[data-case-metrics]');
      if (metrics) {
        metrics.replaceChildren();
        metrics.hidden = !detail.metrics?.length;
        detail.metrics?.forEach(metric => {
          const item = document.createElement('div');
          const value = document.createElement('strong');
          const label = document.createElement('span');
          value.textContent = metric.value;
          label.textContent = metric.label;
          item.append(value, label);
          metrics.append(item);
        });
      }
      drawer.querySelectorAll<HTMLElement>('[data-case-media]').forEach(media => {
        media.hidden = media.dataset.caseMedia !== trigger.dataset.caseDetailTrigger;
      });

      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('case-drawer-open');
      document.body.classList.add('case-drawer-open');
      panel?.scrollTo({ top: 0 });
      requestAnimationFrame(() => closeControl?.focus());
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        // Preserve normal anchor behavior for opening in a new tab.
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const detail = caseDetails[trigger.dataset.caseDetailTrigger || ''];
        if (detail) {
          event.preventDefault();
          openDrawer(trigger, detail);
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', () => closeDrawer());
    });

    cta?.addEventListener('click', () => closeDrawer(false));

    document.addEventListener('keydown', (event) => {
      if (!drawer.classList.contains('is-open')) return;
      // The native image dialog owns Escape and focus while it is above this drawer.
      if (document.querySelector('dialog[data-image-lightbox][open]')) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }

      if (event.key !== 'Tab' || !panel) return;

      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])',
        ),
      );
      const visibleFocusable = focusable.filter(el => el.getClientRects().length > 0);
      const first = visibleFocusable[0];
      const last = visibleFocusable[visibleFocusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
  }
</script>
