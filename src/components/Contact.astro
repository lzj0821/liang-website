---
import { Image } from 'astro:assets';
import wechatQR from '../assets/images/wechat-qr.png';
import FeaturedArticles from './FeaturedArticles.astro';
const socials = [
  {name:'小红书',url:'https://xhslink.com/m/7htcBmaHvMh'},
  {name:'抖音',url:'https://v.douyin.com/n4Uw16gQ4J4/'},
  {name:'公众号',url:'https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzY5NzIzNzExMg==#wechat_redirect'},
];
---
<section class="section contact" id="contact" data-story-section="contact">
  <div class="container">
    <div class="section-header contact-heading"><span class="section-label">联系我</span><h2 class="section-title">说说你想做的事</h2><p class="section-desc">直接加微信聊就好。想先理一理思路，也可以在下面写几句，复制发给我。</p></div>
    <div class="contact-options" aria-label="选择联系方法"><button type="button" class="btn btn-primary" data-qr-open>加微信聊聊 <span aria-hidden="true">↗</span></button><a href="#inquiry-form" class="btn btn-outline">先写几句 <span aria-hidden="true">↓</span></a><span>微信号 C49909</span></div>
    <div class="contact-layout">
      <form class="inquiry-form" id="inquiry-form" data-inquiry-form hidden novalidate>
        <div class="inquiry-field">
          <label for="inquiry-type">想聊哪方面？</label>
          <select id="inquiry-type" name="type">
            <option value="unsure">还没确定</option>
            <option value="enterprise">企业 AI 落地</option>
            <option value="individual">智能体与工作流定制开发</option>
            <option value="miniapp">小程序开发</option>
            <option value="training">线下分享与企业内训</option>
          </select>
          <p class="inquiry-help" data-inquiry-help>先说业务和想法，技术怎么选，我们一起看。</p>
        </div>
        <div class="inquiry-source" data-inquiry-source-row hidden><span>关于：<span data-inquiry-source-text></span></span><button type="button" data-clear-inquiry-source aria-label="移除项目来源">移除</button></div>
        <div class="inquiry-field"><label for="inquiry-business">你在做什么业务？</label><input id="inquiry-business" name="business" type="text" maxlength="100" required autocomplete="off" placeholder="做什么行业，服务哪些客户？简单说说就好" aria-describedby="inquiry-business-error" /><span class="field-error" id="inquiry-business-error"></span></div>
        <div class="inquiry-field"><label for="inquiry-task">这次最想做成什么？</label><textarea id="inquiry-task" name="task" rows="3" maxlength="500" required placeholder="想解决的问题，或者想做的工具、产品，都可以聊" aria-describedby="inquiry-task-error"></textarea><span class="field-error" id="inquiry-task-error"></span></div>
        <div class="inquiry-field"><label for="inquiry-current">现在是怎么做的？<span class="optional">可不填</span></label><textarea id="inquiry-current" name="current" rows="2" maxlength="500" placeholder="有现成做法、参考产品或希望完成的时间，可以一起说说" aria-describedby="inquiry-current-error"></textarea><span class="field-error" id="inquiry-current-error"></span></div>
        <div class="assessment-contact" data-assessment-contact hidden>
          <label class="assessment-toggle"><input type="checkbox" name="includeAssessment" checked data-include-assessment />一起带上场景自测结果</label>
          <details><summary>查看或调整自测内容</summary><label class="sr-only" for="inquiry-assessment">自测结果</label><textarea id="inquiry-assessment" data-inquiry-assessment rows="7" maxlength="2000"></textarea></details>
        </div>
        <button type="submit" class="btn btn-primary inquiry-copy">复制这些话，去微信聊 <span aria-hidden="true">↗</span></button>
        <p class="inquiry-status" data-inquiry-status role="status" aria-live="polite"></p>
        <button type="button" class="text-button" data-qr-open data-after-copy hidden>查看微信二维码，添加后粘贴发送 →</button>
        <label for="inquiry-output" data-inquiry-output-label hidden>选中下方内容，复制到微信</label>
        <textarea id="inquiry-output" data-inquiry-output rows="10" readonly hidden></textarea>
      </form>
      <noscript><p>微信联系 C49909，告诉我你的业务、想解决的问题和现在的做法。</p></noscript>
      <aside class="contact-direct" aria-labelledby="wechat-title">
        <h3 id="wechat-title">微信上找我</h3><p>有现成的想法或截图，直接发过来也行。</p>
        <button type="button" class="contact-qr-frame" data-qr-open aria-label="放大微信二维码"><Image src={wechatQR} alt="Liangzhenjie 的微信二维码" width={280} loading="lazy" /></button>
        <div class="wechat-id-row"><span>微信号 <strong id="wechat-id">C49909</strong></span><button type="button" data-copy-wechat class="text-button">复制微信号</button></div>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        <p class="qr-hint">微信内可长按识别</p>
      </aside>
    </div>
    <div class="contact-reading" id="articles"><div><h3>我的日常分享</h3><p>做过的尝试，遇到的问题，写下来和你分享。</p><div class="social-links">{socials.map(item=><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}<span aria-hidden="true">↗</span></a>)}</div></div><FeaturedArticles /></div>
  </div>
  <dialog class="qr-lightbox" data-qr-dialog aria-labelledby="qr-dialog-title">
    <button type="button" class="qr-dialog-close" data-qr-close aria-label="关闭微信二维码">×</button>
    <h3 id="qr-dialog-title">微信联系 Liangzhenjie</h3>
    <img src={wechatQR.src} alt="Liangzhenjie 的微信二维码，微信号 C49909" width={wechatQR.width} height={wechatQR.height} />
    <p>微信号 C49909</p><a href={wechatQR.src} download="Liangzhenjie-微信二维码.png" class="text-button">保存二维码</a>
  </dialog>
</section>
<a href="#contact" class="mobile-contact" data-mobile-contact hidden>有个想法，想聊聊 <span>联系我 →</span></a>
<style>
  [hidden] { display:none !important; }
  #articles { scroll-margin-top:96px; }
  .contact-heading { text-align:left; margin-bottom:36px; }
  .contact-heading .section-title,.contact-heading .section-desc { text-align:left; margin-left:0; }
  .contact-options { display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:28px; }
  .contact-options > span { color:var(--text-secondary); font-size:13px; margin-left:8px; }
  #inquiry-form { scroll-margin-top:100px; }
  @media(max-width:480px) { .contact-options .btn { padding:12px 16px; font-size:14px; } .contact-options > span { width:100%; margin:0; } }
  .contact-layout { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(240px,.75fr); gap:80px; align-items:start; }
  .inquiry-form { display:grid; gap:20px; padding:30px; border:1px solid var(--border-light); border-radius:14px; background:var(--bg-card); }
  .inquiry-field { display:grid; gap:8px; }
  .inquiry-help { color:var(--text-secondary);font-size:12px;line-height:1.8; }.optional { color:var(--text-muted);font-size:12px;margin-left:10px; }
  label { color:var(--text-primary); font-size:14px; }
  input[type=text],textarea,select { width:100%; min-width:0; border:1px solid #424239; background:#10110f; border-radius:7px; color:var(--text-primary); font:inherit; font-size:15px; line-height:1.7; padding:11px 13px; color-scheme:dark; }
  textarea { resize:vertical; min-height:96px; }
  select { min-height:48px; }
  input::placeholder,textarea::placeholder { color:#8b8b83; }
  input:focus-visible,textarea:focus-visible,select:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  [aria-invalid=true] { border-color:#df9f8d !important; }
  .field-error,.inquiry-status { font-size:13px; line-height:1.8; }
  .field-error { color:#efb29f; } .field-error:empty,.inquiry-status:empty { display:none; }
  .inquiry-status { color:var(--accent-hover); }
  .inquiry-copy { width:100%; justify-content:space-between; font-size:14px; }
  .inquiry-source { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:12px; color:var(--text-secondary); padding-bottom:12px; border-bottom:1px solid var(--border); }
  .inquiry-source button { color:var(--text-secondary); background:none; border:0; font:inherit; min-height:44px; cursor:pointer; flex-shrink:0; }
  .assessment-contact { border-top:1px solid var(--border); padding-top:16px; }
  .assessment-toggle { display:flex; align-items:center; gap:10px; cursor:pointer; min-height:44px; }
  .assessment-toggle input { accent-color:var(--accent); width:18px; height:18px; flex-shrink:0; }
  .assessment-contact summary { color:var(--text-secondary); cursor:pointer; font-size:13px; padding:12px 0; min-height:44px; }
  .assessment-contact textarea { font-size:13px; }
  .contact-direct { padding-top:6px; }
  h3 { font-size:23px; font-weight:500; }
  .contact-direct > p,.contact-reading p { font-size:14px; color:var(--text-secondary); line-height:1.8; margin-top:10px; }
  .contact-qr-frame { display:block; width:226px; padding:8px; background:#fff; border:1px solid var(--border); border-radius:12px; margin-top:26px; cursor:zoom-in; }
  .contact-qr-frame img { display:block; width:100%; height:auto; border-radius:6px; }
  .wechat-id-row { display:flex; flex-wrap:wrap; align-items:center; gap:8px 18px; margin-top:12px; font-size:14px; }
  .text-button { display:inline-flex; align-items:center; min-height:44px; background:none; border:0; font:inherit; font-size:13px; color:var(--accent); cursor:pointer; }
  .contact-direct .copy-status { font-size:12px; margin:0; } .contact-direct .qr-hint { margin-top:0; font-size:12px; }
  .contact-note { border-top:1px solid var(--border); margin-top:28px; padding-top:24px; max-width:310px; }
  .contact-note > span { font-size:13px; color:var(--accent); } .contact-note p { font-size:14px; color:var(--text-secondary); line-height:1.9; margin-top:10px; }
  .contact-reading { margin-top:64px; padding-top:32px; border-top:1px solid var(--border); display:grid; grid-template-columns:1fr 1fr; gap:48px; }
  .social-links { display:flex; gap:24px; flex-wrap:wrap; margin-top:14px; } .social-links a { display:inline-flex; gap:10px; align-items:center; min-height:44px; color:var(--accent); font-size:13px; }
  .qr-lightbox { width:min(420px,calc(100vw - 32px)); margin:auto; padding:56px 24px 24px; background:var(--bg-surface); color:var(--text-primary); border:1px solid var(--border-light); border-radius:12px; text-align:center; max-height:calc(100dvh - 32px); overflow:auto; }
  .qr-lightbox::backdrop { background:#000c; } .qr-lightbox img { display:block; width:min(100%,300px); height:auto; margin:20px auto; }
  .qr-lightbox h3 { font-size:18px; }
  .qr-dialog-close { position:absolute; right:8px; top:8px; width:44px; height:44px; background:none; border:0; color:var(--text-primary); font-size:28px; cursor:pointer; }
  .mobile-contact { display:none; }
  @media(max-width:1024px) { .contact-layout { gap:40px; } }
  @media(max-width:768px) { .contact-layout { grid-template-columns:1fr; gap:32px; } .inquiry-form { padding:20px; gap:18px; } input[type=text],textarea,select { font-size:16px; } .contact-heading { margin-bottom:28px; } .contact-direct { border-top:1px solid var(--border); padding-top:28px; } .contact-note { display:none; } .contact-reading { grid-template-columns:1fr; gap:22px; margin-top:40px; } .mobile-contact { position:fixed; z-index:90; left:16px; right:16px; bottom:calc(12px + env(safe-area-inset-bottom,0px)); display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:52px; padding:14px 18px; border-radius:8px; background:var(--accent); color:#14130e; font-size:14px; font-weight:600; box-shadow:0 8px 26px #0006; } .mobile-contact span { font-size:12px; font-weight:400; } :global(body.case-drawer-open) .mobile-contact,:global(body.image-lightbox-open) .mobile-contact,:global(body.qr-lightbox-open) .mobile-contact,:global(body:has(dialog[open])) .mobile-contact { display:none; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  if (form) {
    const type = form.querySelector<HTMLSelectElement>('#inquiry-type')!;
    const help = form.querySelector<HTMLElement>('[data-inquiry-help]')!;
    const prompts:Record<string,string> = {
      unsure:'先说业务和想法，技术怎么选，我们一起看。',
      enterprise:'公司做什么、想改善哪部分业务？先从这里聊。',
      individual:'准备给谁用、想帮他做什么？有参考工具也可以说说。',
      miniapp:'谁会用这个小程序，最需要哪几个功能？',
      training:'哪些岗位参加、大概多少人、希望学会什么？',
    };
    const updateHelp=()=>{help.textContent=prompts[type.value]||prompts.unsure;};
    type.addEventListener('change',updateHelp);
    const sourceRow = form.querySelector<HTMLElement>('[data-inquiry-source-row]')!;
    const sourceText = form.querySelector<HTMLElement>('[data-inquiry-source-text]')!;
    const status = form.querySelector<HTMLElement>('[data-inquiry-status]')!;
    const output = form.querySelector<HTMLTextAreaElement>('[data-inquiry-output]')!;
    const outputLabel = form.querySelector<HTMLElement>('[data-inquiry-output-label]')!;
    const assessment = form.querySelector<HTMLElement>('[data-assessment-contact]')!;
    const assessmentText = form.querySelector<HTMLTextAreaElement>('[data-inquiry-assessment]')!;
    const includeAssessment = form.querySelector<HTMLInputElement>('[data-include-assessment]')!;
    const copyButton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const afterCopy = form.querySelector<HTMLButtonElement>('[data-after-copy]')!;
    let source = '';
    let revision = 0;
    const clearOutput = () => { revision++; status.textContent=''; output.hidden=true; outputLabel.hidden=true; output.value=''; afterCopy.hidden=true; };
    const setSource = (value:string) => { source=value; sourceText.textContent=value; sourceRow.hidden=!value; clearOutput(); };
    document.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const trigger=event.target.closest<HTMLElement>('[data-inquiry-type]');
      if (!trigger || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const value=trigger.dataset.inquiryType;
      if (Array.from(type.options).some(option=>option.value===value)) type.value=value!;
      updateHelp();
      setSource(trigger.dataset.inquirySource || '');
    });
    const article=new URLSearchParams(location.search).get('article');
    const articleTitles:Record<string,string> = {
      'ai-project-priorities':'企业 AI 项目优先级',
      'agent-onboarding':'Agent 上岗与团队协作',
      'customer-followup':'客户跟进与管理',
    };
    if(article && articleTitles[article]) { type.value='enterprise';setSource(articleTitles[article]); }
    updateHelp();
    form.querySelector('[data-clear-inquiry-source]')?.addEventListener('click',()=>setSource(''));
    window.addEventListener('scenario:result', event => {
      const summary=(event as CustomEvent<string>).detail;
      assessment.hidden=!summary;
      assessmentText.value=summary || '';
      includeAssessment.checked=true;
      if(summary) { type.value='unsure';setSource('场景自测');updateHelp(); }
      else if(source==='场景自测') setSource('');
      clearOutput();
    });
    form.addEventListener('input',event=>{
      clearOutput();
      const field=event.target;
      if(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
        field.removeAttribute('aria-invalid');
        const error=document.getElementById(field.id+'-error'); if(error) error.textContent='';
      }
    });
    form.addEventListener('change',clearOutput);
    form.addEventListener('submit',async event=>{
      event.preventDefault();
      if(copyButton.disabled) return;
      const fields=[
        {id:'inquiry-business',label:'我在做的业务',error:'简单说说你在做什么业务。'},
        {id:'inquiry-task',label:'这次想做的事',error:'写下你想解决的问题或想做的事。'},
        {id:'inquiry-current',label:'现在的做法',error:'说说现在怎么做；还没开始也可以。'},
      ];
      let firstInvalid:HTMLElement|null=null;
      const answers=fields.map(item=>{
        const field=form.querySelector<HTMLInputElement|HTMLTextAreaElement>('#'+item.id)!;
        const value=field.value.trim();
        const valid=(!field.required || !!value) && value.length<=field.maxLength;
        const error=document.getElementById(item.id+'-error')!;
        field.setAttribute('aria-invalid',String(!valid));
        error.textContent=valid?'':!value?item.error:'内容过长，请精简后再试。';
        if(!valid && !firstInvalid) firstInvalid=field;
        return value ? item.label+'：'+value : '';
      }).filter(Boolean);
      if(firstInvalid) { (firstInvalid as HTMLElement).focus();status.textContent='说说你的业务和想做的事，就可以复制了。';return; }
      const text=['你好，我想聊聊一个想法。','想了解：'+type.selectedOptions[0].text,...(source?['我感兴趣的是：'+source]:[]),...answers,...(!assessment.hidden && includeAssessment.checked && assessmentText.value.trim()?['',assessmentText.value.trim()]:[])].join('\n');
      const copyingRevision=revision;
      copyButton.disabled=true;
      try {
        await navigator.clipboard.writeText(text);
        if(copyingRevision===revision) { status.textContent='已复制。加微信 C49909，粘贴发给我就好。';afterCopy.hidden=false; }
      } catch {
        if(copyingRevision===revision) {
          output.value=text;output.hidden=false;outputLabel.hidden=false;
          status.textContent='请选中下方文字，手动复制到微信。';output.focus();output.select();
        }
      } finally { copyButton.disabled=false; }
    });
    form.hidden=false;
  }
  const qrDialog=document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
  let qrTrigger:HTMLButtonElement|null=null;
  document.querySelectorAll<HTMLButtonElement>('[data-qr-open]').forEach(trigger=>trigger.addEventListener('click',()=>{
    if(!qrDialog || qrDialog.open)return;
    qrTrigger=trigger;
    qrDialog.showModal();document.documentElement.classList.add('qr-lightbox-open');document.body.classList.add('qr-lightbox-open');
  }));
  document.querySelector('[data-qr-close]')?.addEventListener('click',()=>qrDialog?.close());
  qrDialog?.addEventListener('click',event=>{if(event.target===qrDialog)qrDialog.close();});
  qrDialog?.addEventListener('close',()=>{document.documentElement.classList.remove('qr-lightbox-open');document.body.classList.remove('qr-lightbox-open');qrTrigger?.focus();});
  document.querySelector('[data-copy-wechat]')?.addEventListener('click',async()=>{
    const status=document.querySelector<HTMLElement>('[data-copy-status]');
    try {await navigator.clipboard.writeText('C49909');if(status)status.textContent='已复制微信号 C49909';}
    catch {const id=document.querySelector('#wechat-id');if(id){const range=document.createRange();range.selectNodeContents(id);const selection=window.getSelection();selection?.removeAllRanges();selection?.addRange(range);}if(status)status.textContent='请选中微信号 C49909 手动复制';}
  });
  const mobileContact=document.querySelector<HTMLElement>('[data-mobile-contact]');
  const hero=document.querySelector('#hero'), contact=document.querySelector('#contact'), scenario=document.querySelector('#roi');
  if(hero && contact && mobileContact) {
    let pastHero=false,contactVisible=false,scenarioVisible=false;
    const observer=new IntersectionObserver(entries=>{
      entries.forEach(entry=>{if(entry.target===hero)pastHero=!entry.isIntersecting && entry.boundingClientRect.bottom<=76;if(entry.target===contact)contactVisible=entry.isIntersecting;if(entry.target===scenario)scenarioVisible=entry.isIntersecting;});
      mobileContact.hidden=!pastHero || contactVisible || scenarioVisible;
    },{rootMargin:'-76px 0px 0px 0px',threshold:0});
    observer.observe(hero);observer.observe(contact);if(scenario)observer.observe(scenario);
  }
</script>
