---
import { processCopy } from '../data/visual-copy';
---
<section class="section process" id="process" data-story-section="process">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">合作流程</span>
      <h2 class="section-title">如果一起做，怎么开始？</h2>
    </div>
    <div class="process-timeline">
      {processCopy.map((step,i) => (
        <div class="process-step reveal" data-process-step={i}>
          <div class="process-number">{String(i+1).padStart(2,'0')}</div>
          <div class="process-card card">
            <figure class="process-visual">

              <figcaption><span>{step.title}</span><h3>{step.output}</h3></figcaption>
              <p class="process-note">{step.detail}</p>
            </figure>
            <div class="process-meta"><span>{step.time}</span><strong>{step.cost}</strong></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .process-timeline { --process-progress:0; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; }
  .process-step { min-width:0; position:relative; }
  .process-number { font-family:var(--font-mono); font-size:20px; color:var(--accent); opacity:.6; margin:0 0 14px 4px; }
  .process-step:not(:last-child) .process-number::after { content:'→'; position:absolute; right:4px; color:var(--text-muted); font-family:var(--font-body); }
  .process-card { padding:0; overflow:hidden; transition:border-color .3s,box-shadow .3s; }
  .process-visual { position:relative; margin:0; min-height:210px; background:radial-gradient(ellipse at 70% 70%,#c9a55c12,transparent 70%),#141413; }
  .process-illustration { position:absolute; width:128px; right:10px; bottom:0; }
  figcaption { position:relative; padding:22px; }
  figcaption span { display:block; font-size:14px; color:#b8b3a8; margin-bottom:8px; }
  h3 { font-size:23px; font-weight:650; color:#ead7a5; letter-spacing:-.025em; }
  .process-meta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px 12px; padding:16px 18px; border-top:1px solid var(--border); font-size:13px; color:var(--text-secondary); }
  .process-meta strong { color:var(--accent); font-weight:500; }
  .process-step.story-current .process-card { border-color:#c9a55c70; box-shadow:0 10px 32px #0003; }
  .process-step.story-current .process-number,.process-step.story-complete .process-number { opacity:1; }
  .process-details { max-width:720px; margin:24px auto 0; font-size:14px; color:var(--text-secondary); }
  summary { cursor:pointer; min-height:44px; padding:12px 0; color:var(--accent); }
  dl { display:grid; gap:12px; padding:12px 0; }
  dl > div { display:grid; grid-template-columns:64px minmax(0,1fr); gap:12px; line-height:1.8; }
  dt { color:var(--text-primary); }
  @media(max-width:1024px) { .process-timeline { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:768px) {
    .process-timeline { grid-template-columns:1fr; gap:16px; max-width:480px; margin:auto; }
    .process-step { display:grid; grid-template-columns:28px minmax(0,1fr); gap:10px; }
    .process-number { font-size:17px; margin:22px 0 0; }
    .process-step:not(:last-child) .process-number::after { content:''; top:56px; bottom:-12px; left:10px; right:auto; width:1px; background:linear-gradient(#c9a55c60,#c9a55c10); }
    .process-visual { min-height:132px; }
    .process-illustration { width:96px; bottom:-3px; right:0; opacity:.8; }
    figcaption { padding:20px 14px; }
    h3 { font-size:22px; }
    .process-meta { font-size:14px; padding:12px 14px; }
    .process-details { max-width:480px; }
  }
  @media(max-width:360px) { .process-illustration { width:70px; } h3 { font-size:21px; } }
  @media(prefers-reduced-motion:reduce) { .process-card { transition:none; } }

  .process-card { height:100%;display:flex;flex-direction:column; }
  .process-visual { flex:1;min-height:0; }
  figcaption { padding:20px 18px 0; }
  .process-note { padding:0 18px 20px;font-size:14px;line-height:1.8;color:var(--text-secondary); }
  .process-meta { margin-top:auto; }
  @media(max-width:768px) { .process-visual { min-height:0; } figcaption { padding:18px 14px 10px; } .process-note { padding:0 14px 16px; } }
  /* The process is a reading aid; keep the deliverable and terms in view together. */
  figcaption { padding-bottom:12px; }
  .process-card:hover { transform:none; }
  @media(max-width:768px) {
    .process-timeline { gap:12px; }
    figcaption { display:flex; align-items:baseline; gap:12px; padding:14px 14px 8px; }
    figcaption span { margin:0; font-size:12px; }
    h3 { font-size:18px; }
    .process-note { font-size:13px; padding-bottom:12px; }
    .process-meta { font-size:12px; padding:10px 14px; }
  }
</style>
<script>
  const processSection = document.querySelector<HTMLElement>('[data-story-section="process"]');

  if (processSection && !processSection.dataset.storyBound) {
    processSection.dataset.storyBound = 'true';
    const timeline = processSection.querySelector<HTMLElement>('.process-timeline');
    const steps = Array.from(processSection.querySelectorAll<HTMLElement>('[data-process-step]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'process' || !timeline) return;

      const progress = reducedMotion ? 1 : Math.min(1, Math.max(0, detail.progress));
      timeline.style.setProperty('--process-progress', progress.toFixed(4));
      const currentIndex = Math.min(steps.length - 1, Math.floor(progress * steps.length));

      steps.forEach((step, index) => {
        step.classList.toggle('story-complete', reducedMotion || index < currentIndex);
        step.classList.toggle('story-current', !reducedMotion && index === currentIndex);
      });
    });
  }
</script>
