---
import { featuredCases } from '../data/featured-cases';
import CaseVisual from './CaseVisual.astro';
const accents: Record<string, string> = {
  crm: '#8eb9d4', automation: '#85bfae', jutu: '#aaa5de',
  workbench: '#b4a0ce', youtube: '#d3a08c', growth: '#d3b672',
};
const cardCopy: Record<string, string> = {
  crm: '多平台线索，沉淀到自己的系统。',
  automation: '少做重复整理与复制填表。',
  jutu: '居图 AI · AI 重置 · 纸间声语',
  workbench: '视频、字幕、封面，集中制作。',
  youtube: '15 天内，完成系列制作与发布。',
  growth: '把重复整理，交给工具处理。',
};
---

<section class="section cases" id="cases" data-story-section="cases">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">实战案例</span>
      <h2 class="section-title">用结果说话</h2>
      <p class="section-desc">从客户跟进到内容制作，让需求变成可用的工具。</p>
    </div>
    <div class="cases-grid">
      {featuredCases.map((item, index) => (
        <article class="case-card card reveal" id={'case-' + item.id} data-case-story={index} style={'--case-accent:' + accents[item.id]}>
          <CaseVisual id={item.id} />
          <div class="case-copy">
            <span class="case-brand">{item.category}</span>
            <h3 class="case-title">{item.title}</h3>
            <div class="case-bottom">
              <p class="case-desc">{cardCopy[item.id]}</p>
              <button type="button" class="case-detail-trigger" data-case-detail-trigger={item.id} data-product-open={item.id === 'jutu' ? 'reset' : undefined}
                aria-label={'了解案例：' + item.title} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cases { overflow: hidden; }
  .cases > .container { position: relative; z-index: 2; }
  .cases-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .case-card {
    min-width: 0; scroll-margin-top: 100px; padding: 12px;
    display: flex; flex-direction: column; position: relative;
    border: 1px solid #ffffff0f; border-radius: 16px; overflow: hidden;
    background: linear-gradient(155deg, color-mix(in srgb,var(--case-accent) 4%,transparent),transparent 60%),var(--bg-card);
    transition: transform .3s var(--ease-out), border-color .3s, box-shadow .3s;
  }
  .case-copy { display: flex; flex-direction: column; flex: 1; gap: 10px; padding: 20px 10px 8px; }
  .case-brand { display: flex; align-items: center; gap: 8px; color: var(--case-accent); font-size: 12px; font-weight: 500; letter-spacing: .04em; }
  .case-brand::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .case-title { font-size: 20px; font-weight: 700; letter-spacing: -.02em; line-height: 1.45; text-wrap: balance; }
  .case-bottom { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .case-desc { flex: 1; font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
  .case-detail-trigger {
    display: flex; align-items: center; justify-content: center; flex: 0 0 44px;
    width: 44px; height: 44px; border: 1px solid var(--border-light); border-radius: 50%;
    background: transparent; color: var(--text-secondary); cursor: pointer;
    transition: color .2s, border-color .2s, background .2s;
  }
  /* One accessible button opens the case from the entire card. */
  .case-detail-trigger::after { content: ''; position: absolute; inset: 0; }
  .case-detail-trigger svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s; }
  .case-card:focus-within { outline: 2px solid var(--accent); outline-offset: 4px; }
  .case-detail-trigger:focus-visible { outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .case-card.visible:hover { transform: translateY(-4px); border-color: color-mix(in srgb,var(--case-accent) 35%,transparent); box-shadow: 0 16px 36px #0003; }
    .case-card:hover .case-detail-trigger { color: var(--case-accent); border-color: var(--case-accent); background: color-mix(in srgb,var(--case-accent) 8%,transparent); }
    .case-card:hover .case-detail-trigger svg { transform: translateX(2px); }
  }
  @media (max-width: 1024px) { .cases-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; } }
  @media (max-width: 640px) {
    .cases-grid { grid-template-columns: 1fr; gap: 20px; }
    .case-card { padding: 10px; }
    .case-copy { padding: 16px 8px 6px; gap: 8px; }
    .case-title { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .case-card, .case-card.visible:hover { transform: none; } }
</style>

<script>
  const casesSection = document.querySelector<HTMLElement>('[data-story-section="cases"]');

  if (casesSection && !casesSection.dataset.storyBound) {
    casesSection.dataset.storyBound = 'true';
    const cards = Array.from(casesSection.querySelectorAll<HTMLElement>('[data-case-story]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'cases') return;

      cards.forEach((card, index) => {
        const threshold = 0.04 + (index / Math.max(1, cards.length - 1)) * 0.7;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    });
  }
</script>
