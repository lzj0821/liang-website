---
import { featuredCases } from '../data/featured-cases';
import CaseVisual from './CaseVisual.astro';
import AgentExamples from './AgentExamples.astro';
const mainCases = ['crm','workbench'].map(id=>featuredCases.find(item=>item.id===id)!);
const otherCases = ['automation','growth','youtube'].map(id=>featuredCases.find(item=>item.id===id)!);
---
<section class="section cases" id="cases" data-story-section="cases">
  <div class="container">
    <div class="section-header reveal"><span class="section-label">项目与作品</span><h2 class="section-title">这些事，我已经动手做了</h2><p class="section-desc">先看两个项目：一个用在公司业务里，一个用在自己的创作中。</p></div>
    <div class="cases-grid">
      {mainCases.map(item=><div id={item.id==='crm'?'cases-business':'cases-personal'} class="case-anchor">
        <article class="case-card card reveal" id={'case-'+item.id}>
          <CaseVisual id={item.id} />
          <div class="case-copy"><div class="case-meta"><span>{item.category}</span><span>{item.kind}</span></div><h3>{item.title}</h3><p class="case-value">{item.value}</p>
          <button type="button" class="case-detail-trigger" data-case-detail-trigger={item.id} aria-label={'了解案例：'+item.title} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">查看项目 <span aria-hidden="true">↗</span></button></div>
        </article>
      </div>)}
    </div>
    <a class="products-link" href="#miniapp-products">还做了三个微信小程序，看看能用来做什么 <span aria-hidden="true">↑</span></a>
    <details class="more-projects">
      <summary><span>更多项目与使用样例<small>报表处理、系列短视频、智能体样例</small></span><span class="more-toggle" aria-hidden="true">+</span></summary>
      <div class="more-content">
        <div class="other-projects">
          {otherCases.map(item=><article id={'case-'+item.id}>
            <span class="case-kind">{item.kind}</span><h3>{item.title}</h3><p>{item.id==='youtube'?item.summary:item.value}</p>
            <button type="button" data-case-detail-trigger={item.id} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">看看怎么做的 <span aria-hidden="true">↗</span></button>
          </article>)}
        </div>
        <AgentExamples />
      </div>
    </details>
  </div>
</section>
<style>
  .cases-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px; }
  .case-anchor,.case-card { min-width:0;scroll-margin-top:100px; }
  .case-card { padding:12px;height:100%;display:flex;flex-direction:column;border-color:#c9a55c35; }
  .case-copy { padding:22px 14px 4px;flex:1;display:flex;flex-direction:column; }
  .case-meta { display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--accent); }
  .case-meta span:last-child { color:var(--text-secondary); }
  h3 { font-size:23px;font-weight:600;line-height:1.5;margin:12px 0 10px; }
  .case-value { color:var(--text-secondary);font-size:15px;line-height:1.8;margin-bottom:18px; }
  .case-detail-trigger { display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:auto;padding:12px 0;min-height:44px;border:0;border-top:1px solid var(--border);background:none;font:inherit;font-size:14px;color:var(--accent);cursor:pointer; }
  .products-link { display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:12px 4px;font-size:14px;line-height:1.7;color:var(--text-secondary); }
  .products-link:hover { color:var(--accent); }
  .more-projects { border:1px solid var(--border-light);border-radius:12px;margin-top:16px;overflow:hidden;background:var(--bg-card); }
  summary { display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px;cursor:pointer;list-style:none;font-size:17px; }
  summary::-webkit-details-marker { display:none; } summary small { display:block;font-size:13px;color:var(--text-secondary);line-height:1.8;margin-top:6px; }
  .more-toggle { color:var(--accent);font-size:24px; } details[open] .more-toggle { transform:rotate(45deg); }
  .more-content { padding:0 24px 24px; }
  .other-projects { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px; }
  .other-projects article { display:flex;flex-direction:column;min-width:0;padding:20px;background:#10110f;border:1px solid var(--border);border-radius:10px;scroll-margin-top:100px; }
  .case-kind { font-size:12px;color:var(--text-muted); }.other-projects h3 { font-size:18px; }
  .other-projects p { font-size:14px;line-height:1.8;color:var(--text-secondary);margin-bottom:14px; }
  .other-projects button { display:flex;justify-content:space-between;align-items:center;min-height:44px;margin-top:auto;background:none;border:0;border-top:1px solid var(--border);font:inherit;font-size:13px;color:var(--accent);cursor:pointer;text-align:left; }
  @media(max-width:768px) { .cases-grid { grid-template-columns:1fr;gap:20px; }.case-copy { padding:18px 8px 2px; }h3 { font-size:21px; }.other-projects { grid-template-columns:1fr;gap:12px; }summary { padding:20px; }.more-content { padding:0 16px 16px; }.products-link { font-size:13px; } }
</style>
<script>
  const revealLinkedProject=()=>{
    const target=document.getElementById(location.hash.slice(1));
    const collection=target?.closest<HTMLDetailsElement>('.more-projects');
    if(collection && !collection.open){collection.open=true;requestAnimationFrame(()=>target?.scrollIntoView({behavior:'instant',block:'start'}));}
  };
  revealLinkedProject();
  window.addEventListener('hashchange',revealLinkedProject);
</script>
