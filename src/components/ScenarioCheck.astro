---
import TaskIcon from './TaskIcon.astro';
import DeliveryGlyph from './DeliveryGlyph.astro';
import { scenarioQuestions } from '../data/scenario-check';
import { featuredCases } from '../data/featured-cases';
---

<section class="section scenario-check" id="roi" data-story-section="roi">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">AI 场景自测</span>
      <h2 class="section-title">哪件事，值得交给 AI？</h2>
      <p class="section-desc">最多 4 个问题，找到适合你的起点。</p>
    </div>
    <div class="scenario-card reveal" data-scenario-card>
      <form data-scenario-form hidden novalidate>
        <div class="scenario-topline"><span data-scenario-progress aria-live="polite">01 / 04</span><span>约 30 秒 · 无需留联系方式</span></div>
        <nav class="scenario-steps" aria-label="自测步骤">
          {scenarioQuestions.map((q,i)=><button type="button" data-scenario-jump={i} disabled={i!==0} aria-current={i===0?'step':undefined}><span>{String(i+1).padStart(2,'0')}</span>{q.short}</button>)}
        </nav>
        <div class="scenario-stage">
          {scenarioQuestions.map((question,index)=>(
            <div class="scenario-step" data-scenario-step={index} hidden={index!==0}>
              <div class="question-header"><span class="question-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h3 tabindex="-1" data-scenario-heading>{question.title}</h3></div>
              {question.groups.map(group=>(
                <fieldset><legend class="sr-only">{group.label}</legend>
                  <div class="scenario-options">
                    {group.options.map(([value,label],i)=>(
                      <label><input type="radio" name={group.name} value={value} required aria-describedby="scenario-hint scenario-keyboard-hint scenario-error"/><span class:list={['option-marker', {'option-scene':index===0}]} aria-hidden="true">{index===0 ? <TaskIcon kind={value} /> : String(i+1).padStart(2,'0')}</span><span>{label}</span></label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>
          ))}
        </div>
        <p class="scenario-status" id="scenario-error" data-scenario-error role="status"></p>
        <div class="scenario-actions"><button type="button" class="text-button" data-scenario-back disabled>← 上一题</button><span id="scenario-hint" data-scenario-hint>点选即进入下一题</span></div>
        <p class="sr-only" id="scenario-keyboard-hint">键盘操作：方向键选择，按回车或空格确认并继续。</p>
      </form>
      <div class="scenario-result" data-scenario-result hidden>
        <span class="scenario-eyebrow">建议起点</span>
        <h3 tabindex="-1" data-scenario-title></h3>
        <div class="scenario-next"><span>第一步</span><p data-scenario-next-action></p></div>
        <template data-flow-glyph="0"><DeliveryGlyph kind="input" /></template>
        <template data-flow-glyph="1"><DeliveryGlyph kind="ai" /></template>
        <template data-flow-glyph="2"><DeliveryGlyph kind="check" /></template>
        <ol class="scenario-flow" aria-label="可以尝试的协作方式" data-scenario-flow></ol>
        <div class="scenario-result-actions"><a href="#contact" class="btn btn-primary">聊聊这个场景</a><button type="button" class="text-button" data-copy-assessment>复制结果</button></div>
        <p class="scenario-status copy-status" data-assessment-copy-status role="status"></p>
        <textarea data-assessment-copy-fallback hidden readonly aria-label="自测结果，可选中复制" rows="6"></textarea>
        <details class="scenario-details"><summary>查看判断依据</summary><div class="scenario-signals" data-scenario-signals></div><p data-scenario-reason></p><p><strong>由你确认：</strong><span data-scenario-human></span></p><div class="scenario-related" data-scenario-related><span>参考案例</span>{featuredCases.map(item=><a href={'#case-'+item.id} data-scenario-case={item.id} data-case-detail-trigger={item.id} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false" hidden>{item.title} →</a>)}</div><dl data-scenario-answers></dl></details>
        <div class="scenario-edit"><button type="button" class="text-button" data-scenario-edit>修改回答</button><button type="button" class="text-button" data-scenario-reset>重新开始</button><span>仅作起点参考，需实际试做。</span></div>
      </div>
      <noscript><p>从重复、耗时、结果能核对的工作开始，例如报表汇总或资料整理。</p><a href="#contact" class="btn btn-primary">聊聊你的场景</a></noscript>
    </div>
  </div>
</section>

<style>
  [hidden] { display: none !important; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .scenario-card { max-width:820px; margin:auto; padding:32px 40px; border:1px solid rgba(201,165,92,.28); border-radius:16px; background:linear-gradient(125deg,rgba(201,165,92,.055),transparent 48%),#131312; box-shadow:0 24px 80px #0004; scroll-margin-top:92px; }
  .scenario-topline { display:flex; justify-content:space-between; gap:12px; color:var(--text-muted); font-size:12px; }
  .scenario-topline > span:first-child { font-family:var(--font-mono); color:var(--accent); font-variant-numeric:tabular-nums; }
  .scenario-steps { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin:20px 0 32px; }
  .scenario-steps button { font:inherit; font-size:12px; text-align:left; color:var(--text-muted); background:none; border:0; border-top:2px solid var(--border-light); padding:10px 0; min-height:44px; cursor:pointer; transition:border-color .22s,color .22s; }
  .scenario-steps button span { margin-right:8px; font-family:var(--font-mono); font-size:10px; opacity:.65; }
  .scenario-steps button[aria-current] { border-color:var(--accent); color:var(--accent-hover); }
  .scenario-steps button[data-complete] { border-color:#685631; color:var(--text-secondary); }
  .scenario-steps button:disabled { cursor:default; opacity:.5; }
  .scenario-stage { min-height:238px; }
  h3 { font-size:26px; line-height:1.45; letter-spacing:-.025em; margin-bottom:24px; }
  h3:focus { outline:none; }
  fieldset { border:0; min-width:0; }
  .scenario-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .scenario-options label { position:relative; display:flex; align-items:center; gap:12px; min-height:58px; padding:12px 16px; border:1px solid var(--border-light); border-radius:8px; background:#ffffff02; cursor:pointer; font-size:14px; color:var(--text-secondary); transition:background .18s,border-color .18s,color .18s; }
  .scenario-options input { position:absolute; width:1px; height:1px; opacity:0; }
  .option-marker { font-family:var(--font-mono); font-size:10px; color:var(--text-muted); border:1px solid var(--border-light); border-radius:50%; width:24px; height:24px; display:grid; place-items:center; flex-shrink:0; }
  .scenario-options label:has(:checked) { border-color:var(--accent); background:var(--accent-subtle); color:var(--text-primary); }
  .scenario-options label:has(:checked) .option-marker { background:var(--accent); color:var(--bg); border-color:var(--accent); }
  /* JS fallback for browsers without :has() support. */
  .scenario-options label.is-checked { border-color:var(--accent); background:var(--accent-subtle); color:var(--text-primary); }
  .scenario-options label.is-checked .option-marker { background:var(--accent); color:var(--bg); border-color:var(--accent); }
  .scenario-options label:has(:focus-visible) { outline:2px solid var(--accent); outline-offset:3px; }
  .scenario-status { color:var(--accent); font-size:12px; min-height:20px; margin-top:10px; }
  .scenario-actions { display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .scenario-actions > span { color:var(--text-muted); font-size:12px; }
  .text-button { padding:10px 0; min-height:44px; border:0; background:none; color:var(--text-secondary); font:inherit; font-size:13px; cursor:pointer; }
  .text-button:hover { color:var(--accent-hover); }
  .text-button:disabled { opacity:.35; cursor:default; }
  .scenario-eyebrow { display:block; font-size:12px; color:var(--accent); margin-bottom:12px; }
  .scenario-result h3 { font-size:clamp(24px,3.5vw,34px); line-height:1.4; margin-bottom:14px; max-width:24ch; }
  .scenario-signals { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
  .scenario-signals:empty { display:none; }
  .scenario-signals :global(span) { padding:4px 10px; border:1px solid var(--border-light); border-radius:4px; font-size:12px; color:var(--text-secondary); }
  .scenario-signals :global([data-state="attention"]) { border-color:#6e582b; color:var(--accent-hover); }
  .scenario-flow { list-style:none; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin:24px 0 28px; padding:20px 0; border-block:1px solid var(--border); }
  .scenario-flow :global(li) { position:relative; padding:0 8px; font-size:14px; line-height:1.7; }
  .scenario-flow :global(li:not(:last-child)::after) { content:'→'; position:absolute; right:-14px; top:50%; color:var(--text-muted); }
  .scenario-flow :global(small) { display:block; color:var(--text-muted); font-size:12px; margin-bottom:8px; }
  .scenario-flow :global(li:nth-child(2)) { color:var(--accent-hover); }
  .scenario-flow :global(li:nth-child(2) small) { color:var(--accent); }
  .scenario-next { display:flex; gap:12px; font-size:14px; line-height:1.8; color:var(--text-secondary); }
  .scenario-next > span { color:var(--accent); flex-shrink:0; font-size:12px; padding-top:2px; }
  .scenario-details { font-size:12px; color:var(--text-secondary); margin-top:20px; }
  .scenario-details[open] { padding-bottom:12px; }
  summary { cursor:pointer; padding:10px 0; min-height:44px; }
  .scenario-details p { color:var(--text-secondary); line-height:1.8; margin-bottom:8px; }
  .scenario-details :global(dl) { display:grid; grid-template-columns:90px 1fr; gap:6px 12px; border-top:1px solid var(--border); padding-top:12px; }
  .scenario-related { display:flex; flex-wrap:wrap; align-items:center; gap:6px 14px; font-size:12px; margin-bottom:12px; }
  .scenario-related > span { color:var(--text-muted); }
  .scenario-related a { padding:8px 0; }
  .scenario-result-actions { display:flex; align-items:center; gap:24px; }
  .copy-status:empty { display:none; }
  .scenario-edit { margin-top:4px; padding-top:6px; border-top:1px solid var(--border); display:flex; align-items:center; flex-wrap:wrap; gap:0 20px; }
  .scenario-edit > span { margin-left:auto; font-size:12px; color:var(--text-muted); }
  textarea { width:100%; padding:12px; color:var(--text-primary); background:var(--bg); border:1px solid var(--border-light); border-radius:6px; font:inherit; font-size:13px; }
  @media (hover:hover) and (pointer:fine) { .scenario-options label:hover { border-color:#8a713f; background:#c9a55c08; } }
  @media (max-width:640px) {
    .scenario-card { padding:22px 20px; border-radius:12px; }
    .scenario-topline { font-size:12px; }
    .scenario-steps { gap:10px; margin:16px 0 24px; }
    .scenario-steps button { font-size:12px; text-align:center; }
    .scenario-steps button span { display:none; }
    h3 { font-size:21px; margin-bottom:20px; }
    .scenario-stage { min-height:252px; }
    .scenario-options { gap:8px; }
    .scenario-options label { min-height:64px; padding:10px; gap:8px; font-size:13px; line-height:1.6; }
    .scenario-step:not([data-scenario-step="0"]) .scenario-options { grid-template-columns:1fr; }
    .scenario-step:not([data-scenario-step="0"]) .scenario-options label { min-height:48px; }
    .option-marker { width:22px; height:22px; }
    .scenario-signals { gap:6px; margin-bottom:20px; }
    .scenario-signals :global(span) { font-size:12px; padding:3px 6px; }
    .scenario-flow { gap:14px; margin:20px 0; padding:16px 0; }
    .scenario-flow :global(li) { padding:0; font-size:14px; }
    .scenario-flow :global(li:not(:last-child)::after) { right:-12px; }
    .scenario-next { flex-direction:column; gap:4px; }
    .scenario-result-actions { gap:20px; }
    .scenario-result-actions .btn { flex:1; padding-inline:16px; }
    .scenario-edit > span { width:100%; margin-left:0; }
    .scenario-details { margin-top:14px; }
  }
  @media (max-width:380px) {
    .scenario-flow { grid-template-columns:1fr; gap:14px; }
    .scenario-flow :global(li) { display:grid; grid-template-columns:64px minmax(0,1fr); align-items:baseline; gap:12px; }
    .scenario-flow :global(small) { margin-bottom:0; }
    .scenario-flow :global(li:not(:last-child)::after) { content:none; }
  }

  .scenario-flow { gap:18px; border:0; padding:0; }
  .scenario-flow :global(li) { position:relative; display:flex; flex-direction:column; justify-content:flex-end; min-height:210px; border:1px solid #c9a55c26; border-radius:10px; background:radial-gradient(ellipse at 50% 20%,#c9a55c13,transparent 75%),#191917; padding:0; }
  .scenario-flow :global(.flow-illustration) { width:100px; margin:0 auto; }
  .scenario-flow :global(.flow-caption) { padding:6px 16px 18px; }
  .scenario-flow :global(small) { font-size:14px; color:#b8b3a8; margin-bottom:7px; }
  .scenario-flow :global(strong) { display:block; color:#e7e2d7; font-size:16px; line-height:1.6; font-weight:500; }
  .scenario-flow :global(li:nth-child(2)) { background:radial-gradient(ellipse at 50% 20%,#c9a55c20,transparent 75%),#222018; border-color:#c9a55c66; }
  .scenario-flow :global(li:nth-child(2) strong) { color:#ead7a5; }
  .scenario-flow :global(li:not(:last-child)::after) { right:-17px; top:50%; }
  @media(max-width:600px) {
    .scenario-flow { grid-template-columns:1fr; gap:12px; }
    .scenario-flow :global(li) { display:grid; grid-template-columns:76px minmax(0,1fr); align-items:center; min-height:108px; gap:4px; }
    .scenario-flow :global(.flow-illustration) { width:76px; }
    .scenario-flow :global(.flow-caption) { padding:16px 14px 16px 0; }
    .scenario-flow :global(small) { margin-bottom:5px; }
    .scenario-flow :global(li:not(:last-child)::after) { content:none; }
  }


  .scenario-card { max-width:960px;background:radial-gradient(ellipse at top right,#c9a55c0d,transparent 55%),#141413; }
  .question-header { display:flex;gap:18px;align-items:center;margin-bottom:24px; }.question-header h3 { margin:0; }
  .question-number { font-size:48px;font-weight:300;line-height:1;color:#c9a55c66;font-family:var(--font-mono); }
  .scenario-step[data-scenario-step="0"] .scenario-options { grid-template-columns:repeat(3,minmax(0,1fr));gap:14px; }
  .scenario-step[data-scenario-step="0"] .scenario-options label { flex-direction:column;align-items:flex-start;gap:18px;padding:22px;min-height:140px;background:linear-gradient(140deg,#c9a55c09,transparent),#191917;font-size:16px;border-radius:12px; }
  .option-scene { width:44px;height:44px;border:0;background:none !important; }
  .scenario-step:not([data-scenario-step="0"]) .scenario-options label { padding:20px;min-height:80px;font-size:16px; }
  .scenario-options label:has(:checked) { box-shadow:inset 0 0 0 1px #c9a55c70; }
  .scenario-topline,.scenario-actions > span,.scenario-details { font-size:14px; }
  @media(max-width:640px) {
   .scenario-card { padding:22px 18px; }.question-header { gap:12px; }.question-number { font-size:36px; }
   .scenario-topline { font-size:12px; }.scenario-actions > span { font-size:13px; }
   .scenario-step[data-scenario-step="0"] .scenario-options { grid-template-columns:repeat(2,minmax(0,1fr));gap:10px; }
   .scenario-step[data-scenario-step="0"] .scenario-options label { padding:16px;gap:10px;min-height:118px;font-size:15px; }
   .scenario-step:not([data-scenario-step="0"]) .scenario-options label { padding:16px;min-height:64px;font-size:15px; }
  }
</style>

<script>
  import { resultFlowLabels } from '../data/visual-copy';
  import { scenarioQuestions, assessScenario, scenarioSummary, type ScenarioAnswers } from '../data/scenario-check';
  const form = document.querySelector<HTMLFormElement>('[data-scenario-form]');
  const panel = document.querySelector<HTMLElement>('[data-scenario-result]');
  if (form && panel) {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-scenario-step]'));
    const jumps = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-scenario-jump]'));
    const back = form.querySelector<HTMLButtonElement>('[data-scenario-back]')!;
    const hint = form.querySelector<HTMLElement>('[data-scenario-hint]')!;
    const error = form.querySelector<HTMLElement>('[data-scenario-error]')!;
    const card = document.querySelector<HTMLElement>('[data-scenario-card]')!;
    const contact = document.querySelector<HTMLElement>('[data-assessment-contact]');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let current=0, reached=0, summary='';
    let entryAnimation: Animation | undefined;
    let advanceTimer: ReturnType<typeof setTimeout> | undefined;
    let acceptAfter=0;
    const cancelAdvance=()=>{
      clearTimeout(advanceTimer);advanceTimer=undefined;
      form.removeAttribute('aria-busy');
    };
    const answers=():ScenarioAnswers=>Object.fromEntries(new FormData(form).entries()) as ScenarioAnswers;
    const clearCopy=()=>document.querySelectorAll<HTMLElement>('[data-assessment-copy-status], [data-assessment-copy-fallback]').forEach(el=>{
      if(el instanceof HTMLTextAreaElement) {el.hidden=true;el.value='';} else el.textContent='';
    });
    const present=(el:HTMLElement, focus=true)=>{
      entryAnimation?.cancel();
      if(!focus) return;
      el.querySelector<HTMLElement>('h3')?.focus({preventScroll:true});
      const bounds=card.getBoundingClientRect();
      if(bounds.top<80 || bounds.top>innerHeight*.25) card.scrollIntoView({behavior:'instant',block:'start'});
      if(!motion.matches) entryAnimation=el.animate([{opacity:0,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:240,easing:'cubic-bezier(.2,.7,.2,1)'});
    };
    const show=(index:number,focus=true)=>{
      cancelAdvance();
      current=index;reached=Math.max(reached,index);
      steps.forEach((step,i)=>step.hidden=i!==index);
      form.hidden=false;panel.hidden=true;
      if(contact) contact.hidden=true;
      summary='';clearCopy();error.textContent='';
      back.disabled=index===0;
      hint.textContent=index===steps.length-1?'点选即查看建议':'点选即进入下一题';
      form.querySelector<HTMLElement>('[data-scenario-progress]')!.textContent=String(index+1).padStart(2,'0')+' / 04';
      jumps.forEach((button,i)=>{
        button.disabled=i>reached;
        button.toggleAttribute('data-complete',i<index);
        if(i===index)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current');
      });
      present(steps[index],focus);
    };
    const setText=(key:string,text:string)=>panel.querySelector<HTMLElement>('[data-scenario-'+key+']')!.textContent=text;
    const advance=()=>{
      const selected=answers();
      const missing=scenarioQuestions[current].groups.find(g=>!selected[g.name]);
      if(missing) {error.textContent='选一个最接近的情况即可。';form.querySelector<HTMLInputElement>('[name="'+missing.name+'"]')?.focus();return;}
      if(current<steps.length-1 && selected.task!=='unsure'){show(current+1);return;}
      if(selected.task==='unsure') Object.keys(selected).forEach(key=>{if(key!=='task')delete selected[key];});
      const result=assessScenario(selected);
      if(!result){show(0);return;}
      form.hidden=true;panel.hidden=false;panel.dataset.resultKind=result.kind;
      setText('title',result.title);setText('next-action',result.next);setText('reason',result.reason);setText('human',result.human);
      const signals=panel.querySelector('[data-scenario-signals]')!;signals.replaceChildren();
      result.signals.forEach(signal=>{const el=document.createElement('span');el.textContent=signal.label+' · '+signal.value;el.dataset.state=signal.state;signals.append(el);});
      const flow=panel.querySelector('[data-scenario-flow]')!;flow.replaceChildren();
      result.flow.forEach((text,i)=>{
        const li=document.createElement('li');
        const glyph=panel.querySelector<HTMLTemplateElement>(`[data-flow-glyph="${i}"]`)!;
        const illustration=document.createElement('div');illustration.className='flow-illustration';illustration.append(glyph.content.cloneNode(true));
        const caption=document.createElement('div');caption.className='flow-caption';
        const label=document.createElement('small');label.textContent=resultFlowLabels[i];
        const value=document.createElement('strong');value.textContent=text;
        caption.append(label,value);li.append(illustration,caption);flow.append(li);
      });
      // When no concrete task is chosen, use preparation labels rather than implying AI has been assessed.
      if(result.kind==='explore') flow.querySelectorAll('small').forEach((el,i)=>el.textContent=['第一步','第二步','第三步'][i]);
      panel.querySelectorAll<HTMLElement>('[data-scenario-case]').forEach(link=>link.hidden=!result.caseIds.includes(link.dataset.scenarioCase||''));
      panel.querySelector<HTMLElement>('[data-scenario-related]')!.hidden=!result.caseIds.length;
      const list=panel.querySelector('[data-scenario-answers]')!;list.replaceChildren();
      scenarioQuestions.forEach(q=>q.groups.forEach(g=>{if(selected[g.name]===undefined)return;const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=g.label;dd.textContent=g.options.find(([v])=>v===selected[g.name])?.[1]||'';list.append(dt,dd);}));
      panel.querySelector<HTMLDetailsElement>('details')!.open=false;
      clearCopy();summary=scenarioSummary(selected,result);
      if(contact){contact.hidden=false;contact.querySelector<HTMLElement>('[data-assessment-contact-title]')!.textContent=result.title;}
      present(panel);
    };
    const queueAdvance=()=>{
      if(advanceTimer!==undefined || performance.now()<acceptAfter || form.hidden)return;
      form.setAttribute('aria-busy','true');
      // Keep the selected state visible briefly, then protect the next question from the same double tap.
      advanceTimer=setTimeout(()=>{
        cancelAdvance();acceptAfter=performance.now()+240;advance();
      },180);
    };
    form.addEventListener('submit',event=>{event.preventDefault();queueAdvance();});
    form.addEventListener('click',event=>{
      const input=event.target;
      if(!(input instanceof HTMLInputElement) || input.type!=='radio')return;
      if(!steps[current].contains(input) || advanceTimer!==undefined || performance.now()<acceptAfter || event.detail>1){event.preventDefault();return;}
      queueAdvance();
    });
    const syncChecked=()=>form.querySelectorAll('.scenario-options label').forEach(label=>label.classList.toggle('is-checked',!!label.querySelector('input:checked')));
    form.addEventListener('keydown',event=>{
      const input=event.target;
      if(!(input instanceof HTMLInputElement) || input.type!=='radio')return;
      const direction=['ArrowRight','ArrowDown'].includes(event.key)?1:['ArrowLeft','ArrowUp'].includes(event.key)?-1:0;
      if(!direction && event.key!=='Enter' && event.key!==' ')return;
      event.preventDefault();
      if(advanceTimer!==undefined || performance.now()<acceptAfter || event.repeat)return;
      if(direction){
        // Arrow keys explore this radio group; only explicit activation changes the question.
        const options=Array.from(steps[current].querySelectorAll<HTMLInputElement>('input[type="radio"]')).filter(el=>el.name===input.name);
        const target=options[(options.indexOf(input)+direction+options.length)%options.length];
        target.checked=true;syncChecked();target.focus();error.textContent='';
      }else{input.checked=true;syncChecked();queueAdvance();}
    });
    form.addEventListener('change',()=>{error.textContent='';syncChecked();});
    back.addEventListener('click',()=>{if(current>0)show(current-1);});
    jumps.forEach((button,i)=>button.addEventListener('click',()=>{if(i<=reached)show(i);}));
    document.querySelector('[data-scenario-edit]')?.addEventListener('click',()=>show(0));
    document.querySelector('[data-scenario-reset]')?.addEventListener('click',()=>{form.reset();reached=0;syncChecked();show(0);});
    document.querySelectorAll<HTMLButtonElement>('[data-copy-assessment]').forEach(button=>button.addEventListener('click',async()=>{
      if(!summary)return;
      const scope=button.closest<HTMLElement>('[data-assessment-contact], [data-scenario-result]')!;
      const status=scope.querySelector<HTMLElement>('[data-assessment-copy-status]')!;
      const fallback=scope.querySelector<HTMLTextAreaElement>('[data-assessment-copy-fallback]')!;
      try{await navigator.clipboard.writeText(summary);status.textContent='已复制，可粘贴到微信。';fallback.hidden=true;}
      catch{fallback.value=summary;fallback.hidden=false;fallback.focus();fallback.select();status.textContent='请选中下方文字手动复制。';}
    }));
    motion.addEventListener('change',()=>{if(motion.matches)entryAnimation?.cancel();});
    syncChecked();
    show(0,false);
  }
</script>

