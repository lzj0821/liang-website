---
import { Image, getImage } from 'astro:assets';
import xiaoyin from '../assets/service-examples/xiaoyin-case.png';
import xiaoyan from '../assets/service-examples/xiaoyan-case.png';
import inputScript from '../content/service-examples/xiaoyin/input-script.txt?raw';
import rawTranscript from '../content/service-examples/xiaoyin/raw-transcript.txt?raw';
import proofreadTranscript from '../content/service-examples/xiaoyin/proofread-transcript.txt?raw';
import { compiledContent as organizedOutput } from '../content/service-examples/xiaoyin/organized-output.md';
import { compiledContent as reportBefore } from '../content/service-examples/xiaoyan/report-before.md';
import { compiledContent as reportAfter } from '../content/service-examples/xiaoyan/report-after.md';
// These local Markdown documents share headings. Scope their anchors and keep
// report headings below the dialog's h2 instead of adding page-level h1s.
const scopeReport = (html: string, prefix: string) => html
  .replace(/\bid="([^"]+)"/g, (_, id) => `id="${prefix}-${id}"`)
  .replace(/href="#([^"]+)"/g, (_, id) => `href="#${prefix}-${id}"`)
  .replace(/<(\/?)h([1-3])\b/g, (_, close, level) => `<${close}h${Number(level) + 2}`);
const [organizedHtml, beforeHtml, afterHtml] = await Promise.all([
  organizedOutput().then(html => scopeReport(html, 'yin-output')),
  reportBefore().then(html => scopeReport(html, 'yan-before')),
  reportAfter().then(html => scopeReport(html, 'yan-after')),
]);
const [yinFull, yanFull] = await Promise.all([
  getImage({ src: xiaoyin, width: 1672, format: 'webp' }),
  getImage({ src: xiaoyan, width: 1672, format: 'webp' }),
]);
---
<button class="examples-trigger" type="button" data-agent-open aria-haspopup="dialog" aria-controls="agentExamples">
  <span class="sample-previews" aria-hidden="true"><Image src={xiaoyin} alt="" width={220} loading="lazy" /><Image src={xiaoyan} alt="" width={220} loading="lazy" /></span>
  <span class="sample-copy"><span class="example-label">智能体使用样例 · 个人自用</span><strong>录音变清单，资料变报告</strong><span>点开看处理前后的内容，了解实际怎么用。</span><em>查看两个样例 ↗</em></span>
</button>
<dialog id="agentExamples" class="agent-dialog" aria-labelledby="agentExamplesTitle">
  <div class="agent-toolbar">
    <div><span class="example-label">个人自用项目</span><h2 id="agentExamplesTitle">智能体交付样例</h2></div>
    <button type="button" class="agent-close" data-agent-close aria-label="关闭智能体样例" autofocus>×</button>
  </div>
  <div role="tablist" aria-label="选择智能体样例" class="agent-tabs">
    <button type="button" role="tab" id="agent-tab-yin" aria-controls="agent-panel-yin" aria-selected="true" data-agent-tab="yin">小音 · 音视频整理</button>
    <button type="button" role="tab" id="agent-tab-yan" aria-controls="agent-panel-yan" aria-selected="false" tabindex="-1" data-agent-tab="yan">小研 · 资料调研</button>
  </div>
  <section role="tabpanel" id="agent-panel-yin" aria-labelledby="agent-tab-yin" data-agent-panel="yin" tabindex="0">
    <h3>录音变成行动清单</h3>
    <div class="agent-outcome" aria-label="小音输入与输出"><div><span>输入</span><strong>工作安排录音</strong></div><i aria-hidden="true">→</i><div><span>输出</span><strong>任务清单与待确认事项</strong></div></div>
    <figure>
      <a class="image-preview" href={yinFull.src} data-image-open data-image-caption="小音 · 录音整理示意" aria-label="放大小音案例展示图" aria-haspopup="dialog" aria-controls="imageLightbox">
        <Image src={xiaoyin} alt="小音案例示意：46 秒合成录音，经真实转写和两处校对，整理为工作安排与待确认事项" width={760} loading="lazy" />
      </a>
      <figcaption>录音整理示意</figcaption>
    </figure>
    <details class="evidence-detail">
      <summary>查看输入、原始转写与校对</summary>
      <p class="evidence-note">合成录音 → 转写与校对 → 任务整理</p>
      <h4>输入原稿</h4><p class="transcript">{inputScript}</p>
      <h4>原始转写 · 保留错误</h4><p class="transcript">{rawTranscript}</p>
      <p class="corrections">校对：“摆底图” → “白底图”；“标程待确认” → “标成待确认”。</p>
      <h4>校对后全文</h4><p class="transcript">{proofreadTranscript}</p>
    </details>
    <details class="evidence-detail"><summary>查看整理后的结果</summary><div class="evidence-prose" set:html={organizedHtml} /></details>
  </section>
  <section role="tabpanel" id="agent-panel-yan" aria-labelledby="agent-tab-yan" data-agent-panel="yan" tabindex="0" hidden>
    <h3>有来源的报告，可以继续追问</h3>
    <p class="agent-intro">查找公开资料，整理依据与结论；收到追加要求后，继续修改同一份报告。</p>
    <figure>
      <a class="image-preview" href={yanFull.src} data-image-open data-image-caption="小研 · 报告修改示意" aria-label="放大小研报告修改对照图" aria-haspopup="dialog" aria-controls="imageLightbox">
        <Image src={xiaoyan} alt="小研历史报告对照：版本 3 到版本 4，保留原内容与引用，仅增加一段虚构演练记录；5 份官方原文、6 条证据" width={760} loading="lazy" />
      </a>
      <figcaption>报告修改示意</figcaption>
    </figure>
    <dl class="revision-overview">
      <div><dt>问题</dt><dd>Google 与 GitHub 用了通行密钥，还要留恢复码吗？</dd></div>
      <div><dt>追问概述</dt><dd>追加一段虚构演练示例，保留原文与引用。</dd></div>
      <div><dt>修改结果</dt><dd>版本 3 → 4；原有 22 个顶层内容块保留，仅新增 1 段。</dd></div>
    </dl>
    <details class="evidence-detail">
      <summary>查看追问新增的段落</summary>
      <p class="evidence-note">5 份官方原文 · 6 条证据 · 新增一段虚构演练示例</p>
      <p class="transcript">小演练记录（虚构示例，非实际测试）：日期：2026-10-14；测试账号（脱敏）：Google个人账号A；备用方式：密码＋纸质备用码；验证结果：不使用主手机成功登录，已标记用过的码并退出测试会话；发现的问题：纸质备份不易找到，需调整存放位置。记录不含密码或恢复码明文。某一种备用方式演练成功，不代表所有账号都已验证；应按“账号＋备用方式”分别记录。</p>
    </details>
    <details class="evidence-detail"><summary>阅读修改前报告 · 版本 3</summary><div class="evidence-prose" set:html={beforeHtml} /></details>
    <details class="evidence-detail"><summary>阅读修改后报告 · 版本 4</summary><div class="evidence-prose" set:html={afterHtml} /></details>
  </section>
  <a class="btn btn-primary agent-contact" href="#contact" data-agent-contact data-inquiry-type="individual" data-inquiry-source="录音整理与资料调研">聊聊我的重复工作</a>
</dialog>

<style>
  .agent-outcome { display:grid; grid-template-columns:minmax(0,.85fr) 16px minmax(0,1.15fr); gap:10px; margin:16px 0 20px; align-items:center; }
  .agent-outcome > div { min-width:0; padding:12px; border:1px solid var(--border); border-radius:8px; }
  .agent-outcome > div:last-child { background:var(--accent-subtle); border-color:#c9a55c30; }
  .agent-outcome span { display:block; color:var(--text-muted); font-size:12px; margin-bottom:6px; }
  .agent-outcome strong { color:var(--text-primary); font-size:14px; font-weight:500; line-height:1.7; }
  .agent-outcome i { color:var(--accent); font-style:normal; }
  @media (max-width:380px) { .agent-outcome { grid-template-columns:1fr; gap:8px; } .agent-outcome > div { display:grid; grid-template-columns:32px minmax(0,1fr); align-items:baseline; gap:8px; } .agent-outcome span { margin:0; } .agent-outcome i { display:none; } }

  [hidden] { display:none !important; }
  .examples-trigger { display:grid; grid-template-columns:220px minmax(0,1fr);align-items:center;gap:24px;width:100%;margin-top:20px;padding:20px;background:#10110f;border:1px solid var(--border);border-radius:10px;color:var(--text-primary);font:inherit;cursor:pointer;text-align:left; }
  .examples-trigger:hover { border-color:var(--accent); }
  .sample-previews { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
  .sample-previews img { display:block;width:100%;height:112px;object-fit:cover;object-position:top;border-radius:6px; }
  .sample-copy { display:grid;gap:8px; }.sample-copy strong { font-size:19px;font-weight:500; }.sample-copy > span:not(.example-label) { color:var(--text-secondary);font-size:14px;line-height:1.8; }.sample-copy em { color:var(--accent);font-size:13px;font-style:normal; }
  @media(max-width:640px) { .examples-trigger { grid-template-columns:1fr;gap:18px;padding:18px; }.sample-previews img { height:120px; }.sample-copy strong { font-size:18px; } }
  .example-label { color:var(--text-muted); font-size:12px; }
  .agent-dialog { width:min(760px,calc(100% - 32px)); max-height:calc(100dvh - 32px); margin:auto; padding:28px; border:1px solid var(--border-light); border-radius:14px; background:var(--bg-surface); color:var(--text-primary); overscroll-behavior:contain; }
  .agent-dialog::backdrop { background:#000c; }
  :global(html.agent-example-open), :global(body.agent-example-open) { overflow:hidden; }
  .agent-toolbar { position:sticky; top:-28px; z-index:2; display:flex; justify-content:space-between; align-items:flex-start; gap:14px; padding-block:8px 12px; background:var(--bg-surface); }
  .agent-toolbar h2 { font-size:22px; margin-top:6px; }
  .agent-close { flex:0 0 48px; width:48px; height:48px; border:1px solid var(--border-light); border-radius:8px; background:var(--bg-card); color:var(--text-primary); font-size:28px; cursor:pointer; }
  .agent-tabs { display:grid; grid-template-columns:1fr 1fr; margin:24px 0; border-bottom:1px solid var(--border-light); }
  .agent-tabs button { min-height:48px; padding:8px; border:0; border-bottom:2px solid transparent; background:none; color:var(--text-secondary); font:inherit; font-size:14px; cursor:pointer; }
  .agent-tabs button[aria-selected="true"] { color:var(--accent-hover); border-bottom-color:var(--accent); }
  h3 { font-size:22px; line-height:1.5; margin-bottom:8px; }
  .agent-intro { font-size:14px; line-height:1.8; color:var(--text-secondary); margin-bottom:20px; }
  figure { margin:0; }
  figure img { width:100%; border-radius:8px; }
  figcaption { font-size:12px; line-height:1.7; color:var(--text-muted); margin-top:8px; }
  .evidence-note { margin:14px 0; color:var(--text-secondary); font-size:14px; line-height:1.8; }
  .evidence-detail { border-top:1px solid var(--border); }
  .evidence-detail summary { min-height:48px; padding:13px 0; cursor:pointer; color:var(--accent); font-size:13px; }
  .evidence-detail[open] { padding-bottom:16px; }
  h4 { font-size:14px; margin:16px 0 8px; }
  .transcript { white-space:pre-line; overflow-wrap:anywhere; color:var(--text-secondary); font-size:14px; line-height:1.9; }
  .corrections { border-left:2px solid var(--accent); padding:8px 12px; margin:16px 0; color:var(--accent-hover); font-size:13px; }
  .revision-overview { display:grid; gap:12px; margin-top:20px; }
  .revision-overview > div { display:grid; grid-template-columns:70px minmax(0,1fr); gap:10px; font-size:14px; line-height:1.8; }
  dt { color:var(--accent); } dd { color:var(--text-secondary); }
  .evidence-prose { overflow-x:auto; overflow-wrap:anywhere; font-size:14px; line-height:1.9; color:var(--text-secondary); }
  .evidence-prose :global(h3) { font-size:21px; color:var(--text-primary); margin:18px 0; }
  .evidence-prose :global(h4) { font-size:18px; color:var(--text-primary); margin:24px 0 12px; }
  .evidence-prose :global(h5) { font-size:16px; color:var(--text-primary); margin:20px 0 10px; }
  .evidence-prose :global(p), .evidence-prose :global(ul) { margin:12px 0; }
  .evidence-prose :global(ul) { padding-left:20px; }
  .evidence-prose :global(blockquote) { border-left:2px solid var(--accent); padding-left:12px; font-size:12px; }
  .evidence-prose :global(table) { width:100%; border-collapse:collapse; font-size:13px; }
  .evidence-prose :global(th), .evidence-prose :global(td) { border:1px solid var(--border-light); padding:8px; text-align:left; min-width:80px; }
  .evidence-prose :global(a) { text-decoration:underline; text-underline-offset:3px; }
  .agent-contact { display:flex; margin-top:22px; }
  @media (max-width:640px) {
    .agent-dialog { width:calc(100% - 16px); max-height:calc(100dvh - 16px); padding:20px 16px; border-radius:10px; }
    .agent-toolbar { top:-20px; }
    .agent-toolbar h2 { font-size:19px; }
    .agent-tabs button { font-size:12px; padding-inline:2px; }
    h3 { font-size:20px; }
    .revision-overview > div { grid-template-columns:1fr; gap:2px; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#agentExamples');
  const trigger = document.querySelector<HTMLButtonElement>('[data-agent-open]');
  if (dialog && trigger) {
    const tabs = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-agent-tab]'));

    const select = (id: string, focus = false) => {
      tabs.forEach(tab => {
        const active = tab.dataset.agentTab === id;
        tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      dialog.querySelectorAll<HTMLElement>('[data-agent-panel]').forEach(panel => panel.hidden = panel.dataset.agentPanel !== id);
    };
    trigger.addEventListener('click', () => {
      select('yin'); dialog.showModal(); dialog.scrollTop = 0;
      document.documentElement.classList.add('agent-example-open');
      document.body.classList.add('agent-example-open');
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.agentTab!));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault(); select(tabs[next].dataset.agentTab!, true);
      });
    });
    dialog.querySelector('[data-agent-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-agent-contact]')?.addEventListener('click', () => {
      dialog.close();
      // Unlock before the anchor is followed; the dialog close event is asynchronous.
      document.documentElement.classList.remove('agent-example-open');
      document.body.classList.remove('agent-example-open');
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('agent-example-open');
      document.body.classList.remove('agent-example-open');
    });
  }
</script>
