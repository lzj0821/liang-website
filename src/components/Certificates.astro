---
import { Image, getImage } from 'astro:assets';
import certGeminiEducator from '../assets/certs/Gemini教育者认证.png';
import certGeminiTeacher from '../assets/certs/Gemini教师认证.png';
import certGeminiStudent from '../assets/certs/Gemini Certified University Student认证.png';
import certUNESCO from '../assets/certs/联合国科教文组织OER证书.png';
import certAITrainer from '../assets/refresh/ai-trainer-cn-private.png';
import certAIJustice from '../assets/certs/人工智能、司法与法治认证.png';
import certAIEngineer from '../assets/refresh/ai-engineer-query-cropped.png';
import engineerCover from '../assets/evidence-20261026/engineer-cover.jpg';
const primary = await Promise.all([
  { image:certAIEngineer, name:'人工智能应用工程师（高级）', org:'工业和信息化部教育与考试中心', meta:'职业技术证书 · 查询记录' },
  { image:certAITrainer, name:'人工智能训练师（高级）', org:'阿里云 · 达摩院', meta:'2026.05.21 — 2027.05.21' },
].map(async item=>({...item,full:await getImage({src:item.image,width:1200,format:'webp'})})));
const secondary = await Promise.all([
  { image:certAIJustice, name:'人工智能、司法与法治结业证书', org:'牛津大学 · UNESCO', meta:'2026.05.31' },
  { image:certGeminiTeacher, name:'Gemini 教职人员认证', org:'Google for Education', meta:'2026.05.21 — 2029.05.21' },
  { image:certGeminiStudent, name:'Gemini 大学生认证', org:'Google for Education', meta:'2026.05.21 — 2029.05.21' },
  { image:certUNESCO, name:'开放教育资源开发结业证书', org:'联合国教科文组织', meta:'2026.05.21' },
  { image:certGeminiEducator, name:'Gemini 教育者认证', org:'Google for Education', meta:'2026.06.05 — 2029.06.05' },
].map(async item=>({...item,full:await getImage({src:item.image,width:1200,format:'webp'})})));
const cover=await getImage({src:engineerCover,width:900,format:'webp'});
---
<div class="certs" id="certs">
  <div class="cert-heading"><h3>专业资质</h3><span>点击查看</span></div>
  <div class="certs-primary">
    {primary.map(item=><a class="cert-card" href={item.full.src} data-image-open data-image-caption={item.name} aria-label={'查看'+item.name} aria-haspopup="dialog" aria-controls="imageLightbox">
      <Image src={item.image} alt={item.name} width={480} loading="lazy" />
      <div><span class="cert-org">{item.org}</span><h4>{item.name}</h4><span class="cert-meta">{item.meta}</span></div>
    </a>)}
  </div>
  <details class="cert-more">
    <summary>更多学习记录与证书</summary>
    <div class="certs-secondary">
      {secondary.map(item=><a class="cert-card" href={item.full.src} data-image-open data-image-caption={item.name} aria-label={'查看'+item.name} aria-haspopup="dialog" aria-controls="imageLightbox">
        <Image src={item.image} alt={item.name} width={480} loading="lazy" />
        <div><span class="cert-org">{item.org}</span><h4>{item.name}</h4><span class="cert-meta">{item.meta}</span></div>
      </a>)}
    </div>
    <a class="cert-cover" href={cover.src} data-image-open data-image-caption="人工智能应用工程师 · 职业技术证书封面" aria-haspopup="dialog" aria-controls="imageLightbox">查看职业技术证书封面 <span aria-hidden="true">↗</span></a>
  </details>
</div>
<style>
  .certs { margin-top:40px; padding-top:28px; border-top:1px solid var(--border); scroll-margin-top:100px; }
  .cert-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:18px; }
  .cert-heading h3 { font-size:18px; font-weight:500; } .cert-heading > span { font-size:12px; color:var(--text-muted); }
  .certs-primary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .cert-card { display:flex; gap:20px; align-items:center; padding:20px; border:1px solid var(--border); border-radius:10px; background:var(--bg-card); min-width:0; }
  .cert-card:hover { border-color:var(--accent); }
  .cert-card img { width:100px; height:80px; object-fit:contain; background:#fff; border-radius:4px; flex-shrink:0; }
  .cert-card > div { min-width:0; } .cert-card h4 { font-size:15px; line-height:1.7; color:var(--text-primary); font-weight:500; margin:5px 0; }
  .cert-org { color:var(--accent); font-size:11px; line-height:1.6; display:block; }
  .cert-meta { font-size:11px; color:var(--text-secondary); }
  .cert-more { margin-top:14px; }
  summary { min-height:48px; padding:12px 0; cursor:pointer; color:var(--text-secondary); font-size:13px; }
  .certs-secondary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; padding:8px 0; }
  .cert-cover { display:inline-flex; align-items:center; gap:14px; min-height:44px; font-size:13px; color:var(--accent); }
  @media(max-width:768px) { .certs-primary,.certs-secondary { grid-template-columns:1fr; gap:12px; } .cert-card { padding:16px; gap:14px; } .cert-card img { width:78px; height:65px; } .cert-card h4 { font-size:14px; } .certs { margin-top:28px; } }
</style>
