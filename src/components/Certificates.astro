---
// Certificates Section — Trust signals with actual certificate images
import { Image } from 'astro:assets';
import certGeminiEducator from '../assets/certs/Gemini教育者认证.png';
import certGeminiTeacher from '../assets/certs/Gemini教师认证.png';
import certGeminiStudent from '../assets/certs/Gemini Certified University Student认证.png';
import certUNESCO from '../assets/certs/联合国科教文组织OER证书.png';
import certAITrainer from '../assets/refresh/ai-trainer-cn-private.png';
import certAIJustice from '../assets/certs/人工智能、司法与法治认证.png';
import certAIEngineer from '../assets/refresh/ai-engineer-query-cropped.png';
---

<section class="section certs" id="certs" data-story-section="certificates">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">专业认证</span>
      <h2 class="section-title">专业认证与持续学习</h2>
      <p class="section-desc">
        点击查看证书 · 部分图片已做隐私处理。
      </p>
    </div>

    <div class="certs-grid certs-primary">
      <div class="cert-card card reveal" data-cert-story="4" data-cert-private>
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看人工智能训练师高级证书大图">
          <Image src={certAITrainer} alt="人工智能训练师高级证书（隐私处理展示版）" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">阿里云 · 达摩院</div>
        <h3 class="cert-name">人工智能训练师（高级）</h3>
        <p class="cert-name-en" lang="en" hidden>AI Trainer — Advanced Level</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">有效至 2027.05.21</span>
        </div>
      </div>

      <div class="cert-card card reveal reveal-delay-1" data-cert-story="6" data-cert-private>
        <button type="button" class="cert-img-wrap cert-query-crop" data-cert-open aria-label="查看人工智能应用工程师高级证书查询截图">
          <Image src={certAIEngineer} alt="人工智能应用工程师（高级）证书查询截图（身份证号码已遮挡）" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">工业和信息化部教育与考试中心</div>
        <h3 class="cert-name">人工智能应用工程师（高级）</h3>
        <div class="cert-meta">
          <span class="cert-date">职业技术证书</span>
          <span class="cert-valid">查询截图 · 点击查看</span>
        </div>
      </div>

      <div class="cert-card card reveal reveal-delay-2" data-cert-story="5">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看人工智能、司法与法治结业证书大图">
          <Image src={certAIJustice} alt="人工智能、司法与法治结业证书" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">牛津大学 · UNESCO</div>
        <h3 class="cert-name">人工智能、司法与法治结业证书</h3>
        <p class="cert-name-en" lang="en" hidden>AI, Justice & Rule of Law</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.31</span>
          <span class="cert-note" hidden>牛津大学赛德商学院与联合国教科文组织共同开发</span>
        </div>
      </div>
    </div>
    <details class="cert-more">
      <summary><span class="cert-more-closed">查看更多相关证书</span><span class="cert-more-open">收起相关证书</span></summary>
      <p class="cert-swipe-hint" id="cert-swipe-hint">左右滑动查看 · 点击证书可放大</p>
      <div class="certs-grid certs-secondary" role="region" aria-label="相关证书" aria-describedby="cert-swipe-hint" tabindex="0">
      <div class="cert-card card reveal" data-cert-story="1">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 教职人员认证大图">
          <Image src={certGeminiTeacher} alt="Gemini 教职人员认证" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教职人员认证</h3>
        <p class="cert-name-en" lang="en" hidden>Gemini Certified Faculty</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">有效至 2029.05.21</span>
        </div>
      </div>

      <div class="cert-card card reveal reveal-delay-1" data-cert-story="2">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 大学生认证大图">
          <Image src={certGeminiStudent} alt="Gemini 大学生认证" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 大学生认证</h3>
        <p class="cert-name-en" lang="en" hidden>Gemini Certified University Student</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-valid">有效至 2029.05.21</span>
        </div>
      </div>

      <div class="cert-card card reveal reveal-delay-2" data-cert-story="3">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 UNESCO 开放教育资源开发结业证书大图">
          <Image src={certUNESCO} alt="UNESCO 开放教育资源开发结业证书" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">联合国教科文组织</div>
        <h3 class="cert-name">开放教育资源开发结业证书</h3>
        <p class="cert-name-en" lang="en" hidden>Open Educational Resources (OER) Development</p>
        <div class="cert-meta">
          <span class="cert-date">2026.05.21</span>
          <span class="cert-note" hidden>UNESCO 颁发 · Prof. Lidia Arthur Brito 签署</span>
        </div>
      </div>

      <div class="cert-card card reveal" data-cert-story="0">
        <button type="button" class="cert-img-wrap" data-cert-open aria-label="查看 Gemini 教育者认证大图">
          <Image src={certGeminiEducator} alt="Gemini 教育者认证" class="cert-img" loading="lazy" width={1000} />
          <span class="cert-shine" aria-hidden="true"></span>
        </button>
        <div class="cert-org">Google for Education</div>
        <h3 class="cert-name">Gemini 教育者认证</h3>
        <p class="cert-name-en" lang="en" hidden>Gemini Certified Educator</p>
        <div class="cert-meta">
          <span class="cert-date">2026.06.05</span>
          <span class="cert-valid">有效至 2029.06.05</span>
        </div>
      </div>

      </div>
    </details>
  </div>

  <dialog class="cert-lightbox" data-cert-lightbox aria-label="证书大图查看">
    <div class="cert-lightbox-panel">
      <button type="button" class="cert-lightbox-close" data-cert-close aria-label="关闭证书大图">×</button>
      <img class="cert-lightbox-image" data-cert-lightbox-image alt="" />
      <p class="cert-lightbox-caption" data-cert-lightbox-caption></p>
    </div>
  </dialog>
</section>

<style>
  .cert-img-wrap.cert-query-crop { background: #fff; }
  [hidden] { display: none !important; }
  .certs {
    background: var(--bg-surface);
    overflow: clip;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cert-card {
    --cert-tilt-x: 0deg;
    --cert-tilt-y: 0deg;
    padding: 20px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform:
      perspective(1100px)
      translate3d(0, 18px, 0)
      rotateX(var(--cert-tilt-x))
      rotateY(var(--cert-tilt-y));
    transform-style: preserve-3d;
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.58s var(--ease-out),
      border-color 0.45s ease,
      box-shadow 0.45s ease;
  }

  .cert-card.story-active {
    transform:
      perspective(1100px)
      translate3d(0, 0, 12px)
      rotateX(var(--cert-tilt-x))
      rotateY(var(--cert-tilt-y));
    border-color: rgba(201, 165, 92, 0.28);
    box-shadow:
      0 20px 58px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .cert-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    margin-bottom: 4px;
    transition: all 0.3s var(--ease-out);
    position: relative;
    padding: 0;
    cursor: zoom-in;
    color: inherit;
  }

  .cert-img-wrap:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(201, 165, 92, 0.15);
  }

  .cert-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-shine {
    position: absolute;
    inset: -25%;
    background: linear-gradient(
      112deg,
      transparent 36%,
      rgba(255, 249, 224, 0.42) 48%,
      rgba(201, 165, 92, 0.12) 54%,
      transparent 66%
    );
    opacity: 0;
    transform: translateX(-45%);
    pointer-events: none;
  }

  .cert-card.story-active .cert-shine {
    animation: certSurfaceSweep 1.8s ease-out 1;
  }

  @keyframes certSurfaceSweep {
    0%, 58% {
      opacity: 0;
      transform: translateX(-48%);
    }
    68% {
      opacity: 0.54;
    }
    86%, 100% {
      opacity: 0;
      transform: translateX(48%);
    }
  }

  .cert-lightbox {
    width: min(94vw, 1180px);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: 1px solid rgba(201, 165, 92, 0.32);
    border-radius: 8px;
    background: rgba(8, 8, 7, 0.96);
    color: var(--text-primary);
    overflow: visible;
    box-shadow: 0 36px 120px rgba(0, 0, 0, 0.72);
    margin: auto;
  }

  .cert-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(8px);
  }

  .cert-lightbox-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 44px 32px 24px;
  }

  .cert-lightbox-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-light);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font: inherit;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }

  .cert-lightbox-close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cert-lightbox-image {
    width: auto;
    max-width: 100%;
    max-height: calc(92vh - 112px);
    object-fit: contain;
    border-radius: 4px;
    background: #fff;
  }

  .cert-lightbox-caption {
    font-size: 14px;
    color: var(--text-secondary);
    text-align: center;
  }

  .cert-org {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .cert-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .cert-name-en {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
  }

  .cert-date {
    font-size: 11px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .cert-valid {
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .cert-card {
      padding: 16px 12px;
      transform: translateY(12px);
    }

    .cert-card.story-active {
      transform: translateY(0);
    }

    .cert-lightbox-panel {
      padding: 48px 14px 18px;
    }

    .cert-lightbox-image {
      max-height: calc(90vh - 104px);
    }
  }

  @media (max-width: 768px), (pointer: coarse) {
    /* Expand the hit area while keeping the visible 36px circle in place. */
    .cert-lightbox-close {
      top: 4px;
      right: 6px;
      width: 48px;
      height: 48px;
      border: 0;
      border-radius: 0;
      background: transparent;
      isolation: isolate;
      touch-action: manipulation;
    }

    .cert-lightbox-close::before {
      content: '';
      position: absolute;
      inset: 6px;
      z-index: -1;
      border: 1px solid var(--border-light);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.04);
      pointer-events: none;
    }

    .cert-lightbox-close:hover::before {
      border-color: var(--accent);
    }

  }

  @media (max-width: 480px) {
    .certs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      max-width: 100%;
    }

    .cert-card {
      padding: 10px 8px;
      gap: 6px;
    }

    .cert-org {
      font-size: 10px;
      letter-spacing: 1px;
    }

    .cert-name {
      font-size: 12px;
    }

    .cert-name-en,
    .cert-date,
    .cert-valid {
      font-size: 10px;
      line-height: 1.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-card,
    .cert-card.story-active {
      transform: none;
    }

    .cert-shine {
      display: none;
    }
  }
  .cert-more { margin-top: 24px; }
  .cert-more > summary { cursor: pointer; color: var(--accent); padding: 16px; text-align: center; border: 1px solid var(--border-light); border-radius: 8px; font-size: 14px; }
  .cert-more-open { display: none; }
  .cert-more[open] .cert-more-closed { display: none; }
  .cert-more[open] .cert-more-open { display: inline; }
  .certs-secondary { margin-top: 24px; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .certs-secondary .cert-card { min-width: 0; padding: 18px 14px; transform: none; }
  .certs-secondary .cert-img-wrap { max-width: 260px; flex-shrink: 0; }
  .certs-secondary .cert-name-en { overflow-wrap: anywhere; }
  .certs-secondary .cert-meta { margin-top: auto; padding-top: 4px; }
  .cert-swipe-hint { display: none; }
  .cert-valid, .cert-date, .cert-name-en { font-size: 12px; line-height: 1.5; }
  @media (max-width: 768px) {
    .certs-grid { grid-template-columns: 1fr; gap: 12px; }
    .cert-card { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 4px 16px; padding: 16px; text-align: left; align-items: start; transform: none; }
    .cert-card .cert-img-wrap { grid-column: 1; grid-row: 1 / 5; align-self: center; margin: 0; }
    .cert-org, .cert-name, .cert-name-en, .cert-meta { grid-column: 2; min-width: 0; }
    .cert-name { font-size: 15px; }
    .cert-org { font-size: 11px; letter-spacing: .3px; }
    .cert-card .cert-date, .cert-card .cert-valid, .cert-card .cert-name-en { font-size: 12px; line-height: 1.5; }
    .cert-swipe-hint { display: block; margin-top: 16px; color: var(--text-muted); font-size: 12px; text-align: center; }
    .certs-secondary {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(78vw, 280px);
      gap: 12px;
      margin-top: 12px;
      padding: 4px 4px 16px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 4px;
    }
    .certs-secondary .cert-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 16px;
      text-align: center;
      scroll-snap-align: start;
      transform: none;
    }
    .certs-secondary .cert-img-wrap { max-width: none; }
  }
  @media (max-width: 380px) { .cert-card { grid-template-columns: 78px minmax(0, 1fr); gap: 4px 12px; padding: 14px; } }
</style>

<script>
  const certificatesSection = document.querySelector<HTMLElement>('[data-story-section="certificates"]');

  if (certificatesSection && !certificatesSection.dataset.storyBound) {
    certificatesSection.dataset.storyBound = 'true';
    const cards = Array.from(certificatesSection.querySelectorAll<HTMLElement>('[data-cert-story]'));
    const openButtons = Array.from(certificatesSection.querySelectorAll<HTMLButtonElement>('[data-cert-open]'));
    const dialog = certificatesSection.querySelector<HTMLDialogElement>('[data-cert-lightbox]');
    const dialogImage = dialog?.querySelector<HTMLImageElement>('[data-cert-lightbox-image]');
    const dialogCaption = dialog?.querySelector<HTMLElement>('[data-cert-lightbox-caption]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-cert-close]');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeTrigger: HTMLButtonElement | null = null;

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'certificates') return;

      cards.forEach((card, index) => {
        const threshold = 0.02 + index * 0.105;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    });

    if (finePointer && !reducedMotion) {
      cards.forEach((card) => {
        let tiltFrame = 0;
        let latestX = 0;
        let latestY = 0;
        card.addEventListener('pointermove', (event) => {
          latestX = event.clientX;
          latestY = event.clientY;
          if (tiltFrame) return;
          tiltFrame = requestAnimationFrame(() => {
            tiltFrame = 0;
            const bounds = card.getBoundingClientRect();
            const x = (latestX - bounds.left) / bounds.width - 0.5;
            const y = (latestY - bounds.top) / bounds.height - 0.5;
            card.style.setProperty('--cert-tilt-x', `${(-y * 5).toFixed(2)}deg`);
            card.style.setProperty('--cert-tilt-y', `${(x * 5).toFixed(2)}deg`);
          });
        });
        card.addEventListener('pointerleave', () => {
          if (tiltFrame) { cancelAnimationFrame(tiltFrame); tiltFrame = 0; }
          card.style.setProperty('--cert-tilt-x', '0deg');
          card.style.setProperty('--cert-tilt-y', '0deg');
        });
      });
    }

    openButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const image = button.querySelector<HTMLImageElement>('img');
        const card = button.closest<HTMLElement>('.cert-card');
        const title = card?.querySelector<HTMLElement>('.cert-name')?.textContent?.trim() || image?.alt || '证书';
        if (!dialog || !dialogImage || !dialogCaption || !image) return;

        activeTrigger = button;
        dialogImage.src = image.currentSrc || image.src;
        dialogImage.alt = image.alt;
        dialogCaption.textContent = [title, card?.hasAttribute('data-cert-private') ? '隐私处理展示版' : '', card?.querySelector('.cert-valid')?.textContent?.trim(), card?.querySelector('.cert-note')?.textContent?.trim()].filter(Boolean).join(' · ');
        if (!dialog.open) {
          document.documentElement.classList.add('cert-lightbox-open');
          document.body.classList.add('cert-lightbox-open');
          dialog.showModal();
        }
      });
    });

    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      document.documentElement.classList.remove('cert-lightbox-open');
      document.body.classList.remove('cert-lightbox-open');
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>
