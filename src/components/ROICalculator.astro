---
// Scenario calculator: time value and implementation costs are explicit assumptions.
---
<section class="section roi" id="roi" data-story-section="roi">
  <div class="roi-ambient-wave" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">投入产出</span>
      <h2 class="section-title">AI 能帮你省多少时间？</h2>
      <p class="section-desc">选一项重复工作，估算可省下的时间与投入。</p>
    </div>
    <div class="roi-card card reveal reveal-delay-1">
      <div class="roi-config">
        <span class="roi-example-label">先看一个例子</span>
        <h3>把时间留给更重要的事</h3>
        <p id="roiExample">3 位同事，每人每天花 2 小时做重复工作。</p>
        <p class="roi-example-note">先选一项整理报表或核对资料的任务，试做后用实际节省的工时验证。</p>
        <details class="roi-settings">
          <summary>按我的业务调整参数</summary>
          <div class="roi-inputs">
        <div class="roi-preset-block">
          <span class="roi-preset-label">场景示例</span>
          <div class="roi-presets" role="group" aria-label="测算场景示例">
            <button type="button" class="roi-preset" data-roi-preset="starter" data-cost="50" data-leads="1" data-hours="1" aria-pressed="false">个人提效</button>
            <button type="button" class="roi-preset is-active" data-roi-preset="growth" data-cost="50" data-leads="3" data-hours="2" aria-pressed="true">运营小团队</button>
            <button type="button" class="roi-preset" data-roi-preset="scale" data-cost="80" data-leads="5" data-hours="3" aria-pressed="false">内容团队</button>
            <button type="button" class="roi-preset" data-roi-preset="custom" aria-pressed="false">自定义</button>
          </div>
        </div>
        <div class="roi-input-group">
          <label class="roi-label" for="hoursSlider"><span class="roi-label-text">每人每天的重复工作</span><span class="roi-label-value" id="hoursValue">2 小时</span></label>
          <input type="range" class="roi-slider" id="hoursSlider" min="0" max="8" value="2" step="0.5" />
          <div class="roi-range"><span>0 小时</span><span>8 小时</span></div>
        </div>
        <div class="roi-input-group">
          <label class="roi-label" for="leadsSlider"><span class="roi-label-text">参与这项工作的同事</span><span class="roi-label-value" id="leadsValue">3 人</span></label>
          <input type="range" class="roi-slider" id="leadsSlider" min="1" max="30" value="3" step="1" />
          <div class="roi-range"><span>1 人</span><span>30 人</span></div>
        </div>
        <div class="roi-input-group">
          <label class="roi-label" for="costSlider"><span class="roi-label-text">每小时人力成本</span><span class="roi-label-value" id="costValue">50 元</span></label>
          <input type="range" class="roi-slider" id="costSlider" min="0" max="300" value="50" step="5" />
          <div class="roi-range"><span>0 元</span><span>300 元</span></div>
        </div>
        <details class="roi-assumptions">
          <summary>调整效率目标与投入</summary>
          <div class="roi-assumption-fields">
            <label>预计节省时间（%）<input id="efficiencyInput" type="number" min="0" max="100" step="1" value="50" required /></label>
            <label>每月工作日（天）<input id="daysInput" type="number" min="1" max="31" step="1" value="22" required /></label>
            <label>每月工具与维护（元）<input id="toolsInput" type="number" min="0" max="1000000" step="1" value="300" required /></label>
            <label>一次性实施投入（元）<input id="setupInput" type="number" min="0" max="10000000" step="1" value="5000" required /></label>
          </div>
          <p>示例投入用于试算，具体费用按需求评估。</p>
        </details>
      </div>
        </details>
      </div>
      <div class="roi-results">
        <div class="roi-result-header">按当前假设测算</div>
        <div class="roi-time-result"><span class="roi-result-label">每月可释放工时</span><strong class="roi-highlight" id="hoursSaved" aria-live="polite">66 小时</strong></div>
        <p class="roi-note" id="roiTimeAssumptions">按每月 22 个工作日、重复工作节省 50% 试算。</p>
        <div class="roi-insight" aria-live="polite"><span class="roi-insight-label">这些时间可以用来</span><p id="roiInsight">相当于约 8.3 个工作日（每天 8 小时），可用于客户沟通、内容策划等工作。</p></div>
        <details class="roi-financials">
          <summary>查看成本与金额测算</summary>
          <div class="roi-financial-content">
            <div class="roi-result-item"><span class="roi-result-label">每月工时价值折算</span><span class="roi-result-value" id="savingsValue">¥3,300</span></div>
            <div class="roi-result-item"><span class="roi-result-label">首年工具与实施投入</span><span class="roi-result-value" id="investmentValue">¥8,600</span></div>
            <div class="roi-result-item roi-total"><span class="roi-result-label">首年折算价值减投入</span><span class="roi-result-value" id="annualValue">¥31,000</span></div>
            <p class="roi-note" id="roiAssumptions">每月工具与维护 ¥300，一次性投入 ¥5,000。</p>
            <p class="roi-note" id="roiFinancialInsight">工时价值不等于现金收入或直接减少的工资支出。</p>
          </div>
        </details>
        <a href="#contact" class="btn btn-primary roi-cta">聊聊哪一步值得先做</a>
      </div>
    </div>
  </div>
</section>
<style>
  .roi-config h3 { font-size: 23px; line-height: 1.5; margin: 12px 0 18px; }
  .roi-example-label { font-size: 13px; color: var(--accent); }
  .roi-config > p { color: var(--text-secondary); line-height: 1.8; font-size: 15px; }
  .roi-example-note { margin-top: 16px; }
  .roi-settings { margin-top: 24px; border-top: 1px solid var(--border-light); }
  .roi-settings > summary { cursor: pointer; color: var(--accent); font-size: 14px; padding: 18px 0; }
  .roi-settings[open] > summary { margin-bottom: 10px; }

  .roi {
    background: var(--bg);
    overflow: hidden;
  }

  .roi-ambient-wave {
    position: absolute;
    z-index: 0;
    top: 26%;
    right: -10%;
    width: min(54vw, 760px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(201, 165, 92, 0.08);
    box-shadow:
      0 0 0 42px rgba(201, 165, 92, 0.025),
      0 0 0 96px rgba(201, 165, 92, 0.018);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.8s ease, transform 1s var(--ease-out);
    pointer-events: none;
  }

  .roi.story-active .roi-ambient-wave {
    opacity: 1;
    transform: scale(1);
  }

  .roi > .container {
    position: relative;
    z-index: 1;
  }

  .roi-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 48px;
    overflow: hidden;
    border-color: rgba(201, 165, 92, 0.14);
    background:
      linear-gradient(145deg, rgba(201, 165, 92, 0.035), transparent 38%),
      var(--bg-card);
  }

  .roi-inputs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .roi-preset-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .roi-preset-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .roi-presets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: rgba(10, 10, 10, 0.42);
  }

  .roi-preset {
    min-height: 36px;
    padding: 7px 8px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .roi-preset:hover,
  .roi-preset:focus-visible {
    color: var(--text-primary);
  }

  .roi-preset.is-active {
    color: #0a0a0a;
    background: var(--accent);
    box-shadow: 0 4px 16px rgba(201, 165, 92, 0.2);
  }

  .roi-input-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .roi-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .roi-label-text {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .roi-label-value {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .roi-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    --slider-progress: 33.33%;
    background: linear-gradient(
      90deg,
      rgba(234, 211, 141, 0.92) 0,
      var(--accent) var(--slider-progress),
      var(--border) var(--slider-progress),
      var(--border) 100%
    );
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(201, 165, 92, 0.08);
  }

  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 3px solid var(--bg-card);
    box-shadow: 0 2px 8px rgba(201, 165, 92, 0.3);
    transition: transform 0.2s;
  }

  .roi-slider::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  .roi-slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: 3px solid var(--bg-card);
    box-shadow: 0 2px 8px rgba(201, 165, 92, 0.3);
  }

  .roi-range {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
  }

  .roi-results {
    background: var(--bg-surface);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .roi-results::before,
  .roi-results::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 76%;
    top: 46%;
    width: 180px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(201, 165, 92, 0.16);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.25);
  }

  .roi-results::after {
    width: 270px;
    border-color: rgba(201, 165, 92, 0.08);
  }

  .roi-results.is-pulsing::before {
    animation: roiResultWave 0.72s var(--ease-out) 1;
  }

  .roi-results.is-pulsing::after {
    animation: roiResultWave 0.9s var(--ease-out) 0.08s 1;
  }

  @keyframes roiResultWave {
    0% {
      opacity: 0.54;
      transform: translate(-50%, -50%) scale(0.25);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.18);
    }
  }

  .roi-result-header {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .roi-result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .roi-result-label {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .roi-result-value {
    font-size: 16px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .roi-time-result { display: flex; flex-direction: column; gap: 8px; }
  .roi-highlight {
    color: var(--accent);
    font-size: 44px;
    font-family: var(--font-mono);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .roi-financials { border-top: 1px solid var(--border); }
  .roi-financials > summary { padding: 14px 0; color: var(--accent); font-size: 13px; cursor: pointer; }
  .roi-financial-content { display: grid; gap: 16px; padding: 4px 0 8px; }

  .roi-total {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .roi-total-value {
    color: var(--accent);
    font-size: 24px;
    position: relative;
    overflow: hidden;
    transition: transform 0.32s var(--ease-out), text-shadow 0.32s ease;
  }

  .roi-total-value.is-updating {
    transform: scale(1.04);
    text-shadow: 0 0 24px rgba(201, 165, 92, 0.38);
  }

  .roi-total-value::after {
    content: '';
    position: absolute;
    inset: -20% auto -20% -40%;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255, 248, 218, 0.78), transparent);
    opacity: 0;
    transform: skewX(-16deg);
    pointer-events: none;
  }

  .roi-total-value.is-updating::after {
    animation: roiValueSweep 0.62s var(--ease-out) 1;
  }

  @keyframes roiValueSweep {
    0% {
      left: -40%;
      opacity: 0;
    }
    20% {
      opacity: 0.7;
    }
    100% {
      left: 120%;
      opacity: 0;
    }
  }

  .roi-note {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .roi-insight {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 0 0;
    border-top: 1px solid var(--border);
  }

  .roi-insight-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.5px;
  }

  .roi-insight p {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  .roi-cta {
    text-align: center;
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .roi-ambient-wave {
      right: -42%;
      width: 92vw;
      opacity: 0.45;
    }

    .roi-card {
      grid-template-columns: 1fr;
      padding: 24px 20px;
      gap: 20px;
    }

    .roi-config h3 { font-size: 20px; }
    .roi-config > p { font-size: 14px; }

    .roi-results {
      padding: 20px 16px;
      gap: 14px;
    }

    .roi-presets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .roi-result-value {
      font-size: 16px;
    }

    .roi-highlight {
      font-size: 36px;
    }

    .roi-total-value {
      font-size: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roi-ambient-wave,
    .roi.story-active .roi-ambient-wave {
      opacity: 0.35;
      transform: none;
    }

    .roi-results::before,
    .roi-results::after,
    .roi-total-value::after {
      display: none;
    }
  }
</style>
<style>
  .roi-assumptions { border-top: 1px solid var(--border-light); padding-top: 16px; color: var(--text-secondary); font-size: 12px; }
  .roi-assumptions summary { color: var(--accent); cursor: pointer; font-size: 13px; }
  .roi-assumption-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0 12px; }
  .roi-assumption-fields label { display: flex; flex-direction: column; gap: 8px; }
  .roi-assumption-fields input { width: 100%; min-width: 0; color: var(--text-primary); background: var(--bg); border: 1px solid var(--border-light); border-radius: 6px; padding: 10px; font: inherit; }
  .roi-assumption-fields input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .roi-assumption-fields input[aria-invalid="true"] { border-color: #d99379; }
</style>
<script>
  const roiSection = document.querySelector<HTMLElement>('[data-story-section="roi"]')!;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const field = (id: string) => document.getElementById(id)!;
  const costSlider = input('costSlider');
  const leadsSlider = input('leadsSlider');
  const hoursSlider = input('hoursSlider');
  const efficiency = input('efficiencyInput');
  const days = input('daysInput');
  const tools = input('toolsInput');
  const setup = input('setupInput');
  const assumptions = [efficiency, days, tools, setup];
  const sliders = [costSlider, leadsSlider, hoursSlider];
  const presets = [...roiSection.querySelectorAll<HTMLButtonElement>('[data-roi-preset]')];
  const money = (n: number) => (n < 0 ? '−¥' : '¥') + Math.round(Math.abs(n)).toLocaleString('zh-CN');
  const number = (n: number) => Number(n.toFixed(1)).toLocaleString('zh-CN');
  const setPreset = (name: string) => presets.forEach(button => {
    button.classList.toggle('is-active', button.dataset.roiPreset === name);
    button.setAttribute('aria-pressed', String(button.dataset.roiPreset === name));
  });
  function calculate() {
    const hourly = costSlider.valueAsNumber;
    const people = leadsSlider.valueAsNumber;
    const hours = hoursSlider.valueAsNumber;
    field('roiExample').textContent = people + ' 位同事，每人每天花 ' + hours + ' 小时做重复工作。';
    field('costValue').textContent = hourly + ' 元';
    field('leadsValue').textContent = people + ' 人';
    field('hoursValue').textContent = hours + ' 小时';
    sliders.forEach(slider => {
      const progress = (slider.valueAsNumber - Number(slider.min)) / (Number(slider.max) - Number(slider.min)) * 100;
      slider.style.setProperty('--slider-progress', progress + '%');
    });
    const invalid = assumptions.some(item => !item.validity.valid);
    assumptions.forEach(item => item.setAttribute('aria-invalid', String(!item.validity.valid)));
    if (invalid) {
      ['hoursSaved', 'savingsValue', 'investmentValue', 'annualValue'].forEach(id => field(id).textContent = '—');
      field('roiTimeAssumptions').textContent = '请检查参数：效率为 0–100%，工作日为 1–31 天，投入不能为负数。';
      field('roiAssumptions').textContent = '请填写完整且在范围内的参数。';
      field('roiInsight').textContent = '参数完整后会重新计算。';
      field('roiFinancialInsight').textContent = '参数完整后会重新计算。';
      return;
    }
    const monthlyHours = hours * people * days.valueAsNumber * efficiency.valueAsNumber / 100;
    const monthlyValue = monthlyHours * hourly;
    const annualCost = tools.valueAsNumber * 12 + setup.valueAsNumber;
    const annualNet = monthlyValue * 12 - annualCost;
    field('hoursSaved').textContent = number(monthlyHours) + ' 小时';
    field('savingsValue').textContent = money(monthlyValue);
    field('investmentValue').textContent = money(annualCost);
    field('annualValue').textContent = money(annualNet);
    field('roiTimeAssumptions').textContent = '按每月 ' + days.value + ' 个工作日、重复工作节省 ' + efficiency.value + '% 试算。';
    field('roiAssumptions').textContent = '按每小时人力成本 ' + money(hourly) + ' 折算；每月工具与维护 ' + money(tools.valueAsNumber) + '，一次性投入 ' + money(setup.valueAsNumber) + '。';
    field('roiInsight').textContent = monthlyHours > 0
      ? '相当于约 ' + number(monthlyHours / 8) + ' 个工作日（每天 8 小时），可用于客户沟通、内容策划等工作。'
      : '当前参数下没有释放工时，可以换一项重复任务评估。';
    field('roiFinancialInsight').textContent = (annualNet > 0
      ? ''
      : '按当前假设，首年工时折算价值尚未超过投入，可先缩小范围或重新评估。')
      + '工时价值不等于现金收入或直接减少的工资支出。';
  }
  [...sliders, ...assumptions].forEach(item => item.addEventListener('input', () => { setPreset('custom'); calculate(); }));
  presets.forEach(button => button.addEventListener('click', () => {
    const name = button.dataset.roiPreset || 'custom';
    setPreset(name);
    if (name === 'custom') { hoursSlider.focus(); return; }
    costSlider.value = button.dataset.cost!;
    leadsSlider.value = button.dataset.leads!;
    hoursSlider.value = button.dataset.hours!;
    efficiency.value = '50'; days.value = '22'; tools.value = '300'; setup.value = '5000';
    calculate();
  }));
  calculate();
  window.addEventListener('visual-story:update', event => {
    const detail = (event as CustomEvent<{ section: string }>).detail;
    roiSection.classList.toggle('story-active', detail.section === 'roi');
  });
</script>
