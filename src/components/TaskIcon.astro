---
<svg viewBox="0 0 44 42" fill="none" aria-hidden="true"><path d={paths[kind] || paths.reports} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
<style>svg{width:40px;height:40px;color:#d8c28c;flex-shrink:0;filter:drop-shadow(0 3px 8px #c9a55c14)}</style>
