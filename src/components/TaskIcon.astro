customer:'M6 6h14v10H6zM24 6h14v10H24zM12 16v6h20v-6M22 22v5M14 27h16v10H14z',
content:'M6 6h25v25H6zM18 12l8 6-8 6zM11 35h27M35 9v21',
research:'M6 5h19v27H6zM11 12h9M11 18h7M32 29l6 8M36 23a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
images:'M5 7h34v28H5zM5 29l11-11 9 9 6-6 8 8M26 14h1',
