---
// Hero Section
import { Image } from 'astro:assets';
import avatar from '../assets/refresh/portrait.jpg';
---

<section class="hero" id="hero" data-story-section="hero">
  <!-- Background gradient -->
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="container hero-content">
    <!-- Avatar -->
    <div class="hero-avatar reveal">
      <Image src={avatar} alt="Liangzhenjie" class="hero-avatar-img" width={120} height={120} loading="eager" />
      <div class="hero-avatar-ring"></div>
    </div>

    <div class="hero-badge reveal">
      <span class="hero-badge-dot"></span>
      Liangzhenjie · AI 落地顾问
    </div>

    <h1 class="hero-title" aria-label="帮企业与个人，用 AI 解决真问题">
      <span id="heroTypewriter" aria-hidden="true">帮企业与个人</span><br />
      <span class="hero-title-accent" id="heroTypewriterAccent" aria-hidden="true">用 AI 解决真问题</span>
    </h1>

    <p class="hero-desc reveal reveal-delay-2">
        企业 AI 落地，涵盖内部培训、流程与工具。<br />
        为个人与小团队搭建智能体、定制工作流。
    </p>

    <!-- Brand trust bar -->
    <div class="hero-brands reveal reveal-delay-3">
      <span class="hero-brands-label">服务行业</span>
      <div class="hero-brands-list">
        <span class="hero-brand">定制家居</span>
        <span class="hero-brand">家居零售</span>
        <span class="hero-brand">智能家居</span>
      </div>
    </div>

    <div class="hero-actions reveal reveal-delay-4">
      <a href="#cases" class="btn btn-primary">
        查看案例
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#contact" class="btn btn-outline">联系咨询</a>
    </div>

    <!-- Key numbers -->
    <div class="hero-stats reveal reveal-delay-5">
      <div class="hero-stat">
        <span class="hero-stat-number">4 年</span>
        <span class="hero-stat-label">一线家居运营经验</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-number">80%</span>
        <span class="hero-stat-label">历史家居项目 · 获客成本最高降幅</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-number">已上线</span>
        <span class="hero-stat-label">居图 AI 小程序</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll">
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 120px 0 80px;
  }

  .hero-bg {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(201, 165, 92, 0.08), transparent),
      radial-gradient(ellipse 60% 40% at 80% 50%, rgba(201, 165, 92, 0.03), transparent);
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-avatar {
    position: relative;
    width: 120px;
    height: 120px;
    margin-bottom: 32px;
  }

  .hero-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 32%;
    border: 3px solid var(--accent);
  }

  .hero-avatar-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(201, 165, 92, 0.3);
    animation: ringPulse 3s ease-in-out infinite;
  }

  @keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.05); opacity: 1; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--accent-subtle);
    border: 1px solid rgba(201, 165, 92, 0.15);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 32px;
    font-family: var(--font-mono);
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(36px, 7vw, 72px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }

  .hero-title-accent {
    color: var(--accent);
    text-shadow: 0 0 34px rgba(201, 165, 92, 0.18);
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .hero-title:not([data-typing='running']) .hero-title-accent {
      background: linear-gradient(135deg, var(--accent) 0%, #e8d5a3 50%, var(--accent) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  /* Characters are only hidden while the typing run is active, so a script
     failure can never leave the headline invisible. */
  .hero-title[data-typing='running'] :global(.typewriter-char) { opacity: 0; position: relative; }
  .hero-title[data-typing='running'] :global(.typewriter-char.is-visible) { opacity: 1; }
  .hero-title[data-typing='running'] :global(.typewriter-char.is-caret)::after {
    content: '';
    position: absolute;
    right: -0.06em;
    top: 0.15em;
    bottom: 0.05em;
    width: 2px;
    background: var(--accent);
  }

  .hero-desc {
    font-size: clamp(16px, 2vw, 18px);
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 560px;
    margin-bottom: 40px;
  }

  .hero-brands {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .hero-brands-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .hero-brands-list {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 6px 16px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    letter-spacing: 0.5px;
    transition: all 0.3s var(--ease-out);
  }

  .hero-brand:hover {
    border-color: var(--brand-color, var(--accent));
    color: var(--text-primary);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 80px;
  }

  .hero-actions .btn-primary::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: -70%;
    left: -45%;
    width: 30%;
    height: 240%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 249, 220, 0.62),
      transparent
    );
    opacity: 0;
    transform: rotate(18deg) translateX(0);
    pointer-events: none;
  }

  @media (hover: hover) {
    .hero-actions .btn-primary:hover::before {
      animation: heroButtonSweep 0.58s var(--ease-out) 1;
    }
  }

  @keyframes heroButtonSweep {
    0% {
      opacity: 0;
      transform: rotate(18deg) translateX(0);
    }
    22% {
      opacity: 0.58;
    }
    100% {
      opacity: 0;
      transform: rotate(18deg) translateX(520%);
    }
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero-stat-number {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .hero-stat-label {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  .hero-scroll {
    position: absolute;
    z-index: 3;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 48px;
    overflow: hidden;
  }

  .hero-scroll-line {
    width: 100%;
    height: 100%;
    background: var(--accent);
    animation: scrollDown 2s ease-in-out infinite;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 100px 0 60px;
    }

    .hero-avatar {
      width: 96px;
      height: 96px;
    }

    .hero-title {
      font-size: clamp(28px, 8vw, 48px);
    }

    .hero-actions {
      flex-direction: column;
      margin-bottom: 60px;
    }

    .hero-actions .btn {
      justify-content: center;
      width: 100%;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .hero-stat-divider {
      display: none;
    }

    .hero-stat {
      min-width: 0;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-avatar {
      width: 80px;
      height: 80px;
      margin-bottom: 24px;
    }

    .hero-title {
      font-size: clamp(24px, 8vw, 36px);
    }

    .hero-desc {
      font-size: 15px;
    }

    .hero-stats {
      gap: 16px;
    }

    .hero-stat-number {
      font-size: 24px;
    }
  }
</style>

<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const title = document.querySelector<HTMLElement>('.hero-title');
  const lines = [document.getElementById('heroTypewriter'), document.getElementById('heroTypewriterAccent')];

  // Keep the published two-line sequence and its original pacing.
  if (title && lines.every(Boolean) && !motionPreference.matches) {
    // Split first while the text is still fully visible, then switch the
    // hiding rule on. If anything throws before this point, the text stays.
    const characters = lines.flatMap(line => {
      const spans = Array.from(line!.textContent || '').map(character => {
        const span = document.createElement('span');
        span.className = 'typewriter-char';
        span.textContent = character;
        return span;
      });
      line!.replaceChildren(...spans);
      return spans;
    });
    title.dataset.typing = 'running';

    let frame = 0;
    let shown = 0;
    let watchdog = 0;
    const start = performance.now() + 500;

    const finish = () => {
      cancelAnimationFrame(frame);
      clearTimeout(watchdog);
      characters.forEach(character => {
        character.classList.add('is-visible');
        character.classList.remove('is-caret');
      });
      title.dataset.typing = 'complete';
      motionPreference.removeEventListener('change', onMotionChange);
      window.removeEventListener('pagehide', finish);
    };
    function onMotionChange() { if (motionPreference.matches) finish(); }
    function type(now: number) {
      const count = Math.min(characters.length, Math.max(0, Math.floor((now - start) / 110) + 1));
      if (count !== shown) {
        characters.forEach((character, index) => {
          character.classList.toggle('is-visible', index < count);
          character.classList.toggle('is-caret', index === count - 1);
        });
        shown = count;
      }
      if (count === characters.length) finish();
      else frame = requestAnimationFrame(type);
    }
    // Safety net: even if rAF never runs (blocked main thread, odd browser),
    // reveal the whole line shortly after load.
    watchdog = window.setTimeout(finish, 3000);
    motionPreference.addEventListener('change', onMotionChange);
    window.addEventListener('pagehide', finish);
    frame = requestAnimationFrame(type);
  }
</script>
