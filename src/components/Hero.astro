---
import { Image } from 'astro:assets';
import avatar from '../assets/refresh/portrait.jpg';
const titleLines = ['企业 AI 落地与内训', '智能体与工作流定制开发'];
const typingDuration = titleLines.reduce((total, line) => total + Array.from(line).length, 0) * 85 + 220;
---
<section class="hero" id="hero" data-story-section="hero">
  <div class="container hero-content">
    <div class="hero-overview"><div class="hero-identity">
      <Image src={avatar} alt="Liangzhenjie" width={288} height={288} loading="eager" />
      <div class="identity-copy"><span class="identity-name">Liangzhenjie</span><span class="identity-role">AI 落地顾问</span></div>
    </div>
    <div class="hero-positioning">
    <h1 aria-label={titleLines.join('，')} style={'--typing-duration:'+typingDuration+'ms'}>{titleLines.map((line,lineIndex)=><span class:list={['title-line',{'title-accent':lineIndex===1}]} aria-hidden="true">{Array.from(line).map((letter,index)=><span class="type-letter" style={'--type-delay:'+((index+(lineIndex===1?Array.from(titleLines[0]).length:0))*85+220)+'ms'}>{letter===' '?'\u00a0':letter}</span>)}{lineIndex===1 && <i class="typing-cursor" />}</span>)}</h1>
    <p class="hero-intro">你熟悉自己的业务，我来帮你选办法、做开发。<br class="desktop-break" />一起把工具做出来，也让用它的人学会怎么用。</p>
    </div>
    </div>
    <div class="audience-grid">
      <a class="audience-entry audience-enterprise" href="#enterprise">
        <div class="entry-top"><span class="entry-index">01</span><span>企业负责人 · 业务团队</span></div>
        <h2>企业 AI 落地与内训</h2>
        <p>想用 AI 改进经营，却不知道从哪里开始？我帮你找值得做的项目、开发需要的工具，也带团队学会在岗位上使用。</p>
        <span class="entry-action">了解企业服务 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>
      </a>
      <a class="audience-entry" href="#individual">
        <div class="entry-top"><span class="entry-index">02</span><span>个人 · 小团队</span></div>
        <h2>智能体与工作流定制开发</h2>
        <p>业务想做大，却总被人手和时间卡住？把你做生意、做服务的经验做成工具，让一个人或小团队也能接得住更多业务。</p>
        <span class="entry-action">了解个人定制 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>
      </a>
    </div>
    <div class="hero-bottom"><a href="#roi">还没想清楚？做一次场景自测 <span aria-hidden="true">↓</span></a><span>最多 4 个问题 · 无需留联系方式</span></div>
  </div>
</section>
<style>
  .hero { position:relative; isolation:isolate; padding:142px 0 42px; }
  .hero::before { content:''; position:absolute; z-index:-1; inset:40px 10% 20%; pointer-events:none; background:radial-gradient(ellipse at 50% 30%,#c9a55c0c,transparent 65%); }
  .hero-content { position:relative; z-index:2; width:100%; max-width:1160px; }
  .hero-overview { display:grid; grid-template-columns:246px minmax(0,max-content); justify-content:center; align-items:center; gap:52px; margin:0 auto 42px; }
  .hero-identity { display:flex; flex-direction:column; align-items:flex-start; gap:20px; padding-right:28px; border-right:1px solid #c9a55c35; }
  .hero-identity img { width:144px; height:144px; border-radius:18px; object-fit:cover; object-position:50% 32%; border:1px solid #c9a55c70; }
  .identity-copy { display:grid; gap:8px; }
  .identity-name { font-size:29px; font-weight:600; letter-spacing:-.035em; color:var(--text-primary); }
  .identity-role { font-size:18px; color:var(--accent-hover); }
  .hero-positioning { min-width:0; }
  h1 { font-size:clamp(34px,3.8vw,48px); font-weight:700; line-height:1.55; letter-spacing:-.035em; margin:0 0 22px; }
  .title-line { display:block; position:relative; width:max-content; max-width:100%; }
  .title-accent { color:var(--accent-hover); }
  .type-letter { position:relative; display:inline-block; animation:type-in 85ms linear var(--type-delay) both; }
  .type-letter::after { content:''; position:absolute; width:2px; height:.8em; top:.36em; left:100%; background:var(--accent-hover); animation:letter-caret 85ms step-end var(--type-delay) both; }
  .typing-cursor { position:absolute; left:calc(100% + 6px); top:.36em; height:.8em; width:2px; background:var(--accent-hover); animation:cursor-finish 700ms step-end var(--typing-duration) 4 both; }
  @keyframes type-in { 0% { opacity:0; } 1%,100% { opacity:1; } }
  @keyframes letter-caret { 0%,90%,100% { opacity:0; } 1%,80% { opacity:1; } }
  @keyframes cursor-finish { 0%,90%,100% { opacity:0; } 10%,60% { opacity:1; } }
  .hero-intro { color:var(--text-secondary); font-size:16px; line-height:1.9; }
  .audience-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .audience-entry { display:flex; flex-direction:column; padding:26px 28px 22px; background:#141411e8; border:1px solid #c9a55c35; border-radius:12px; color:var(--text-primary); transition:border-color .2s,background .2s; }
  .audience-enterprise { background:linear-gradient(125deg,#c9a55c13,#141411ee); }
  .audience-entry:hover { border-color:var(--accent); background-color:#1b1a15; }
  .entry-top { display:flex; align-items:center; gap:12px; color:var(--text-secondary); font-size:12px; margin-bottom:16px; }
  .entry-index { color:var(--accent); font-family:var(--font-mono); }
  h2 { font-size:25px; font-weight:600; letter-spacing:-.02em; margin-bottom:12px; }
  .audience-entry p { color:var(--text-secondary); font-size:15px; line-height:1.9; max-width:29em; margin-bottom:22px; }
  .entry-action { display:flex; align-items:center; justify-content:space-between; color:var(--accent-hover); font-size:14px; margin-top:auto; padding-top:16px; border-top:1px solid #ffffff12; }
  .entry-action svg { width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:1.5; }
  .hero-bottom { display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 20px; align-items:center; margin-top:16px; font-size:13px; }
  .hero-bottom a { display:inline-flex; gap:12px; align-items:center; min-height:44px; color:var(--text-secondary); }
  .hero-bottom a:hover { color:var(--accent-hover); }
  .hero-bottom > span { color:var(--text-muted); font-size:12px; }
  @media(max-width:1024px) {
    .hero-overview { grid-template-columns:minmax(0,1fr); gap:28px; text-align:center; }
    .hero-identity { flex-direction:row; justify-content:center; align-items:center; gap:22px; padding:0; border:0; text-align:left; }
    .title-line { margin-inline:auto; }
    .hero-intro { margin-inline:auto; }
    .hero-identity img { width:88px; height:88px; border-radius:14px; }
    h1 { font-size:clamp(32px,5vw,46px); }
  }
  @media(max-width:768px) {
    .hero { padding:102px 0 32px; }
    .hero-overview { gap:26px; margin-bottom:28px; }
    .hero-identity { gap:18px; }
    .hero-identity img { width:76px; height:76px; }
    .identity-name { font-size:27px; }
    .identity-role { font-size:16px; }
    h1 { font-size:clamp(23px,6.5vw,40px); margin-bottom:16px; line-height:1.6; }
    .hero-intro { font-size:14px; line-height:1.85; max-width:35em; }
    .desktop-break { display:none; }
    .audience-grid { grid-template-columns:1fr; gap:12px; }
    .audience-entry { padding:18px 20px; }
    .entry-top { margin-bottom:9px; }
    h2 { font-size:21px; margin-bottom:8px; }
    .audience-entry p { font-size:14px; line-height:1.75; margin-bottom:12px; max-width:none; }
    .entry-action { padding-top:12px; }
    .hero-bottom { margin-top:12px; display:block; }
    .hero-bottom > span { display:block; }
  }
  @media(max-width:360px) { .hero-identity img { width:64px; height:64px; } .identity-name { font-size:24px; } .identity-role { font-size:15px; } }
  @media(prefers-reduced-motion:reduce) { .audience-entry { transition:none; } .type-letter { animation:none; opacity:1; } .type-letter::after,.typing-cursor { display:none; } }
  @media(max-width:1024px) and (min-width:769px) { h2 { font-size:22px; } }
</style>
