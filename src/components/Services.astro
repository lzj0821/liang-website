---
import { Image } from 'astro:assets';
import ProductShowcase from './ProductShowcase.astro';
import enterpriseVisual from '../assets/visual-scenes-20261024/enterprise.png';
import individualVisual from '../assets/visual-scenes-20261024/individual.png';
---
<div id="services" class="services">
  <section class="section audience-service" id="enterprise" data-story-section="enterprise" aria-labelledby="enterprise-title">
    <div class="container">
      <div class="service-main">
        <div class="service-copy">
          <span class="section-label">企业 AI 落地与内训</span>
          <h2 class="section-title" id="enterprise-title">公司要用 AI，<br />从哪里开始，怎么做？</h2>
          <p class="service-lead">想提高销售效率、降低运营成本，或改善客户服务？先聊你最想改变的事，我和你一起看，哪些地方值得用 AI 来做。</p>
          <dl class="service-deliverables">
            <div><dt>先选对项目</dt><dd>一起算投入、看难度，选出值得先做的项目，把预算用在关键的地方。</dd></div>
            <div><dt>再把它做成</dt><dd>需要开发系统、连接现有软件，还是搭建智能体，我来评估和实现。</dd></div>
            <div><dt>带着团队用</dt><dd>按岗位安排培训，拿你们自己的业务练习，讲清怎么用、怎么判断结果。</dd></div>
          </dl>
          <div class="service-actions"><a href="#contact" class="btn btn-primary" data-inquiry-type="enterprise" data-inquiry-source="企业 AI 落地">聊聊公司的情况</a><a href="#cases-business" class="text-link">看我做过的项目 <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="service-art">
          <Image src={enterpriseVisual} alt="企业 AI 落地：业务梳理、流程工具与团队培训" width={1000} loading="lazy" />
          <div class="service-value"><span>做什么值得</span><span aria-hidden="true">→</span><span>怎么做出来</span><span aria-hidden="true">→</span><span>团队怎么用</span></div>
        </div>
      </div>
    </div>
  </section>
  <div class="divider"></div>
  <section class="section audience-service individual-service" id="individual" data-story-section="individual" aria-labelledby="individual-title">
    <div class="container">
      <div class="service-main">
        <div class="service-copy">
          <span class="section-label">个人 · 小团队</span>
          <h2 class="section-title" id="individual-title">智能体与工作流<br />定制开发</h2>
          <p class="service-lead">你有自己的专业和做事方法，想服务更多客户，或把经验做成一款产品。我帮你开发适合自己的工具，少一些凡事亲力亲为。</p>
          <dl class="service-deliverables">
            <div><dt>按你的方法</dt><dd>把专业资料、经验和要求放进智能体，按你的标准做分析、出方案或服务客户。</dd></div>
            <div><dt>串起各步骤</dt><dd>把业务里的多个步骤连起来，做成一套工作流，减少工具之间来回搬运。</dd></div>
            <div><dt>做成工具</dt><dd>做自己用的工作台，也能做给客户用的产品。用真实业务试过，再交到你手上。</dd></div>
          </dl>
          <div class="service-actions"><a href="#contact" class="btn btn-primary" data-inquiry-type="individual" data-inquiry-source="智能体与工作流定制开发">聊聊你想做的工具</a><a href="#cases-personal" class="text-link">看工具与作品 <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="service-art">
          <Image src={individualVisual} alt="智能体与工作流概念图：专业方法、资料与工具协同完成任务" width={1000} loading="lazy" />
          <div class="service-value"><span>你的经验</span><span aria-hidden="true">→</span><span>自己的工具</span><span aria-hidden="true">→</span><span>服务更多客户</span></div>
        </div>
      </div>
      <div class="miniapp-service" id="case-jutu">
        <div><span class="service-tag">如果你想做一款产品</span><h3>小程序开发</h3><p>把你的服务做进微信里，让客户点开就能用。</p><a href="#contact" class="text-link" data-inquiry-type="miniapp" data-inquiry-source="小程序开发">聊聊小程序的想法 <span aria-hidden="true">↓</span></a></div>
        <ProductShowcase />
      </div>
    </div>
  </section>
</div>
<style>
  #services,#enterprise,#individual,#training-proof { scroll-margin-top:100px; }
  .service-main { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; }
  .service-copy,.service-art { min-width:0; }
  .section-title { text-align:left; margin:14px 0 22px; line-height:1.3; }
  .service-lead { font-size:16px; line-height:1.9; color:var(--text-secondary); max-width:32em; }
  .service-deliverables { margin:26px 0; display:grid; gap:16px; }
  .service-deliverables > div { display:grid; grid-template-columns:90px 1fr; gap:14px; line-height:1.8; font-size:14px; }
  dt { color:var(--text-primary); font-weight:500; } dd { color:var(--text-secondary); margin:0; }
  .service-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px 24px; }
  .text-link { display:inline-flex; align-items:center; gap:14px; color:var(--accent); font-size:14px; min-height:44px; }
  .text-link:hover { color:var(--accent-hover); }
  .service-art { background:#161613; border:1px solid var(--border); border-radius:14px; padding:12px; overflow:hidden; }
  .service-art > img { width:100%; height:auto; aspect-ratio:1.7; object-fit:cover; object-position:center bottom; display:block; border-radius:8px; }
  .service-value { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:20px 10px 10px; font-size:13px; color:var(--accent-hover); }
  .service-value [aria-hidden] { color:var(--text-muted); }
  @media(max-width:768px) { .service-value { padding:12px 6px 6px; font-size:12px; } }
  .service-tag { font-size:12px; color:var(--accent); }
  h3 { font-size:25px; font-weight:600; margin:9px 0 12px; }
  .miniapp-service p { font-size:14px; color:var(--text-secondary); line-height:1.9; }
  .miniapp-service { margin-top:48px; padding-top:32px; border-top:1px solid var(--border); display:grid; grid-template-columns:1fr; gap:24px; scroll-margin-top:100px; }
  .miniapp-products { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .miniapp-products button { min-width:0; display:flex; flex-direction:column; align-items:center; gap:14px; padding:24px 6px; background:#151513; border:1px solid var(--border); border-radius:10px; color:var(--text-primary); font:inherit; cursor:pointer; }
  .miniapp-products button:hover { border-color:var(--accent); }
  .miniapp-products strong { font-size:14px; font-weight:500; } .miniapp-products span { font-size:12px; color:var(--text-secondary); }
  @media(max-width:1024px) { .service-main { gap:32px; } .service-deliverables > div { grid-template-columns:78px 1fr; gap:10px; } }
  @media(max-width:768px) { .service-main { grid-template-columns:1fr; gap:28px; } .section-title { font-size:30px; margin:12px 0 16px; } .service-lead { font-size:15px; } .service-deliverables { margin:22px 0; gap:14px; } .service-actions { gap:8px 20px; } .training-proof,.miniapp-service { margin-top:32px; padding-top:26px; } h3 { font-size:22px; } .miniapp-service { grid-template-columns:1fr; gap:20px; } .miniapp-products { gap:8px; } .miniapp-products button { gap:10px; padding:18px 4px; } }
</style>
