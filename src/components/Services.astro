---
import { Image, getImage } from 'astro:assets';
import training from '../assets/evidence-20261026/training-refined.jpg';
import SharingRecord from './SharingRecord.astro';
import trainingContent from '../assets/refresh/training-content-anonymized.png';
import trainingAgent from '../assets/refresh/training-agent-anonymized.png';
import TaskIcon from './TaskIcon.astro';
import { selfBuiltProducts } from '../data/self-built-products';
import VisualStory from './VisualStory.astro';
import { serviceCopy } from '../data/visual-copy';
import ServiceExample from './ServiceExample.astro';
import AgentExamples from './AgentExamples.astro';
import enterpriseVisual from '../assets/visual-scenes-20261024/enterprise.png';
import individualVisual from '../assets/visual-scenes-20261024/individual.png';
const [trainingContentFull, trainingAgentFull] = await Promise.all([
  getImage({ src: trainingContent, width: 1080, format: 'webp' }),
  getImage({ src: trainingAgent, width: 1080, format: 'webp' }),
]);
---

<section class="section services" id="services" data-story-section="services">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">服务方案</span>
      <h2 class="section-title">标准化 AI 交付</h2>
      <p class="section-desc">
        从一次培训、一个流程，或一款小程序开始。
      </p>
    </div>

    <div class="services-plans">
    <div class="services-story-lines" aria-hidden="true">
      <span></span>
      <span></span>
    </div>

    <div class="services-grid">
      <div class="service-card card service-card-featured reveal" data-service-story="0">
        <VisualStory variant="service" image={enterpriseVisual} title={serviceCopy.enterprise.title} eyebrow={serviceCopy.enterprise.audience} points={serviceCopy.enterprise.points} />
        <ServiceExample title="一个周报工作流" input="原始报表、汇总口径和一份目标样表。" output="汇总工作流、核对清单与使用培训。" check="用约定样本核对数字、缺项与重复记录。" />
        <a class="service-case-link" href="#case-automation" data-case-detail-trigger="automation" aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">看报表与录入案例 →</a>
        <a href="#contact" class="btn btn-primary service-btn">聊聊企业需求</a>
      </div>
      <div class="service-card card reveal" data-service-story="1">
        <VisualStory variant="service" image={individualVisual} title={serviceCopy.individual.title} eyebrow={serviceCopy.individual.audience} points={serviceCopy.individual.points} />
        <AgentExamples />
        <a class="service-case-link" href="#case-workbench" data-case-detail-trigger="workbench" aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">看内容工作流案例 →</a>
        <a href="#contact" class="btn btn-outline service-btn">聊聊我的重复工作</a>
      </div>
    </div>
    </div>


    <div class="miniapp-service card reveal">
      <div class="miniapp-service-copy">
        <span class="service-tag">产品与工具开发</span>
        <h3>小程序开发</h3>
        <p>把一个具体需求，做成微信里能用的工具。</p>
        <span class="miniapp-scope">需求与功能 · 开发与测试 · 使用交接</span>
      </div>
      <div class="miniapp-products" aria-label="小程序作品">
        {selfBuiltProducts.map((product,i) => <button type="button" data-case-detail-trigger="jutu" data-product-open={product.id} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">
          <TaskIcon kind={['images','research','content'][i]} /><strong>{product.shortName}</strong><span>{['家居出图','模型动态','图文转播客'][i]}</span>
        </button>)}
      </div>
      <div class="miniapp-service-actions">
        <button type="button" class="service-case-link" data-case-detail-trigger="jutu" aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">查看小程序作品 →</button>
        <a href="#contact" class="btn btn-outline">聊聊小程序需求</a>
      </div>
    </div>

    <div class="training-proof card reveal" id="training-proof">
      <figure>
        <Image src={training} alt="Liangzhenjie 在线下分享 AI 应用与企业落地方法" width={700} loading="lazy" />
        <figcaption>线下分享：从会用 AI，到真正用出结果</figcaption>
      </figure>
      <div class="training-proof-content">
        <span class="service-tag">线下分享与企业内训</span>
        <h3 class="service-title">回到工作中，还能继续用</h3>
        <p class="service-desc">围绕熟悉的任务练习，带走可复用的模板与方法。</p>
        <div class="training-topics"><span>资料查找</span><span>内容草拟</span><span>报表整理</span></div>
        <a href="#contact" class="btn btn-outline">沟通培训需求</a>
      </div>
      <div class="training-gallery" aria-label="企业内训照片">
        <figure>
          <a class="image-preview" href={trainingContentFull.src} data-image-open data-image-caption="企业内训 · 内容与电商 AI 实战" aria-label="放大企业内训 · 内容与电商 AI 实战照片" aria-haspopup="dialog" aria-controls="imageLightbox">
            <Image src={trainingContent} alt="内容与电商团队 AI 实战企业内训课件" width={480} loading="lazy" />
          </a>
          <figcaption>企业内训 · 内容与电商 AI 实战</figcaption>
        </figure>
        <figure>
          <a class="image-preview" href={trainingAgentFull.src} data-image-open data-image-caption="企业内训 · Agent 落地应用" aria-label="放大 企业内训 · Agent 落地应用照片" aria-haspopup="dialog" aria-controls="imageLightbox">
            <Image src={trainingAgent} alt="企业内训 · Agent 落地应用的会场与课件" width={480} loading="lazy" />
          </a>
          <figcaption>企业内训 · Agent 落地应用</figcaption>
        </figure>
      </div>
      <SharingRecord />
    </div>
  </div>
</section>

<style>
  .service-card > :global(.service-example), .service-card > :global(.examples-trigger) { margin-inline:14px; width:calc(100% - 28px); }
  .service-card > .service-case-link { margin-inline:14px; min-height:44px; display:flex; align-items:center; }
  .service-card > .service-btn { width:calc(100% - 28px); margin-inline:14px; margin-bottom:14px; }

  .miniapp-service { margin-top:24px; padding:28px 32px; display:flex; justify-content:space-between; align-items:center; gap:24px; background:linear-gradient(110deg,#c9a55c0b,transparent 65%),var(--bg-card); }
  .miniapp-service h3 { font-size:24px; margin:8px 0; }
  .miniapp-service p { color:var(--text-secondary); font-size:14px; line-height:1.8; }
  .miniapp-scope { display:block; margin-top:12px; color:var(--text-muted); font-size:12px; line-height:1.8; }
  .miniapp-service-actions { display:flex; flex-direction:column; align-items:flex-start; gap:12px; flex-shrink:0; }
  .miniapp-service-actions button { background:none; border:0; font:inherit; font-size:13px; text-align:left; cursor:pointer; min-height:44px; }
  .miniapp-service-actions .btn { font-size:13px; padding:14px 24px; }
  @media(max-width:768px) { .miniapp-service { flex-direction:column; align-items:stretch; padding:24px; max-width:480px; margin-inline:auto; } .miniapp-service-actions { align-items:stretch; } }
  .service-case-link { color: var(--accent); font-size: 13px; line-height: 1.7; padding: 8px 0; text-underline-offset: 4px; }
  .service-options { margin-top: 24px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  .training-topics { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--text-secondary); font-size: 13px; }
  #training-proof { scroll-margin-top: 90px; }

  .service-examples { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 32px; align-items: center; font-size: 13px; }
  .service-examples > span { color: var(--text-secondary); }
  .service-examples a { color: var(--accent); text-underline-offset: 4px; }
  .training-proof { margin-top: 28px; padding: 28px; display: grid; grid-template-columns: minmax(190px, .9fr) minmax(230px, 1.15fr) minmax(240px, 1fr); gap: 24px; align-items: center; overflow: hidden; }
  .training-proof figure { margin: 0; min-width: 0; }
  .training-proof img { width: 100%; height: auto; display: block; border-radius: 6px; }
  .training-proof figcaption { color: var(--text-secondary); font-size: 12px; margin-top: 12px; }
  .training-proof-content { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .training-proof-content .btn { align-self: flex-start; }
  .training-proof-content .btn { margin-top: 4px; padding: 12px 20px; font-size: 13px; }
  .training-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; min-width: 0; }
  .training-gallery img { aspect-ratio: 3 / 4; object-fit: cover; }
  .training-gallery figcaption { margin-top: 10px; font-size: 12px; line-height: 1.6; }
  @media (min-width: 769px) and (max-width: 1024px) {
    .training-proof { grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr); }
    .training-proof > figure { grid-column: 1; grid-row: 1; }
    .training-proof-content { grid-column: 2; grid-row: 1 / 3; }
    .training-gallery { grid-column: 1; }
  }
  @media (max-width: 768px) {
    .training-proof { grid-template-columns: 1fr; gap: 20px; padding: 24px; max-width: 480px; margin-inline: auto; }
    .training-proof figure { width: 100%; max-width: 360px; }
    .training-gallery { gap: 12px; }
    .service-examples { max-width: 480px; margin-inline: auto; }
  }
  .services-plans { position: relative; isolation: isolate; }
  .services {
    overflow: hidden;
  }

  .services > .container {
    position: relative;
    z-index: 2;
  }

  .services-story-lines {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    pointer-events: none;
  }

  .services-story-lines span {
    position: relative;
  }

  .services-story-lines span::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(234, 211, 141, 0.72) 22%,
      rgba(201, 165, 92, 0.2) 76%,
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.24);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: opacity 0.45s ease, transform 0.85s var(--ease-out), filter 0.35s ease;
  }

  .services.story-active .services-story-lines span::before {
    opacity: 0.62;
    transform: scaleY(1);
  }

  .services[data-service-focus] .services-story-lines span::before {
    opacity: 0.2;
  }

  .services[data-service-focus='0'] .services-story-lines span:nth-child(1)::before,
  .services[data-service-focus='1'] .services-story-lines span:nth-child(2)::before {
    opacity: 1;
    filter: brightness(1.45);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
    position: relative;
    z-index: 2;
    perspective: 1200px;
  }

  .service-card {
    min-width: 0;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    transform: perspective(1100px) translate3d(0, 20px, 0);
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.58s var(--ease-out),
      opacity 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
    min-height: 0;
  }

  .service-card:nth-child(1),
  .service-card:nth-child(2) {
    margin-top: 0;
  }

  .service-card-featured {
    min-height: 0;
    box-shadow: 0 24px 74px rgba(0, 0, 0, 0.3);
  }

  .service-card.visible,
  .service-card.story-active {
    transform: translateY(0);
    border-color: rgba(201, 165, 92, 0.13);
    box-shadow:
      0 20px 58px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .services[data-service-focus] .service-card {
    opacity: 1;
  }

  .services[data-service-focus='0'] .service-card:nth-child(1),
  .services[data-service-focus='1'] .service-card:nth-child(2) {
    opacity: 1;
    transform: translateY(0);
    border-color: rgba(234, 211, 141, 0.46);
    box-shadow:
      0 26px 72px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(201, 165, 92, 0.08);
  }

  .service-card-featured {
    border-color: rgba(201, 165, 92, 0.3);
    background: linear-gradient(180deg, rgba(201, 165, 92, 0.04), transparent), var(--bg-card);
  }

  .service-card-featured.visible { border-color: rgba(201,165,92,.4); }

  .service-card-featured:hover {
    border-color: rgba(201, 165, 92, 0.5);
  }

  .service-popular {
    position: absolute;
    top: -1px;
    right: 24px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 0 0 6px 6px;
    letter-spacing: 0.5px;
  }

  .service-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .service-tag::before {
    content: '';
    width: 16px;
    height: 1px;
    flex: 0 0 auto;
    background: linear-gradient(90deg, var(--accent), rgba(201, 165, 92, 0.18));
  }

  .service-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .service-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }





  .service-btn {
    margin-top: auto;
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .services-story-lines {
      display: none;
    }

    .services-grid {
      gap: 20px;
    }

    .service-card {
      padding: 12px;
    }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .service-card {
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transform: translateY(14px);
      min-height: 0;
      margin-top: 0;
    }

    .service-card > .service-tag { align-self: flex-start; }
    .training-proof { padding: 20px; gap: 16px; }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 0;
    }

    .service-card.visible,
    .service-card.story-active,
    .services[data-service-focus='0'] .service-card:nth-child(1),
    .services[data-service-focus='1'] .service-card:nth-child(2),
    .services[data-service-focus='2'] .service-card:nth-child(3) {
      transform: translateY(0);
    }

    .service-title {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card.story-active {
      transform: none;
    }
  }

  .miniapp-service { display:grid;grid-template-columns:1fr 1.2fr;gap:24px 32px;padding:32px; }
  .miniapp-service h3 { font-size:28px; }.miniapp-service p,.miniapp-scope { font-size:14px; }
  .miniapp-products { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;min-width:0; }
  .miniapp-products button { min-width:0;padding:20px 10px;display:flex;align-items:center;flex-direction:column;gap:12px;border:1px solid #c9a55c26;border-radius:12px;background:linear-gradient(155deg,#c9a55c0b,#151513);color:var(--text-primary);font:inherit;cursor:pointer; }
  .miniapp-products strong { font-size:15px;font-weight:500; }.miniapp-products span { font-size:13px;color:var(--text-secondary); }
  .miniapp-products button:hover { border-color:var(--accent); }
  .miniapp-service-actions { grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding-top:18px; }
  @media(max-width:768px) { .miniapp-service { grid-template-columns:1fr;padding:22px;gap:22px; } .miniapp-service-actions { flex-direction:column;align-items:stretch;gap:8px; } .miniapp-products button { padding:16px 4px;gap:10px; } .miniapp-products strong { font-size:14px; } .miniapp-products span { font-size:12px; } }
</style>

<script>
  const servicesSection = document.querySelector<HTMLElement>('[data-story-section="services"]');

  if (servicesSection && !servicesSection.dataset.storyBound) {
    servicesSection.dataset.storyBound = 'true';
    const cards = Array.from(servicesSection.querySelectorAll<HTMLElement>('[data-service-story]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setFocus = (index: string | null) => {
      if (index === null) delete servicesSection.dataset.serviceFocus;
      else servicesSection.dataset.serviceFocus = index;
    };

    cards.forEach((card) => {
      const index = card.dataset.serviceStory || '0';
      card.addEventListener('pointerenter', () => setFocus(index));
      card.addEventListener('pointerleave', () => setFocus(null));
      card.addEventListener('focusin', () => setFocus(index));
      card.addEventListener('focusout', (event) => {
        if (!card.contains(event.relatedTarget as Node | null)) setFocus(null);
      });
    });

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      const active = detail.section === 'services';
      servicesSection.classList.toggle('story-active', active);
      if (!active) return;

      cards.forEach((card, index) => {
        card.classList.toggle('story-active', reducedMotion || detail.progress >= 0.05 + index * 0.14);
      });
    });
  }
</script>
