---
import { Image } from 'astro:assets';
import training from '../assets/refresh/training.jpg';
import trainingContent from '../assets/refresh/training-content-anonymized.png';
import trainingAgent from '../assets/refresh/training-agent-anonymized.png';
import ServiceExample from './ServiceExample.astro';
---

<section class="section services" id="services" data-story-section="services">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">服务方案</span>
      <h2 class="section-title">标准化 AI 交付</h2>
      <p class="section-desc">
        两类服务，按实际任务选择；可从一次培训或一个流程开始。
      </p>
    </div>

    <div class="services-plans">
    <div class="services-story-lines" aria-hidden="true">
      <span></span>
      <span></span>
    </div>

    <div class="services-grid">
      <div class="service-card card service-card-featured reveal" data-service-story="0">
        <div class="icon-box service-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="3" width="16" height="18" rx="2"/>
            <path d="M9 21v-5h6v5M8 7h2m4 0h2M8 11h2m4 0h2"/>
          </svg></div>
        <div class="service-tag">面向企业</div>
        <h3 class="service-title">企业 AI 落地</h3>
        <p class="service-desc">让 AI 进入日常业务，帮助团队减少重复操作与沟通成本。</p>
        <dl class="service-capabilities">
          <div><dt>业务梳理</dt><dd>找出耗时环节，判断哪些值得用 AI。</dd></div>
          <div><dt>流程与工具</dt><dd>按需搭建工作流、智能体或内部工具。</dd></div>
          <div><dt>内部培训</dt><dd>围绕岗位实操，让团队会用、能核对。</dd></div>
        </dl>
        <div class="service-details">
          <div class="service-detail"><span class="service-detail-label">常见场景</span><span class="service-detail-value">报表汇总 / 客户跟进 / 内部资料问答</span></div>
          <div class="service-detail"><span class="service-detail-label">按需交付</span><span class="service-deliverables"><span>落地方案</span><span>工具与流程</span><span>培训与说明</span></span></div>
        </div>
        <ServiceExample title="一个周报工作流" input="原始报表、汇总口径和一份目标样表。" output="汇总工作流、核对清单与使用培训。" check="用约定样本核对数字、缺项与重复记录。" />
        <a class="service-case-link" href="#case-automation" data-case-detail-trigger="automation" aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">看活动报表与录入案例 →</a>
        <a href="#contact" class="btn btn-primary service-btn">聊聊企业需求</a>
      </div>
      <div class="service-card card reveal" data-service-story="1">
        <div class="icon-box service-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="2" width="8" height="6" rx="1"/>
            <rect x="2" y="16" width="8" height="6" rx="1"/>
            <rect x="14" y="16" width="8" height="6" rx="1"/>
            <path d="M12 8v4M6 16v-4h12v4"/>
          </svg></div>
        <div class="service-tag">面向个人与小团队</div>
        <h3 class="service-title">智能体与工作流定制</h3>
        <p class="service-desc">把反复做的事情交给助手与流程，留出时间处理更重要的工作。</p>
        <dl class="service-capabilities">
          <div><dt>智能体搭建</dt><dd>围绕你的资料与任务，配置专属助手。</dd></div>
          <div><dt>工作流定制</dt><dd>串起收集、整理、生成与输出步骤。</dd></div>
          <div><dt>使用与调整</dt><dd>接入常用工具，保留关键步骤的核对。</dd></div>
        </dl>
        <div class="service-details">
          <div class="service-detail"><span class="service-detail-label">常见场景</span><span class="service-detail-value">资料整理 / 内容制作 / 重复填表</span></div>
          <div class="service-detail"><span class="service-detail-label">按需交付</span><span class="service-deliverables"><span>智能体或工作流</span><span>配置与模板</span><span>使用说明</span></span></div>
        </div>
        <ServiceExample title="一个内容处理流程" input="现有素材、重复操作步骤和参考成稿。" output="按需定制的智能体或工作流，以及使用说明。" check="用约定样本走通处理步骤，核对输出是否符合要求。" />
        <a class="service-case-link" href="#case-workbench" data-case-detail-trigger="workbench" aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">看内容工作流案例 →</a>
        <a href="#contact" class="btn btn-outline service-btn">聊聊我的重复工作</a>
      </div>
    </div>
    </div>


    <div class="training-proof card reveal" id="training-proof">
      <figure>
        <Image src={training} alt="Liangzhenjie 在线下分享 AI 应用与企业落地方法" width={700} loading="lazy" />
        <figcaption>现场分享：从会用 AI，到真正用出结果</figcaption>
      </figure>
      <div class="training-proof-content">
        <span class="service-tag">线下分享与团队实操</span>
        <h3 class="service-title">回到工作中，还能继续用</h3>
        <p class="service-desc">围绕熟悉的任务练习，带走可复用的模板与方法。</p>
        <div class="training-topics"><span>资料查找</span><span>内容草拟</span><span>报表整理</span></div>
        <a href="#contact" class="btn btn-outline">沟通培训需求</a>
      </div>
      <div class="training-gallery" aria-label="更多线下分享照片">
        <figure>
          <Image src={trainingContent} alt="内容与电商团队 AI 实战入门分享课件，企业信息已遮挡" width={480} loading="lazy" />
          <figcaption>内容与电商团队分享</figcaption>
        </figure>
        <figure>
          <Image src={trainingAgent} alt="Agent 落地主题分享的会场与课件，企业信息已遮挡" width={480} loading="lazy" />
          <figcaption>Agent 落地主题分享</figcaption>
        </figure>
        <p class="training-gallery-note">企业信息已做匿名处理</p>
      </div>
    </div>
  </div>
</section>

<style>
  .service-capabilities { display: grid; gap: 12px; margin: 0; padding: 4px 0; }
  .service-capabilities > div { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .service-capabilities dt { color: var(--accent); font-size: 13px; font-weight: 600; }
  .service-capabilities dd { margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.8; }
  @media (max-width: 380px) {
    .service-capabilities > div { grid-template-columns: 72px minmax(0, 1fr); gap: 8px; }
  }
  .service-deliverables { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .service-deliverables > span { padding: 3px 7px; border-radius: 4px; background: var(--accent-subtle); color: var(--text-secondary); font-size: 12px; }
  .service-case-link { color: var(--accent); font-size: 13px; line-height: 1.7; padding: 8px 0; text-underline-offset: 4px; }
  .service-options { margin-top: 24px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  .training-topics { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--text-secondary); font-size: 13px; }
  #training-proof { scroll-margin-top: 90px; }

  .service-examples { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 32px; align-items: center; font-size: 13px; }
  .service-examples > span { color: var(--text-secondary); }
  .service-examples a { color: var(--accent); text-underline-offset: 4px; }
  .training-proof { margin-top: 28px; padding: 28px; display: grid; grid-template-columns: minmax(190px, .9fr) minmax(230px, 1.15fr) minmax(240px, 1fr); gap: 24px; align-items: center; overflow: hidden; }
  .training-proof figure { margin: 0; min-width: 0; }
  .training-proof img { width: 100%; height: auto; display: block; border-radius: 6px; }
  .training-proof figcaption { color: var(--text-secondary); font-size: 12px; margin-top: 12px; }
  .training-proof-content { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .training-proof-content .btn { align-self: flex-start; }
  .training-proof-content .btn { margin-top: 4px; padding: 12px 20px; font-size: 13px; }
  .training-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; min-width: 0; }
  .training-gallery img { aspect-ratio: 3 / 4; object-fit: cover; }
  .training-gallery figcaption { margin-top: 8px; font-size: 11px; line-height: 1.6; }
  .training-gallery-note { grid-column: 1 / -1; margin: 0; color: var(--text-muted); font-size: 11px; }
  @media (min-width: 769px) and (max-width: 1024px) {
    .training-proof { grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr); }
    .training-proof > figure { grid-column: 1; grid-row: 1; }
    .training-proof-content { grid-column: 2; grid-row: 1 / 3; }
    .training-gallery { grid-column: 1; }
  }
  @media (max-width: 768px) {
    .training-proof { grid-template-columns: 1fr; gap: 20px; padding: 24px; max-width: 480px; margin-inline: auto; }
    .training-proof figure { width: 100%; max-width: 360px; }
    .training-gallery { gap: 12px; }
    .service-examples { max-width: 480px; margin-inline: auto; }
  }
  .services-plans { position: relative; isolation: isolate; }
  .services {
    overflow: hidden;
  }

  .services > .container {
    position: relative;
    z-index: 2;
  }

  .services-story-lines {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    pointer-events: none;
  }

  .services-story-lines span {
    position: relative;
  }

  .services-story-lines span::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(234, 211, 141, 0.72) 22%,
      rgba(201, 165, 92, 0.2) 76%,
      transparent
    );
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.24);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: opacity 0.45s ease, transform 0.85s var(--ease-out), filter 0.35s ease;
  }

  .services.story-active .services-story-lines span::before {
    opacity: 0.62;
    transform: scaleY(1);
  }

  .services[data-service-focus] .services-story-lines span::before {
    opacity: 0.2;
  }

  .services[data-service-focus='0'] .services-story-lines span:nth-child(1)::before,
  .services[data-service-focus='1'] .services-story-lines span:nth-child(2)::before {
    opacity: 1;
    filter: brightness(1.45);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
    position: relative;
    z-index: 2;
    perspective: 1200px;
  }

  .service-card {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    transform: perspective(1100px) translate3d(0, 20px, 0);
    border-color: rgba(201, 165, 92, 0.08);
    transition:
      transform 0.58s var(--ease-out),
      opacity 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
    min-height: 0;
  }

  .service-card:nth-child(1),
  .service-card:nth-child(2) {
    margin-top: 0;
  }

  .service-card-featured {
    min-height: 0;
    box-shadow: 0 24px 74px rgba(0, 0, 0, 0.3);
  }

  .service-card.visible,
  .service-card.story-active {
    transform: translateY(0);
    border-color: rgba(201, 165, 92, 0.13);
    box-shadow:
      0 20px 58px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(234, 211, 141, 0.08);
  }

  .services[data-service-focus] .service-card {
    opacity: 1;
  }

  .services[data-service-focus='0'] .service-card:nth-child(1),
  .services[data-service-focus='1'] .service-card:nth-child(2) {
    opacity: 1;
    transform: translateY(0);
    border-color: rgba(234, 211, 141, 0.46);
    box-shadow:
      0 26px 72px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(201, 165, 92, 0.08);
  }

  .service-card-featured {
    border-color: rgba(201, 165, 92, 0.3);
    background: linear-gradient(180deg, rgba(201, 165, 92, 0.04), transparent), var(--bg-card);
  }

  .service-card-featured.visible { border-color: rgba(201,165,92,.4); }

  .service-card-featured:hover {
    border-color: rgba(201, 165, 92, 0.5);
  }

  .service-popular {
    position: absolute;
    top: -1px;
    right: 24px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 0 0 6px 6px;
    letter-spacing: 0.5px;
  }

  .service-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .service-tag::before {
    content: '';
    width: 16px;
    height: 1px;
    flex: 0 0 auto;
    background: linear-gradient(90deg, var(--accent), rgba(201, 165, 92, 0.18));
  }

  .service-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .service-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .service-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .service-detail {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .service-detail-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .service-detail-value {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: right;
  }

  .service-btn {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .services-story-lines {
      display: none;
    }

    .services-grid {
      gap: 20px;
    }

    .service-card {
      padding: 32px 24px;
    }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .service-card {
      padding: 20px;
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 10px;
      transform: translateY(14px);
      min-height: 0;
      margin-top: 0;
    }

    .service-icon { width: 44px; height: 44px; }
    .service-icon svg { width: 26px; height: 26px; }
    .service-card > .service-tag { align-self: center; }
    .service-card > :not(.service-icon):not(.service-tag) { grid-column: 1 / -1; }
    .service-card > :global(.service-example) { grid-column: 1 / -1; }
    .service-details { padding: 12px 0; gap: 10px; }
    .training-proof { padding: 20px; gap: 16px; }

    .service-card:nth-child(1),
    .service-card:nth-child(2) {
      margin-top: 0;
    }

    .service-card.visible,
    .service-card.story-active,
    .services[data-service-focus='0'] .service-card:nth-child(1),
    .services[data-service-focus='1'] .service-card:nth-child(2),
    .services[data-service-focus='2'] .service-card:nth-child(3) {
      transform: translateY(0);
    }

    .service-title {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card.story-active {
      transform: none;
    }
  }
</style>

<script>
  const servicesSection = document.querySelector<HTMLElement>('[data-story-section="services"]');

  if (servicesSection && !servicesSection.dataset.storyBound) {
    servicesSection.dataset.storyBound = 'true';
    const cards = Array.from(servicesSection.querySelectorAll<HTMLElement>('[data-service-story]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setFocus = (index: string | null) => {
      if (index === null) delete servicesSection.dataset.serviceFocus;
      else servicesSection.dataset.serviceFocus = index;
    };

    cards.forEach((card) => {
      const index = card.dataset.serviceStory || '0';
      card.addEventListener('pointerenter', () => setFocus(index));
      card.addEventListener('pointerleave', () => setFocus(null));
      card.addEventListener('focusin', () => setFocus(index));
      card.addEventListener('focusout', (event) => {
        if (!card.contains(event.relatedTarget as Node | null)) setFocus(null);
      });
    });

    window.addEventListener('visual-story:update', (event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      const active = detail.section === 'services';
      servicesSection.classList.toggle('story-active', active);
      if (!active) return;

      cards.forEach((card, index) => {
        card.classList.toggle('story-active', reducedMotion || detail.progress >= 0.05 + index * 0.14);
      });
    });
  }
</script>
