---
const questions = [
  { question: '怎么收费？工具费用另算吗？', answer: '首次需求沟通免费。培训或实施按范围报价，工具订阅、模型调用、设备与维护费用分别说明，确认后再开始。' },
  { question: '项目要多久？交付后怎么支持？', answer: '工具类项目通常参考 1–4 周，具体按方案约定，培训另约时间。交付后 30 天内提供答疑和约定范围内的小调整，新增功能与长期维护另行评估。' },
  { question: '智能体和工作流，分别能做什么？', answer: '智能体可以围绕任务整理资料、生成内容或调用工具；工作流把多个操作按步骤串起来。按需选择或组合，关键步骤保留人工核对。' },
  { question: '内部资料怎么处理？能在本地用吗？', answer: '先确认可用资料、访问人员和外部服务范围。可根据任务与设备评估本地、云端或组合方案。' },
  { question: '什么情况先不需要定制？', answer: '偶尔才做、现成工具已经够用的任务，可以先试用。是否定制，要看实际投入和使用价值。' },
];
---
<section class="section faq" id="faq" data-story-section="faq">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">常见问题</span>
      <h2 class="section-title">你可能想问的</h2>
    </div>
    <div class="faq-list reveal">
      {questions.map((item, index) => (
        <div class="faq-item card">
          <button class="faq-question" id={'faq-q-' + (index + 1)} aria-expanded="false" aria-controls={'faq-' + (index + 1)}>
            <span>{item.question}</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="faq-answer" id={'faq-' + (index + 1)} role="region" aria-labelledby={'faq-q-' + (index + 1)} aria-hidden="true"><p>{item.answer}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg-surface);
    overflow: hidden;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
    position: relative;
  }

  .faq-item::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, rgba(234, 211, 141, 0.72), transparent) border-box;
    -webkit-mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transform: translateX(-100%);
    pointer-events: none;
  }

  .faq-item.story-flow::after {
    animation: faqEdgeFlow 0.78s var(--ease-out) 1;
  }

  @keyframes faqEdgeFlow {
    0% {
      opacity: 0;
      transform: translateX(-100%);
    }
    28% {
      opacity: 0.72;
    }
    100% {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 28px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    text-align: left;
    font-family: var(--font-body);
    transition: color 0.3s var(--ease-out);
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .faq-item.open .faq-icon {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease-out), padding 0.4s var(--ease-out);
    padding: 0 28px;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
    padding: 0 28px 24px;
  }

  .faq-answer p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .faq-question {
      font-size: 15px;
      padding: 20px 20px;
    }

    .faq-answer {
      padding: 0 20px;
    }

    .faq-item.open .faq-answer {
      padding: 0 20px 20px;
    }
  }
</style>

<script>
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const isOpen = item?.classList.contains('open');

      // Close all others
      document.querySelectorAll('.faq-item.open').forEach((openItem) => {
        if (openItem !== item) {
          openItem.classList.remove('open');
          openItem.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
          openItem.querySelector('.faq-answer')?.setAttribute('aria-hidden', 'true');
        }
      });

      // Toggle current
      item?.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      answer?.setAttribute('aria-hidden', isOpen ? 'true' : 'false');

      if (!isOpen && item && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        item.classList.remove('story-flow');
        requestAnimationFrame(() => item.classList.add('story-flow'));
        window.setTimeout(() => item.classList.remove('story-flow'), 820);
      }
    });

    // Keyboard support — Escape to close
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const item = btn.closest('.faq-item');
        if (item?.classList.contains('open')) {
          item.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          item.querySelector('.faq-answer')?.setAttribute('aria-hidden', 'true');
        }
      }
    });
  });
</script>
