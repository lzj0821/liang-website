---
import VisualStory from './VisualStory.astro';
import PracticeRecord from './PracticeRecord.astro';
import { abilityCopy } from '../data/visual-copy';
import problem from '../assets/visual-scenes-20261024/ability-problem.png';
import tools from '../assets/visual-scenes-20261024/ability-tools.png';
import delivery from '../assets/visual-scenes-20261024/ability-delivery.png';
const pictures = [problem, tools, delivery];
---
<section class="section whyme" id="whyme" data-story-section="whyme">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">为什么选我</span>
      <h2 class="section-title">懂业务、懂 AI、能落地</h2>
    </div>
    <div class="whyme-grid">
      {abilityCopy.map((item,i) => (
        <div class="whyme-card card reveal" data-story-card={i}>
          <VisualStory image={pictures[i]} title={item.title} line={item.line} />
          <div class="whyme-card-data">
            <a href={item.caseId ? '#case-'+item.caseId : '#services'} data-case-detail-trigger={item.caseId || undefined} aria-haspopup={item.caseId ? 'dialog' : undefined} aria-controls={item.caseId ? 'caseStudyDrawer' : undefined} aria-expanded={item.caseId ? 'false' : undefined}>{item.link}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      ))}
    </div>
    <PracticeRecord />
  </div>
</section>
<style>
  .whyme { background:var(--bg-surface); overflow:hidden; }
  .whyme-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .whyme-card { --tilt-x:0deg; --tilt-y:0deg; padding:10px; min-width:0; overflow:hidden; transition:border-color .3s,box-shadow .3s; }
  .whyme-card.story-active { border-color:#c9a55c50; box-shadow:0 16px 45px #0003; }
  .whyme-card-data { padding:4px 14px 0; }
  a { display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:48px; color:var(--accent); font-size:14px; }
  a span { font-size:20px; }
  @media(max-width:1024px) { .whyme-grid { gap:16px; } }
  @media(max-width:768px) { .whyme-grid { grid-template-columns:1fr; max-width:480px; margin:auto; } }
</style>
<script>
  const whyMeSection = document.querySelector<HTMLElement>('[data-story-section="whyme"]');

  if (whyMeSection && !whyMeSection.dataset.storyBound) {
    whyMeSection.dataset.storyBound = 'true';
    const cards = Array.from(whyMeSection.querySelectorAll<HTMLElement>('[data-story-card]'));
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const handleStoryUpdate = (event: Event) => {
      const detail = (event as CustomEvent<{ section: string; progress: number }>).detail;
      if (detail.section !== 'whyme') return;

      cards.forEach((card, index) => {
        const threshold = 0.05 + index * 0.14;
        card.classList.toggle('story-active', reducedMotion || detail.progress >= threshold);
      });
    };

    window.addEventListener('visual-story:update', handleStoryUpdate);

    if (finePointer && !reducedMotion) {
      cards.forEach((card) => {
        let tiltFrame = 0;
        let latestX = 0;
        let latestY = 0;
        card.addEventListener('pointermove', (event) => {
          latestX = event.clientX;
          latestY = event.clientY;
          if (tiltFrame) return;
          tiltFrame = requestAnimationFrame(() => {
            tiltFrame = 0;
            const bounds = card.getBoundingClientRect();
            const x = (latestX - bounds.left) / bounds.width - 0.5;
            const y = (latestY - bounds.top) / bounds.height - 0.5;
            card.style.setProperty('--tilt-x', `${(-y * 4).toFixed(2)}deg`);
            card.style.setProperty('--tilt-y', `${(x * 4).toFixed(2)}deg`);
          });
        });
        card.addEventListener('pointerleave', () => {
          if (tiltFrame) { cancelAnimationFrame(tiltFrame); tiltFrame = 0; }
          card.style.setProperty('--tilt-x', '0deg');
          card.style.setProperty('--tilt-y', '0deg');
        });
      });
    }
  }
</script>
