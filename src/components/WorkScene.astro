---
interface Props { kind: string; }
const { kind } = Astro.props;
const scenes: Record<string, {title:string; rows:string[]}> = {
 input:{title:'需求清单',rows:['现在怎么做','哪一步费时','先解决一件事']},
 plan:{title:'实施方案',rows:['交付范围','验收标准','周期与报价']},
 tool:{title:'交付工作台',rows:['工具可运行','真实任务试用','使用培训']},
 support:{title:'使用支持',rows:['问题反馈','答疑与小调整','新增需求另评估']},
};
const scene = scenes[kind] || scenes.input;
---
<div class:list={['work-scene',`work-scene-${kind}`]} aria-label={scene.title}>
  <svg class="desk-scene" viewBox="0 0 240 150" fill="none" aria-hidden="true">
    <ellipse cx="120" cy="132" rx="104" ry="10" fill="#000" opacity=".3"/>
    {kind==='input' && <g>
      <path d="m28 48 62-12 16 83-62 12z" fill="#393529" stroke="#7b6b44"/><path d="m41 64 36-7m-32 20 34-6m-30 19 32-6" stroke="#b2a47f"/>
      <rect x="88" y="16" width="88" height="111" rx="6" fill="#ddd3b8"/><rect x="111" y="11" width="42" height="12" rx="4" fill="#9f8855"/>
      <path d="m102 43 4 4 7-9m-11 29 4 4 7-9m-11 29 4 4 7-9M122 43h38M122 67h38M122 91h25" stroke="#66604b" stroke-width="2"/>
      <path d="m180 104 18-67 7 2-18 67-7 8z" fill="#c9a55c"/><path d="m180 114 7-8" stroke="#efe1ba"/>
    </g>}
    {kind==='plan' && <g>
      <rect x="22" y="24" width="157" height="98" rx="7" fill="#333128" stroke="#a08c5b"/>
      <rect x="34" y="35" width="133" height="75" rx="3" fill="#1b1c19"/>
      <path d="M34 61h133M34 84h133M67 35v75" stroke="#5c5845"/>
      <path d="M78 48h39M104 73h45M126 97h31" stroke="#c9a55c" stroke-width="8" stroke-linecap="round"/>
      <path d="M12 122h179l-12 10H26z" fill="#8b805f"/>
      <rect x="164" y="60" width="50" height="70" rx="4" fill="#d9ceb0"/><path d="M175 76h28M175 88h22M175 100h28M175 112h15" stroke="#716647"/>
    </g>}
    {kind==='tool' && <g>
      <rect x="63" y="16" width="151" height="88" rx="5" fill="#302e24" stroke="#b49c62"/>
      <path d="M139 104v26M112 130h54" stroke="#8a7951" stroke-width="4"/>
      <rect x="74" y="27" width="129" height="65" rx="2" fill="#d8d0ba"/>
      <path d="M87 43h75M87 56h52M87 69h66" stroke="#898e76" stroke-width="6" stroke-linecap="round"/>
      <circle cx="42" cy="62" r="13" fill="#b9a781"/><path d="M26 118V91q0-16 16-16t17 16v27" fill="#676c5a"/><path d="m52 83 26-16" stroke="#b9a781" stroke-width="8" stroke-linecap="round"/>
      <path d="M20 130h77l-10-23H30z" fill="#45463b" stroke="#a9a383"/><path d="M42 118h30" stroke="#c9a55c"/>
    </g>}
    {kind==='support' && <g>
      <rect x="23" y="32" width="124" height="85" rx="6" fill="#252721" stroke="#a08c5b"/><path d="M16 117h139l-13 12H29z" fill="#7c765f"/>
      <path d="M39 49h76v24H68l-12 9v-9H39z" fill="#d0c3a0"/><path d="M64 88h67v14H64z" fill="#899176"/>
      <path d="M48 60h52" stroke="#807355"/>
      <circle cx="186" cy="63" r="17" fill="#c7b48a"/><path d="M159 130V99q0-21 27-21t27 21v31" fill="#6b715d"/>
      <path d="M164 64v-9a22 22 0 0 1 44 0v19h-17M163 56v17M208 56v17" stroke="#c9a55c" stroke-width="5" stroke-linecap="round"/>
    </g>}
  </svg>
  <div class="scene-caption">{kind==='input'?'把问题变成清单':kind==='plan'?'范围 · 验收 · 报价':kind==='tool'?'演示 · 试用 · 培训':'反馈 · 答疑 · 调整'}</div>
</div>
<style>
 .work-scene{padding:16px 18px 20px;background:radial-gradient(ellipse at 70% 10%,#c9a55c13,transparent 80%);min-width:0}
 .scene-window{border:1px solid #c9a55c38;border-radius:8px;background:#1d1d1a;box-shadow:0 12px 24px #0003;overflow:hidden}
 .scene-bar{display:flex;align-items:center;gap:4px;padding:10px 12px;border-bottom:1px solid #ffffff0a;background:#24241f}
 .scene-bar i{width:4px;height:4px;border-radius:50%;background:#81775e}.scene-bar span{font-size:12px;color:#c5bead;margin-left:6px}
 .scene-body{padding:12px;display:grid;gap:12px}.scene-row{display:flex;align-items:center;gap:10px;font-size:14px;color:#dfdcd3;line-height:1.5}
 .scene-check{color:#d3b672;font-size:12px;min-width:20px}.scene-addon{display:flex;align-items:center;gap:10px;margin:12px 0 0;color:#c8b785;font-size:13px}
 svg{width:34px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
 .desk-scene{display:block;width:100%;height:145px;stroke:none}.scene-caption{font-size:14px;text-align:center;line-height:1.7;color:#d3c397;margin-top:8px}
 @media(max-width:768px){.work-scene{padding:8px 14px 16px}.scene-body{gap:10px}.scene-bar span{font-size:13px}}
</style>
