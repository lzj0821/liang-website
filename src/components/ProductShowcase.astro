---
import { Image } from 'astro:assets';
import { selfBuiltProducts } from '../data/self-built-products';
import jutu from '../assets/refresh/jutu-input-output.png';
import reset from '../assets/case-refresh-20261021/reset-home.png';
import podcast from '../assets/case-refresh-20261021/podcast-modes.jpg';
const previews = { jutu, reset, podcast };
---
<div class="product-showcase" id="miniapp-products" aria-label="小程序作品">
  {selfBuiltProducts.map(product=><article class="product-card">
    <button class:list={['product-preview',{'poster':product.id==='jutu'}]} type="button" data-case-detail-trigger="jutu" data-product-open={product.id} aria-label={'查看'+product.name+'功能与界面'} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">
      <Image src={previews[product.id as keyof typeof previews]} alt={product.id==='jutu'?'居图 AI 家居出图效果对照':product.name+'实际界面'} width={560} loading="lazy" />
    </button>
    <div class="product-copy"><h4>{product.shortName}</h4><p>{product.description}</p>
      <button class="product-detail" type="button" data-case-detail-trigger="jutu" data-product-open={product.id} aria-haspopup="dialog" aria-controls="caseStudyDrawer" aria-expanded="false">查看功能与界面 <span aria-hidden="true">↗</span></button>
      {product.experienceCode && <a class="product-code" href={product.experienceCode} data-image-open data-image-caption={product.name+' · 微信扫码体验'} aria-label={'放大'+product.name+'小程序码'} aria-haspopup="dialog" aria-controls="imageLightbox"><img src={product.experienceCode} alt={product.name+'正式版小程序码'} loading="lazy" width="100" height="100" /><span>用微信扫一扫<br />体验小程序</span></a>}
    </div>
  </article>)}
</div>
<style>
  .product-showcase { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;scroll-margin-top:100px; }
  .product-card { min-width:0;background:#141512;border:1px solid var(--border-light);border-radius:12px;overflow:hidden;display:flex;flex-direction:column; }
  .product-preview { display:flex;justify-content:center;align-items:flex-start;width:100%;height:220px;overflow:hidden;background:radial-gradient(ellipse at bottom,#c9a55c20,transparent),#1c1d18;border:0;padding:18px 18px 0;cursor:pointer; }
  .product-preview img { width:144px;height:auto;display:block;border-radius:10px 10px 0 0;box-shadow:0 10px 30px #0006; }
  .product-preview.poster img { width:100%;max-width:250px;border-radius:6px; }
  .product-copy { padding:22px;display:flex;flex:1;flex-direction:column; }
  h4 { font-size:22px;font-weight:600;margin-bottom:10px; }p { font-size:14px;line-height:1.8;color:var(--text-secondary);margin-bottom:18px; }
  .product-detail { display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;min-height:44px;margin-top:auto;background:none;border:0;border-top:1px solid var(--border);font:inherit;font-size:13px;color:var(--accent);cursor:pointer;text-align:left; }
  .product-code { display:flex;align-items:center;gap:16px;margin-top:16px;font-size:13px;line-height:1.8; }.product-code img { width:100px;height:100px;object-fit:contain;background:#fff;border-radius:6px; }
  @media(max-width:768px) { .product-showcase { grid-template-columns:1fr;gap:14px; }.product-card { display:grid;grid-template-columns:110px minmax(0,1fr); }.product-preview { height:100%;min-height:190px;padding:16px 8px 0; }.product-preview img { width:94px; }.product-copy { padding:18px 14px; }h4 { font-size:19px; }p { font-size:13px;margin-bottom:10px; }.product-code { flex-wrap:wrap; } }
</style>
