---
import { Image, getImage } from 'astro:assets';
import stage from '../assets/evidence-20261026/sharing-stage.jpg';
import room from '../assets/evidence-20261026/sharing-room.jpg';
import training from '../assets/evidence-20261026/training-refined.jpg';
import content from '../assets/refresh/training-content-anonymized.png';
import agent from '../assets/refresh/training-agent-anonymized.png';
const scenes = await Promise.all([
  { image:stage, label:'线下分享现场', position:'50% 70%', lead:true },
  { image:room, label:'同场交流与讨论', position:'50% 75%', lead:true },
  { image:training, label:'企业 AI 应用分享', position:'50% 45%', lead:false },
  { image:content, label:'内容与电商 AI 实战', position:'50% 30%', lead:false },
  { image:agent, label:'智能体与业务应用', position:'50% 30%', lead:false },
].map(async item=>({...item,full:await getImage({src:item.image,width:1600,format:'webp'})})));
---
<div class="sharing-gallery" aria-label="线下分享与内训照片">
  {scenes.map(item=><figure class:list={['sharing-photo',{'sharing-photo-lead':item.lead}]}>
    <a href={item.full.src} data-image-open data-image-caption={item.label} aria-label={'放大'+item.label} aria-haspopup="dialog" aria-controls="imageLightbox">
      <Image src={item.image} alt={item.label} width={item.lead?900:600} loading="lazy" style={'object-position:'+item.position} />
      <span class="photo-zoom" aria-hidden="true">↗</span>
    </a>
    <figcaption>{item.label}</figcaption>
  </figure>)}
</div>
<style>
  .sharing-gallery { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:22px; margin-top:28px; }
  figure { margin:0; min-width:0; grid-column:span 2; }
  .sharing-photo-lead { grid-column:span 3; }
  a { display:block; position:relative; overflow:hidden; border-radius:10px; background:#171715; cursor:zoom-in; }
  img { display:block; width:100%; height:auto; aspect-ratio:16/10; object-fit:cover; }
  .sharing-photo-lead img { aspect-ratio:16/9; }
  .photo-zoom { position:absolute; right:10px; bottom:10px; width:30px; height:30px; display:grid; place-items:center; background:#111c; border:1px solid #ffffff30; border-radius:50%; color:var(--accent-hover); }
  figcaption { font-size:13px; line-height:1.7; color:var(--text-secondary); margin-top:10px; }
  @media(max-width:768px) {
    .sharing-gallery { gap:16px 10px; margin-top:22px; }
    .sharing-photo-lead { grid-column:span 6; }
    figcaption { font-size:11px; margin-top:7px; }
    .photo-zoom { width:24px; height:24px; right:5px; bottom:5px; font-size:12px; }
    a { border-radius:7px; }
  }
</style>
