---
import { Image, getImage } from 'astro:assets';
import speaker from '../assets/evidence-20261026/sharing-speaker.jpg';
import stage from '../assets/evidence-20261026/sharing-stage.jpg';
import room from '../assets/evidence-20261026/sharing-room.jpg';
const scenes = await Promise.all([{image:stage,label:'线下分享现场'},{image:room,label:'同场交流与讨论'}].map(async item => ({...item,full:await getImage({src:item.image,width:1600,format:'webp'})})));
---
<div class="sharing-record">
  <Image src={speaker} alt="Liangzhenjie 在 2026 年 10 月 25 日线下聚会中持麦分享" width={800} loading="lazy" class="sharing-lead" />
  <div class="sharing-copy"><span class="eyebrow">线下分享 · 2026.10.25</span><h3>在真实交流中，分享 AI 实践</h3><p>从日常使用到业务应用，把做过的尝试带到现场。</p>
    <details><summary>查看更多现场照片</summary><div class="sharing-scenes">{scenes.map(item => <figure><a href={item.full.src} data-image-open data-image-caption={item.label + ' · 2026.10.25'} aria-label={'放大' + item.label} aria-haspopup="dialog" aria-controls="imageLightbox"><Image src={item.image} alt={item.label} width={640} loading="lazy" /></a><figcaption>{item.label}</figcaption></figure>)}</div></details>
  </div>
</div>
<style>
 .sharing-record{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.4fr);gap:28px;align-items:center;margin-top:24px;padding-top:28px;border-top:1px solid #ffffff14;grid-column:1/-1;}
 .sharing-lead{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:8px;display:block;}
 .sharing-copy{min-width:0;}.eyebrow{font-size:13px;color:var(--accent);letter-spacing:.04em;}h3{font-size:24px;line-height:1.5;margin:12px 0;}p{font-size:14px;color:var(--text-secondary);line-height:1.8;}
 details{margin-top:14px;}summary{cursor:pointer;color:var(--accent);font-size:14px;padding:12px 0;min-height:44px;}
 .sharing-scenes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-top:8px;}figure{margin:0;min-width:0;}a{display:block;border-radius:6px;overflow:hidden;}figure img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:center 70%;display:block;}figcaption{font-size:12px;line-height:1.7;color:var(--text-secondary);margin-top:8px;}
 a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}
 @media(max-width:768px){.sharing-record{grid-template-columns:1fr;gap:20px;margin-top:4px;padding-top:24px;}h3{font-size:21px;} .sharing-scenes{grid-template-columns:1fr;}figure img{aspect-ratio:4/3;}}
</style>
