---
import { Image } from 'astro:assets';
import { caseArt } from '../data/case-art';
const { id } = Astro.props as { id: keyof typeof caseArt };
const art = caseArt[id];
const visualCopy = {
 crm:['汇集线索','集中跟进'], automation:['整理报表','辅助录入'],
 jutu:['实际需求','微信里的工具'],workbench:['分散素材','成套内容'],
 youtube:['系列创作','500 万+ 播放'],growth:['2 小时','10 分钟'],
};
const labels=visualCopy[id];
---
<figure class="case-visual">
  <Image src={art.image} alt={art.alt} width={800} loading="lazy" />
<figcaption><span>{labels[0]}</span><i aria-hidden="true">→</i><strong>{labels[1]}</strong></figcaption></figure>
<style>
  .case-visual { position:relative; margin:0; aspect-ratio:16/10; overflow:hidden; border:1px solid #ffffff09; border-radius:10px; background:#111; }
  .case-visual img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .45s ease; }
  @media(hover:hover) { .case-visual:hover img { transform:scale(1.025); } }
  @media(prefers-reduced-motion:reduce) { .case-visual img { transition:none; } }

  figcaption { position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;gap:10px;padding:34px 16px 14px;background:linear-gradient(transparent,#0c0d0cf2);font-size:15px;line-height:1.5;color:#e2ddd2; }
  figcaption strong { color:#eed9a4;font-weight:600; } i { color:#bba265;font-style:normal; }
</style>
