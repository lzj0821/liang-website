---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageLightbox from '../components/ImageLightbox.astro';
interface Props {
  title: string;
  author: string;
  publishedAt: string;
  cover: ImageMetadata;
  takeaways: string[];
  headings: { depth: number; slug: string; text: string }[];
  related: { slug: string; title: string }[];
}
const { title, author, publishedAt, cover, takeaways, headings, related } = Astro.props;
const inquiryLink = '/?article=' + encodeURIComponent(Astro.url.pathname.split('/').filter(Boolean).pop() || '') + '#contact';
const canonical = new URL(Astro.url.pathname, Astro.site);
const coverImage = await getImage({ src: cover, width: 900, format: 'webp' });
const shareImage = new URL(coverImage.src, Astro.site).toString();
const description = `${author}的 AI 落地实战笔记：${title}。原发布于 ${publishedAt}。`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${title}｜Liangzhenjie`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="900" />
    <meta property="og:image:height" content={String(coverImage.attributes.height)} />
    <meta property="article:published_time" content={`${publishedAt}T00:00:00+08:00`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org','@type':'BlogPosting',headline:title,
      author:{'@type':'Person',name:author,url:Astro.site?.toString()},
      datePublished:`${publishedAt}T00:00:00+08:00`,image:shareImage,
      mainEntityOfPage:canonical.toString(),description,
    }).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="reading-skip" href="#article-content">跳转到正文</a>
    <header class="reading-header">
      <nav aria-label="文章导航">
        <a class="reading-brand" href="/">Liangzhenjie</a>
        <div><a href="/#services">服务</a><a href={inquiryLink}>联系我</a></div>
      </nav>
    </header>
    <main class="reading-main">
      <article>
        <header class="article-heading">
          <a class="back-link" href="/#articles">← 返回首页 · 日常分享</a>
          <h1>{title}</h1>
          <p class="article-meta">{author}<span>原发布于 <time datetime={publishedAt}>{publishedAt}</time></span></p>
          <p class="historical-note">以下为当时的实践与判断，保留原文中的项目阶段记录。</p>
          <Image src={cover} alt={title + '文章封面'} width={900} widths={[360,720,900]} sizes="(max-width: 760px) calc(100vw - 40px), 720px" loading="eager" class="article-cover" />
        </header>
        <aside class="article-takeaways" aria-labelledby="takeaways-title"><h2 id="takeaways-title">先看这三个要点</h2><ul>{takeaways.map(point=><li>{point}</li>)}</ul></aside>
        <details class="article-toc">
          <summary>文章目录</summary>
          <nav aria-label="文章目录"><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav>
        </details>
        <div class="article-prose" id="article-content" tabindex="-1"><slot /></div>
      </article>
      <aside class="related-articles" aria-labelledby="relatedTitle">
        <h2 id="relatedTitle">继续阅读</h2>
        {related.map(item=><a href={'/articles/'+item.slug+'/'}>{item.title}<span aria-hidden="true">→</span></a>)}
      </aside>
      <footer class="article-footer">
        <p>你也在考虑给公司用上 AI，或想开发一套自己的工具？</p>
        <a class="btn btn-primary" href={inquiryLink}>说说你想做的事</a>
        <a href="/">返回首页</a>
      </footer>
    </main>
    <ImageLightbox />
  </body>
</html>
<style>
  .reading-skip { position:fixed; top:-80px; left:16px; z-index:10; background:var(--bg-card); padding:12px; }
  .reading-skip:focus { top:12px; }
  .reading-header { border-bottom:1px solid var(--border); background:var(--bg); }
  .reading-header nav { max-width:1040px; margin:auto; padding:18px 24px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .reading-header a { display:inline-flex; align-items:center; min-height:44px; }
  .reading-brand { color:var(--text-primary); font-weight:700; font-size:20px; }
  .reading-header nav div { display:flex; gap:24px; font-size:13px; }
  .reading-main { max-width:768px; padding:56px 24px 64px; margin:auto; }
  .back-link { display:inline-flex; align-items:center; min-height:44px; font-size:12px; }
  h1 { font-size:clamp(27px,4vw,38px); line-height:1.5; letter-spacing:-.025em; margin:20px 0; text-wrap:balance; }
  .article-meta { color:var(--text-secondary); font-size:13px; display:flex; flex-wrap:wrap; gap:8px 20px; }
  .historical-note { font-size:12px; line-height:1.8; color:var(--text-muted); margin:12px 0 24px; }
  .article-cover { width:100%; border-radius:10px; }
  .article-takeaways { margin-top:24px; padding:20px 22px; border:1px solid #c9a55c30; border-radius:10px; background:#c9a55c08; }
  .article-takeaways h2 { color:var(--accent-hover); font-size:14px; font-weight:500; margin-bottom:10px; }
  .article-takeaways ul { padding-left:1.2em; color:var(--text-secondary); font-size:14px; line-height:1.8; }
  .article-takeaways li + li { margin-top:8px; }
  .article-toc { margin:24px 0 36px; border-block:1px solid var(--border-light); font-size:14px; }
  .article-toc summary { min-height:48px; padding:12px 0; cursor:pointer; color:var(--accent); }
  .article-toc ol { padding:0 0 16px 22px; }
  .article-toc a { display:block; padding:10px 0; color:var(--text-secondary); }
  .article-prose { color:#c4c4c4; font-size:17px; line-height:1.95; overflow-wrap:anywhere; }
  .article-prose :global(p) { margin:0 0 1.5em; }
  .article-prose :global(h2) { color:var(--text-primary); font-size:25px; line-height:1.6; margin:2.3em 0 1em; scroll-margin-top:24px; }
  .article-prose :global(h3) { color:var(--text-primary); font-size:21px; margin:1.8em 0 .8em; }
  .article-prose :global(strong) { color:var(--text-primary); font-weight:650; }
  .article-prose :global(ul), .article-prose :global(ol) { padding-left:1.4em; margin:0 0 1.5em; }
  .article-prose :global(li) { margin:.5em 0; }
  .article-prose :global(blockquote) { border-left:2px solid var(--accent); padding:8px 0 8px 20px; margin:24px 0; color:var(--text-secondary); }
  .article-prose :global(blockquote p:last-child) { margin-bottom:0; }
  .article-prose :global(img) { width:100%; height:auto; border-radius:8px; margin:32px 0; }
  .article-prose :global(.image-preview) { margin:28px 0; }
  .article-prose :global(.image-preview img) { margin:0; }
  .article-prose :global(a) { text-decoration:underline; text-underline-offset:4px; }
  .article-prose :global(hr) { border:0; border-top:1px solid var(--border); margin:36px 0; }
  .related-articles { margin-top:56px; border-top:1px solid var(--border-light); padding-top:24px; }
  .related-articles h2 { font-size:15px; font-weight:500; color:var(--text-muted); margin-bottom:12px; }
  .related-articles a { display:flex; justify-content:space-between; align-items:center; gap:20px; min-height:48px; padding:12px 0; font-size:15px; border-bottom:1px solid var(--border); }
  .related-articles a span { flex-shrink:0; }
  .article-footer { margin-top:40px; display:flex; flex-wrap:wrap; gap:16px 24px; align-items:center; font-size:13px; }
  .article-footer p { width:100%; color:var(--text-secondary); }
  @media(max-width:640px) {
    .reading-header nav { padding:10px 20px; }
    .reading-brand { font-size:17px; }
    .reading-header nav div { gap:16px; }
    .reading-main { padding:28px 20px 48px; }
    .article-prose { font-size:16px; }
    .article-prose :global(h2) { font-size:22px; }
    .article-prose :global(h3) { font-size:19px; }
  }
</style>
<script>
  document.querySelectorAll<HTMLImageElement>('.article-prose img').forEach(img=>{
    if(img.closest('a')) return;
    const link=document.createElement('a');
    link.href=img.currentSrc || img.src;
    link.className='image-preview';
    link.dataset.imageOpen='';
    link.dataset.imageCaption=img.alt;
    link.setAttribute('aria-label','放大图片：'+img.alt);
    link.setAttribute('aria-haspopup','dialog');
    link.setAttribute('aria-controls','imageLightbox');
    img.replaceWith(link);
    link.append(img);
  });
</script>
