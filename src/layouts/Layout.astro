---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const siteURL = (Astro.site?.toString() || 'https://liangzhenjie.cn').replace(/\/$/, '');
const {
  title,
  description = 'Liangzhenjie · AI 落地顾问。4 年家居一线运营经验。为企业提供 AI 落地、内部培训与自动化工具，为个人与小团队搭建智能体、定制工作流，减少重复工作。',
  image = `${siteURL}/images/og-default.png`,
  imageAlt = 'Liangzhenjie · AI 落地顾问｜帮传统企业，用 AI 解决真问题｜liangzhenjie.cn'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();
const squareShareImage = `${siteURL}/images/og-square.jpg`;
const squareShareImageAlt = 'Liangzhenjie · AI 落地顾问 · liangzhenjie.cn';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liangzhenjie | AI 落地顾问" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Square thumbnail first; keep the landscape cover as an alternative.
         These are generic share hints, not authenticated WeChat JS-SDK settings. -->
    <meta property="og:image" content={squareShareImage} />
    <meta property="og:image:alt" content={squareShareImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "name": "Liangzhenjie | AI 落地顾问",
          "description": description,
          "url": siteURL,
          "image": image,
          "provider": { "@id": `${siteURL}/#person` }
        },
        {
          "@type": "Person",
          "@id": `${siteURL}/#person`,
          "name": "Liangzhenjie",
          "jobTitle": "AI 落地顾问",
          "knowsAbout": ["企业 AI 落地", "智能体搭建", "自动化工作流", "企业 AI 培训"],
          "sameAs": [
            "https://xhslink.com/m/7htcBmaHvMh",
            "https://v.douyin.com/n4Uw16gQ4J4/",
            "https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzY5NzIzNzExMg==#wechat_redirect"
          ]
        }
      ]
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body>
    <slot />

    <!-- Scroll Reveal Script -->
    <script>
      // Enable entrance effects only when JavaScript is available.
      document.documentElement.classList.add('js-ready');

      // Intersection Observer for .reveal elements
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.01, rootMargin: '0px 0px 80px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Counter animation — per-element (skip if reduced motion)
      const counterPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function animateCounter(el: Element) {
        if (el.classList.contains('counted')) return;
        if (counterPrefersReducedMotion) {
          el.classList.add('counted');
          return;
        }
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const suffix = el.getAttribute('data-suffix') || '';
        const prefix = el.getAttribute('data-prefix') || '';
        const decimals = el.getAttribute('data-decimals') || '0';
        const duration = 2000;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          const current = target * eased;
          el.textContent = prefix + (decimals === '1' ? current.toFixed(1) : Math.floor(current).toLocaleString()) + suffix;
          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            el.classList.add('counted');
          }
        }
        requestAnimationFrame(update);
      }

      // Observe counters individually
      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              counterObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -20px 0px' }
      );

      document.querySelectorAll('.counter').forEach((el) => counterObserver.observe(el));

    </script>
  </body>
</html>
